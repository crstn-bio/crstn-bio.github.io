---
// 로드맵 페이지: src/content/roadmap/<이 주소>.md 하나가 이 페이지 하나예요.
// 질문 · 기전 · 본문(마크다운) · 도안 · 출처. 앞뒤 이동과 위쪽 레일은 순서(order)에서 자동으로.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import StageRail from '../../components/StageRail.astro';
import StageFigure from '../../components/StageFigure.astro';
import Status from '../../components/Status.astro';
import ProjectDialogs from '../../components/ProjectDialogs.astro';
import { site, getRoadmap, homeUrl, url, type Node } from '../../lib/content';

export async function getStaticPaths() {
  const nodes = await getRoadmap();
  return nodes.map((s, i) => ({ params: { slug: s.slug }, props: { s, prev: nodes[i - 1], next: nodes[i + 1] } }));
}
const { s, prev, next } = Astro.props as { s: Node; prev?: Node; next?: Node };
const d = s.data;
const L = site.roadmap ?? {};
const C = site.contact ?? {};
const { Content } = await render(s);
---
<Base title={`${s.n} ${d.title}`} description={`${d.question} ${d.mechanism}`} dark>
  <div class="page">
    <Nav />
    <div class="wrap top">
      <StageRail current={s.slug} />
    </div>

    <main id="main" class="wrap">
      <header class="hd">
        <div class="id">
          <p class="mono kick"><a href={homeUrl('#approach')}>{L.crumb}</a>{d.group && <><span>/</span>{d.group}</>}<span>/</span>{s.n} {d.title}</p>
          <Status kind={d.status} text={d.status_label} />
        </div>
        <h1>{d.question}</h1>
        <div class="side">
          {d.mechanism && <p class="mech mono">{d.mechanism}</p>}
          <div class="note"><Content /></div>
          {d.evidence.length > 0 && (
            <p class="ev mono"><span>{L.evidence}</span>{d.evidence.map((e) => <button type="button" data-open={e.project} aria-haspopup="dialog">{e.label} →</button>)}</p>
          )}
        </div>
      </header>

      <div class="fig"><StageFigure data={d} /></div>

      {d.sources.length > 0 && (
        <div class="src">
          <p class="mono">{L.sources}</p>
          <div>{d.sources.map((x) => <a href={url(x.url)} target="_blank" rel="noreferrer">{x.label} ↗</a>)}</div>
        </div>
      )}

      <nav class="pn" aria-label="Previous and next stage">
        {prev ? <a class="p" href={url(`/how/${prev.slug}/`)}><span class="mono">← {prev.n}</span>{prev.data.title}</a> : <a class="p" href={homeUrl('#approach')}><span class="mono">←</span>{L.first}</a>}
        <a class="all mono" href={homeUrl('#approach')}>{L.back}</a>
        {next ? <a class="n" href={url(`/how/${next.slug}/`)}><span class="mono">{next.n} →</span>{next.data.title}</a> : <a class="n" href={homeUrl('#questions')}><span class="mono">→</span>{L.last}</a>}
      </nav>
    </main>

    <footer class="wrap foot mono">
      <span>{site.name}</span>
      <a href={homeUrl('#contact')}>{C.email_button}</a>
    </footer>
  </div>
  <ProjectDialogs />
</Base>

<style>
  .page { --acc: #a8c8ff; background: #000; color: #fff; min-height: 100svh; }
  .top { padding-top: 8px; padding-bottom: clamp(28px, 4vw, 44px); border-bottom: 1px solid #161616; }
  main { padding-block: clamp(36px, 5vw, 64px); }
  .hd { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 14px clamp(24px, 4vw, 56px); align-items: end; }
  .id { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .kick { margin: 0; color: #8d8d8d; letter-spacing: .14em; text-transform: uppercase; display: flex; gap: 8px; flex-wrap: wrap; }
  .kick a { color: #8d8d8d; text-decoration: none; border-bottom: 1px solid #333; }
  .kick a:hover { color: #fff; }
  .kick span { color: #444; }
  h1 { margin: 0; font-size: clamp(30px, 4vw, 56px); font-weight: 300; letter-spacing: -0.035em; line-height: 1.06; text-wrap: balance; }
  .mech { margin: 0; color: var(--acc); letter-spacing: .04em; line-height: 1.6; }
  .note { max-width: 54ch; }
  .note > :global(*) { margin: 12px 0 0; color: #9a9a9a; font-size: 15.5px; line-height: 1.6; }
  .note :global(a) { color: #d6d6d6; }
  .note :global(strong) { color: #fff; font-weight: 500; }
  .note :global(h2), .note :global(h3) { color: #fff; font-size: 18px; font-weight: 400; letter-spacing: -0.01em; margin-top: 22px; }
  .note :global(ul), .note :global(ol) { padding-left: 1.2em; }
  .note :global(img) { display: block; max-width: 100%; height: auto; border: 1px solid #1f1f1f; }
  .note :global(blockquote) { border-left: 1px solid #3a4a5e; padding-left: 12px; margin-left: 0; }
  .ev { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; margin: 14px 0 0; }
  .ev span { color: #6a6a6a; letter-spacing: .12em; text-transform: uppercase; }
  .ev button { font: inherit; background: none; border: 0; border-bottom: 1px solid #3a3a3a; color: #e6e6e6; padding: 2px 0; cursor: pointer; }
  .ev button:hover { color: var(--acc); border-color: var(--acc); }
  .fig { margin-top: clamp(28px, 4vw, 48px); display: grid; gap: clamp(28px, 4vw, 48px); }
  .src { display: grid; grid-template-columns: 120px 1fr; gap: 10px 24px; margin-top: 28px; padding-top: 18px; border-top: 1px solid #1a1a1a; }
  .src > p { margin: 0; color: #6a6a6a; letter-spacing: .1em; text-transform: uppercase; }
  .src > div { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .src a { color: #8d8d8d; text-decoration: none; font-size: 13.5px; line-height: 1.5; }
  .src a:hover { color: #fff; }
  .pn { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; margin-top: clamp(40px, 6vw, 72px); padding-top: 24px; border-top: 1px solid #262626; }
  .pn a { color: #fff; text-decoration: none; display: grid; gap: 4px; font-size: clamp(20px, 2.2vw, 28px); font-weight: 300; letter-spacing: -0.02em; }
  .pn a .mono { color: #6a6a6a; font-size: 12px; letter-spacing: .12em; }
  .pn a:hover { color: var(--acc); }
  .pn .n { justify-self: end; text-align: right; }
  .pn .all { font-size: 12px; color: #8d8d8d; letter-spacing: .14em; text-transform: uppercase; border: 1px solid #333; padding: 10px 14px; }
  .foot { display: flex; justify-content: space-between; gap: 16px; padding-block: 28px 36px; color: #5a5a5a; border-top: 1px solid #111; }
  .foot a { color: #8d8d8d; text-decoration: none; }
  .foot a:hover { color: #fff; }
  @media (max-width: 900px) {
    .hd { grid-template-columns: 1fr; }
    .src { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .pn { grid-template-columns: 1fr 1fr; }
    .pn .all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
</style>
