---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import OperatingPoints from '../components/OperatingPoints.astro';
import { site, experience, education, skills, honours } from '../data/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <Hero />
  <main id="main">
    <section class="section intro">
      <div class="wrap intro-grid">
        <p class="lede">{site.intro}</p>
        <dl class="now">
          <div><dt>Now</dt><dd>Krembil Brain Institute, UHN</dd></div>
          <div><dt>Studying</dt><dd>HBSc, University of Toronto, 2027</dd></div>
          <div><dt>Working in</dt><dd>R, Python, cross-validated modelling</dd></div>
        </dl>
      </div>
    </section>

    <section class="section" id="research" aria-labelledby="research-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="research-h">Research</h2>
          <p>Stimulation, biomarkers and cell therapy. Each project opens to the question, the method and what I did.</p>
        </div>
        <ol class="projects">
          {research.map((p) => (
            <li>
              <a class="project" href={`${base}/research/${p.id}/`}>
                <span class="p-meta">
                  <span class="mono">{p.data.period}</span>
                  <span class={`status mono ${p.data.status}`}>{p.data.status === 'ongoing' ? 'in progress' : 'complete'}</span>
                </span>
                <span class="p-main">
                  <span class="p-title">{p.data.short}</span>
                  <span class="p-sum">{p.data.summary}</span>
                </span>
                <span class="p-tags">{p.data.methods.slice(0, 2).map((m) => <span>{m}</span>)}</span>
              </a>
            </li>
          ))}
        </ol>

        <div class="featured">
          <OperatingPoints />
        </div>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="exp-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="exp-h">Experience</h2>
          <p>Lab research alongside clinical work. <span class="key"><i class="k research"></i>research</span> <span class="key"><i class="k clinical"></i>clinical</span></p>
        </div>
        <ol class="timeline">
          {experience.map((e) => (
            <li class={e.kind}>
              <span class="t-period mono">{e.period}</span>
              <div>
                <h3>{e.role}</h3>
                <p class="t-org">{e.org}</p>
                <p class="t-detail">{e.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="about-h">About</h2>
        </div>
        <div class="about-grid">
          <div class="about-text">
            {site.about.map((para) => <p>{para}</p>)}
          </div>
          <div class="facts">
            <div>
              <h3>Education</h3>
              <p><strong>{education.school}</strong><br />{education.degree}, {education.programme}<br /><span class="muted">{education.period}</span></p>
            </div>
            {Object.entries(skills).map(([group, list]) => (
              <div>
                <h3>{group}</h3>
                <ul class="chips">{list.map((s) => <li>{s}</li>)}</ul>
              </div>
            ))}
            <div>
              <h3>Honours</h3>
              <ul class="plain">{honours.map((h) => <li>{h.name}<br /><span class="muted">{h.by}, {h.year}</span></li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 40px var(--gutter); align-items: start; }
  .lede { font-size: clamp(22px, 2.6vw, 32px); line-height: 1.38; font-weight: 300; max-width: 34ch; margin: 0; }
  .now { margin: 0; display: grid; gap: 18px; padding-top: 6px; }
  .now div { border-left: 2px solid var(--scrub); padding-left: 14px; }
  .now dt { color: var(--muted); font-size: 14px; }
  .now dd { margin: 0; }
  @media (max-width: 800px) { .intro-grid { grid-template-columns: 1fr; } }

  .projects { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .projects li { border-bottom: 1px solid var(--rule); }
  .project {
    display: grid; grid-template-columns: 170px minmax(0, 1fr) 220px; gap: 12px 32px;
    padding: 28px 0; color: inherit; text-decoration: none; position: relative;
  }
  .project::before {
    content: ''; position: absolute; left: -16px; top: 28px; bottom: 28px; width: 3px;
    background: var(--scrub); transform: scaleY(0); transition: transform 200ms;
  }
  .project:hover::before, .project:focus-visible::before { transform: scaleY(1); }
  .project:hover .p-title { color: var(--scrub); }
  .p-meta { display: flex; flex-direction: column; gap: 6px; color: var(--muted); }
  .status::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 7px; background: var(--muted); }
  .status.ongoing { color: var(--scrub); }
  .status.ongoing::before { background: var(--scrub); box-shadow: 0 0 0 3px rgba(35, 112, 108, 0.18); }
  .p-main { display: flex; flex-direction: column; gap: 8px; }
  .p-title { font-size: clamp(21px, 2.2vw, 27px); font-variation-settings: 'wdth' 112; line-height: 1.2; transition: color 150ms; }
  .p-sum { color: var(--muted); max-width: 62ch; }
  .p-tags { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); padding-top: 4px; }
  @media (max-width: 900px) {
    .project { grid-template-columns: 1fr; }
    .p-meta { flex-direction: row; gap: 16px; }
    .p-tags { display: none; }
    .project::before { left: -12px; }
  }

  .featured { margin-top: clamp(40px, 6vw, 72px); }

  .key { white-space: nowrap; margin-left: 10px; font-size: 14px; }
  .k { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
  .k.research { background: var(--scrub); }
  .k.clinical { border: 2px solid var(--scrub); }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 190px; top: 8px; bottom: 8px; width: 1px; background: var(--rule); }
  .timeline li { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 8px 40px; padding-bottom: 40px; position: relative; }
  .timeline li::after {
    content: ''; position: absolute; left: 185px; top: 7px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--scrub); box-shadow: 0 0 0 5px var(--paper);
  }
  .timeline li.clinical::after { background: var(--paper); border: 2px solid var(--scrub); }
  .t-period { color: var(--muted); padding-top: 3px; }
  .timeline h3 { font-size: 21px; font-variation-settings: 'wdth' 108; font-weight: 450; }
  .t-org { color: var(--scrub); margin: 4px 0 8px; }
  .t-detail { color: var(--muted); max-width: 64ch; margin: 0; }
  @media (max-width: 700px) {
    .timeline::before { left: 5px; }
    .timeline li { grid-template-columns: 1fr; padding-left: 32px; gap: 4px; }
    .timeline li::after { left: 0; }
  }

  .about-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 48px var(--gutter); }
  .about-text p { font-size: 19px; line-height: 1.65; max-width: 60ch; }
  .facts { display: grid; gap: 30px; align-content: start; }
  .facts h3 { font-size: 15px; color: var(--muted); font-weight: 500; margin-bottom: 10px; }
  .facts p { margin: 0; }
  .muted { color: var(--muted); font-size: 15px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid var(--rule); background: var(--paper-2); border-radius: 999px; padding: 4px 12px; font-size: 14.5px; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }
</style>
