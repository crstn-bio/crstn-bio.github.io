---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import OperatingPoints from '../components/OperatingPoints.astro';
import Question from '../components/Question.astro';
import Design from '../components/Design.astro';
import BuildTrajectory from '../components/BuildTrajectory.astro';
import { site } from '../data/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <Hero />
  <main id="main">
    <Question />
    <Design />
    <BuildTrajectory />

    <section class="section compact-research" id="research" aria-labelledby="research-h">
      <div class="wrap">
        <div class="section-head">
          <h2 id="research-h">Details</h2>
          <p>Methods, assumptions, results and limitations behind selected work.</p>
        </div>
        <ol class="projects">
          {research.map((p) => (
            <li><a class="project" href={`${base}/research/${p.id}/`}>
              <span class="p-meta"><span class="mono">{p.data.period}</span><span class={`status mono ${p.data.status}`}>{p.data.status === 'ongoing' ? 'in progress' : 'complete'}</span></span>
              <span class="p-main"><span class="p-title">{p.data.short}</span><span class="p-sum">{p.data.summary}</span></span>
              <span class="p-tags">{p.data.methods.slice(0, 2).map((m) => <span>{m}</span>)}</span>
            </a></li>
          ))}
        </ol>
        <div class="featured"><OperatingPoints /></div>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .intro-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 40px var(--gutter); align-items: start; }
  .lede { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.32; font-weight: 300; letter-spacing: -0.02em; max-width: 30ch; margin: 0; color: #fff; }
  .now { margin: 0; display: grid; gap: 18px; padding-top: 6px; }
  .now div { border-left: 1px solid var(--rule); padding-left: 16px; }
  .now dt { color: var(--muted); font-size: 14px; }
  .now dd { margin: 0; }
  @media (max-width: 800px) { .intro-grid { grid-template-columns: 1fr; } }

  .proof {
    list-style: none; margin: clamp(56px, 8vw, 96px) 0 0; padding: 32px 0 0;
    border-top: 1px solid var(--rule);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px var(--gutter);
  }
  .proof li { display: flex; flex-direction: column; gap: 10px; }
  .proof strong { font-weight: 250; font-size: clamp(48px, 5.4vw, 72px); letter-spacing: -0.05em; line-height: 1; color: var(--ink); }
  .proof span { color: var(--muted); font-size: 15px; max-width: 30ch; }
  @media (max-width: 760px) { .proof { grid-template-columns: 1fr; } }

  .projects { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .projects li { border-bottom: 1px solid var(--rule); }
  .project {
    display: grid; grid-template-columns: 170px minmax(0, 1fr) 220px; gap: 12px 32px;
    padding: 28px 0; color: inherit; text-decoration: none; position: relative;
  }
  .project::before {
    content: ''; position: absolute; left: -16px; top: 28px; bottom: 28px; width: 3px;
    background: var(--scrub); transform: scaleY(0); transition: transform 200ms;
  }
  .project:hover::before, .project:focus-visible::before { transform: scaleY(1); }
  .project:hover .p-title { color: #fff; text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .p-meta { display: flex; flex-direction: column; gap: 6px; color: var(--muted); }
  .status::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 7px; background: var(--muted); }
  .status.ongoing { color: #fff; }
  .status.ongoing::before { background: #fff; box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.15); }
  .p-main { display: flex; flex-direction: column; gap: 8px; }
  .p-title { font-size: clamp(22px, 2.3vw, 28px); font-weight: 400; color: #fff; letter-spacing: -0.025em; line-height: 1.2; transition: color 150ms; }
  .p-sum { color: var(--muted); max-width: 62ch; }
  .p-tags { display: flex; flex-direction: column; gap: 4px; font-size: 14px; color: var(--muted); padding-top: 4px; }
  @media (max-width: 900px) {
    .project { grid-template-columns: 1fr; }
    .p-meta { flex-direction: row; gap: 16px; }
    .p-tags { display: none; }
    .project::before { left: -12px; }
  }

  .featured { margin-top: clamp(40px, 6vw, 72px); }

  .key { white-space: nowrap; margin-left: 10px; font-size: 14px; }
  .k { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; }
  .k.research { background: var(--scrub); }
  .k.clinical { border: 1.5px solid var(--scrub); }

  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 190px; top: 8px; bottom: 8px; width: 1px; background: var(--rule); }
  .timeline li { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 8px 40px; padding-bottom: 40px; position: relative; }
  .timeline li::after {
    content: ''; position: absolute; left: 185px; top: 7px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--scrub); box-shadow: 0 0 0 5px var(--paper);
  }
  .timeline li.clinical::after { background: var(--paper); border: 1.5px solid var(--scrub); }
  .t-period { color: var(--muted); padding-top: 3px; }
  .timeline h3 { font-size: 21px; font-weight: 450; color: #fff; letter-spacing: -0.015em; line-height: 1.25; }
  .t-org { color: #bdbdbd; margin: 6px 0 8px; }
  .t-detail { color: var(--muted); max-width: 64ch; margin: 0; }
  @media (max-width: 700px) {
    .timeline::before { left: 5px; }
    .timeline li { grid-template-columns: 1fr; padding-left: 32px; gap: 4px; }
    .timeline li::after { left: 0; }
  }

  .about-grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 48px var(--gutter); }
  .about-text p { font-size: 18px; line-height: 1.75; max-width: 60ch; }
  .facts { display: grid; gap: 30px; align-content: start; }
  .facts h3 { font-size: 13px; color: var(--muted); font-weight: 500; margin-bottom: 12px; font-family: var(--mono); }
  .facts p { margin: 0; }
  .muted { color: var(--muted); font-size: 15px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid #333; background: transparent; border-radius: 999px; padding: 4px 12px; font-size: 14.5px; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }
</style>

<style>
  .compact-research{background:#000}.about-final{background:#050505;border-top:1px solid #1d1d1d}.about-final-grid{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr);gap:clamp(34px,7vw,100px);align-items:center}.portrait{aspect-ratio:4/5;overflow:hidden;background:#111}.portrait img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);display:block}.about-kicker{font-size:10px;letter-spacing:.12em;color:#6f7780;margin:0 0 12px}.about-final-copy h2{font-size:clamp(34px,4.6vw,64px);font-weight:350;letter-spacing:-.05em;margin:0 0 18px}.about-role{color:#b8b8b2;line-height:1.6}.about-final-copy>p:not(.about-role):not(.about-kicker){max-width:58ch;color:#858580;line-height:1.7}.about-mini{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:30px;padding-top:22px;border-top:1px solid #222}.about-mini span{font-size:9.5px;color:#69717a;letter-spacing:.1em}.about-mini p{font-size:13px;line-height:1.7;color:#aaa;margin:8px 0 0}.about-links{display:flex;gap:12px;margin-top:30px}.about-links a{border:1px solid #303a45;color:#d9e9fb;text-decoration:none;padding:9px 12px;font:11px var(--mono)}@media(max-width:760px){.about-final-grid{grid-template-columns:1fr}.portrait{max-width:360px}.about-mini{grid-template-columns:1fr 1fr}}
</style>
