---
// 인터랙티브 그림: 고정 민감도에서 p-tau217 단독 vs + Aβ42/40 의 특이도
// 데이터는 프로젝트 그림(out-of-fold 예측)에서 옮겨 온 값이에요.
const rows = [
  { sens: '90%', base: 0.713, combo: 0.803, delta: 9.0 },
  { sens: '95%', base: 0.543, combo: 0.647, delta: 10.3 }  // delta는 반올림 전 값 기준(원본 그림),
];
const min = 0.5, max = 0.85;
const pct = (v: number) => ((v - min) / (max - min)) * 100;
const ticks = [0.5, 0.6, 0.7, 0.8];
---
<figure class="op" data-state="base">
  <div class="op-top">
    <figcaption>
      <h3>Adding Aβ42/40 raised specificity at both operating points</h3>
      <p>Sensitivity is held fixed; the dot shows specificity, the share of amyloid-negative people correctly left out of the screen-positive group.</p>
    </figcaption>
    <div class="toggle" role="group" aria-label="Model">
      <button type="button" data-set="base" aria-pressed="true">p-tau217 alone</button>
      <button type="button" data-set="combo" aria-pressed="false">p-tau217 + Aβ42/40</button>
    </div>
  </div>

  <div class="op-plot">
    <div class="axis mono" aria-hidden="true">
      {ticks.map((t) => <span style={`left:${pct(t)}%`}>{t.toFixed(1)}</span>)}
    </div>
    {rows.map((r) => (
      <div class="row" style={`--b:${pct(r.base)}%; --c:${pct(r.combo)}%;`}>
        <div class="row-label"><span class="mono">sensitivity fixed at</span><strong>{r.sens}</strong></div>
        <div class="track" role="img" aria-label={`At ${r.sens} sensitivity, specificity rises from ${r.base.toFixed(3)} with p-tau217 alone to ${r.combo.toFixed(3)} with Aβ42/40 added.`}>
          {ticks.map((t) => <i class="grid" style={`left:${pct(t)}%`}></i>)}
          <i class="gain"></i>
          <i class="ghost"></i>
          <i class="marker"></i>
          <span class="val mono val-base">{r.base.toFixed(3)}</span>
          <span class="val mono val-combo">{r.combo.toFixed(3)}</span>
          <span class="delta mono">+{r.delta.toFixed(1)} pp</span>
        </div>
      </div>
    ))}
    <div class="axis-title mono" aria-hidden="true">specificity</div>
  </div>

  <p class="op-note">Descriptive operating-point analysis on out-of-fold predictions from participant-grouped 5-fold cross-validation (5 repeats). Not an independent external validation.</p>
</figure>

<style>
  .op {
    margin: 0; background: var(--theatre); color: var(--on-dark);
    border-radius: 14px; padding: clamp(22px, 4vw, 44px);
  }
  .op-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px 32px; align-items: flex-start; }
  figcaption { max-width: 54ch; }
  h3 { font-size: clamp(21px, 2.3vw, 28px); font-weight: 350; font-variation-settings: 'wdth' 112; color: #f2faf9; margin-bottom: 10px; }
  figcaption p { color: var(--on-dark-muted); margin: 0; font-size: 15px; }

  .toggle { display: inline-flex; border: 1px solid var(--theatre-line); border-radius: 999px; padding: 4px; }
  .toggle button {
    font: inherit; font-size: 14px; color: var(--on-dark-muted); background: transparent; border: 0;
    padding: 8px 16px; border-radius: 999px; cursor: pointer; white-space: nowrap;
  }
  .toggle button[aria-pressed='true'] { background: var(--theatre-2); color: var(--phosphor); }
  .toggle button:hover { color: #fff; }

  .op-plot { position: relative; margin-top: 44px; padding-top: 26px; }
  .axis { position: absolute; top: 0; left: var(--label-w); right: 0; height: 20px; color: #5f7f80; }
  .axis span { position: absolute; transform: translateX(-50%); }
  .axis-title { text-align: right; color: #5f7f80; margin-top: 10px; }
  .op-plot { --label-w: 170px; }

  .row { display: grid; grid-template-columns: var(--label-w) 1fr; align-items: center; min-height: 78px; }
  .row + .row { border-top: 1px solid var(--theatre-line); }
  .row-label { display: flex; flex-direction: column; line-height: 1.2; }
  .row-label span { color: #5f7f80; }
  .row-label strong { font-weight: 400; font-size: 28px; font-variation-settings: 'wdth' 120; color: #f2faf9; }

  .track { position: relative; height: 78px; }
  .grid { position: absolute; top: 14px; bottom: 14px; width: 1px; background: var(--theatre-line); }
  .gain {
    position: absolute; top: 50%; height: 2px; margin-top: -1px;
    left: var(--b); width: calc(var(--c) - var(--b));
    background: var(--pulse); transform-origin: left; transform: scaleX(0);
    transition: transform 600ms cubic-bezier(.2,.7,.2,1);
  }
  .ghost, .marker {
    position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%;
  }
  .ghost { left: var(--b); border: 1.5px solid var(--on-dark-muted); opacity: 0; transition: opacity 300ms; }
  .marker {
    left: var(--b); background: var(--phosphor); box-shadow: 0 0 0 6px rgba(123, 227, 201, 0.14);
    transition: left 600ms cubic-bezier(.2,.7,.2,1);
  }
  .val { position: absolute; top: calc(50% + 14px); transform: translateX(-50%); color: var(--on-dark); transition: opacity 300ms; }
  .val-base { left: var(--b); }
  .val-combo { left: var(--c); opacity: 0; color: var(--phosphor); }
  .delta { position: absolute; bottom: calc(50% + 12px); left: calc((var(--b) + var(--c)) / 2); transform: translateX(-50%); color: var(--pulse); opacity: 0; transition: opacity 300ms 250ms; white-space: nowrap; }

  .op[data-state='combo'] .marker { left: var(--c); }
  .op[data-state='combo'] .gain { transform: scaleX(1); }
  .op[data-state='combo'] .ghost,
  .op[data-state='combo'] .val-combo,
  .op[data-state='combo'] .delta { opacity: 1; }
  .op[data-state='combo'] .val-base { opacity: 0.55; }

  .op-note { margin: 24px 0 0; font-size: 13.5px; color: #6e8e8f; max-width: 80ch; }

  @media (max-width: 640px) {
    .op-plot { --label-w: 0px; }
    .row { grid-template-columns: 1fr; padding-top: 12px; }
    .row-label { flex-direction: row; gap: 8px; align-items: baseline; }
    .row-label strong { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .marker, .gain, .ghost, .val, .delta { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.op').forEach((fig) => {
    const buttons = fig.querySelectorAll<HTMLButtonElement>('.toggle button');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        fig.dataset.state = b.dataset.set;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );
  });
</script>
