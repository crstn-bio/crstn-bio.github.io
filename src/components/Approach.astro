---
// 03 · Method: 세 원칙(적은 데이터 · 더 나은 모델 · 최소한의 인터페이스) + 11단계 방법 버튼.
// 원칙 카드는 해당 방법 페이지로 이어져요 (page: 에 roadmap 파일 이름).
// 글은 src/content/site.yaml 의 approach: 에서. 방법 버튼은 공개된 roadmap 페이지를 자동으로 나열해요.
import { site, md, url, getRoadmap } from '../lib/content';
const ap = site.approach ?? {};
const nodes = await getRoadmap();
const bySlug = new Map(nodes.map((n) => [n.slug, n]));
const principles = (ap.principles ?? []).map((p: any) => {
  const node = p.page ? bySlug.get(p.page) : undefined;
  return { ...p, href: node ? url(`/how/${node.slug}/`) : null, n: node?.n, step: node?.data.title };
});
---
<section class="ap section" id="approach" aria-labelledby="ap-h">
  <div class="wrap">
    <div class="head">
      <div><p class="kicker mono">{ap.kicker}</p><h2 id="ap-h">{ap.title}</h2></div>
      {ap.text && <p set:html={md(ap.text)} />}
    </div>

    {principles.length > 0 && (
      <ul class="pr">
        {principles.map((p: any) => {
          const inner = (
            <>
              <span class="pr-t">{p.title}</span>
              {p.text && <span class="pr-x" set:html={md(p.text)} />}
              {p.step && <span class="pr-go mono">{p.n} · {p.step} <span aria-hidden="true">→</span></span>}
            </>
          );
          return <li>{p.href ? <a class="pr-c" href={p.href}>{inner}</a> : <div class="pr-c">{inner}</div>}</li>;
        })}
      </ul>
    )}

    {ap.method_label && nodes.length > 0 && (
      <nav class="method" aria-label={ap.method_label}>
        <p class="m-k mono">{ap.method_label}</p>
        <ol>
          {nodes.map((n) => (
            <li><a class={`m-${n.data.status}`} href={url(`/how/${n.slug}/`)}>
              <span class="m-dot" aria-hidden="true"></span><span class="m-n mono">{n.n}</span><span class="m-t">{n.data.title}</span>
            </a></li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</section>

<style>
  .ap { --acc: #a8c8ff; background: #000; color: #fff; border-top: 1px solid var(--rule); }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px var(--gutter); align-items: end; margin-bottom: clamp(32px, 5vw, 56px); }
  .kicker { color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 14px; }
  .head h2 { margin: 0; font-size: clamp(32px, 4.2vw, 56px); font-weight: 300; letter-spacing: -0.035em; line-height: 1.05; }
  .head > p { margin: 0; color: #a9a9a9; font-size: 17px; line-height: 1.65; max-width: 46ch; }

  .pr { list-style: none; margin: 0 0 clamp(36px, 5vw, 56px); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #262626; border-left: 1px solid #262626; }
  .pr li { display: flex; }
  .pr-c { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: clamp(20px, 2.4vw, 30px); border-right: 1px solid #262626; border-bottom: 1px solid #262626; color: #fff; text-decoration: none; transition: background .2s; }
  a.pr-c:hover, a.pr-c:focus-visible { background: #0a0f17; outline: none; }
  .pr-t { font-size: clamp(22px, 2.2vw, 30px); font-weight: 300; letter-spacing: -0.025em; line-height: 1.1; }
  .pr-x { color: #a9a9a9; font-size: 16px; line-height: 1.5; }
  .pr-go { margin-top: auto; padding-top: 10px; color: #6a6a6a; letter-spacing: .08em; text-transform: uppercase; transition: color .2s; }
  a.pr-c:hover .pr-go { color: var(--acc); }

  .method { margin: 0; }
  .m-k { margin: 0 0 12px; color: #7d7d7d; letter-spacing: .14em; text-transform: uppercase; }
  .method ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .method a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border: 1px solid #2c2c2c; background: #050505; color: #e6e6e6; text-decoration: none; transition: border-color .2s, background .2s, color .2s; }
  .method a:hover, .method a:focus-visible { border-color: var(--acc); background: #0a0f17; color: #fff; outline: none; }
  .m-dot { width: 8px; height: 8px; border-radius: 50%; border: 1px solid #6a6a6a; flex: none; }
  .m-current .m-dot { background: #fff; border-color: #fff; }
  .m-done .m-dot { background: #8a8a8a; border-color: #8a8a8a; }
  .m-question .m-dot, .m-next .m-dot { border-color: var(--acc); border-style: dashed; }
  .m-concept .m-dot, .m-frontier .m-dot { border-style: dotted; }
  .m-n { color: #6a6a6a; }
  .m-t { font-size: 15px; }
  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .pr { grid-template-columns: 1fr; }
  }
</style>
