---
// 04 · Contact. 예전 About 내용을 여기로 합쳤어요 (큰 사진은 빼고 작은 사진 하나만).
import fs from 'node:fs';
import path from 'node:path';
import { site, md, url } from '../lib/content';
const C = site.contact ?? {};
const year = new Date().getFullYear();
// 이메일이 아직 예시 주소이거나 CV 파일이 없으면 버튼을 숨겨서 깨진 링크가 없게 해요.
const hasEmail = !!site.email && !site.email.includes('your.email');
const hasCv = !!site.cv && fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
---
<footer id="contact" class="foot" aria-labelledby="contact-h">
  <div class="wrap">
    <p class="kicker mono">{C.kicker}</p>
    <div class="foot-grid">
      <div class="copy">
        <h2 id="contact-h">{C.title}</h2>
        <p class="who"><strong>{site.name}</strong>{(C.who ?? []).map((l: string) => <><br />{l}</>)}</p>
        {C.text && <p class="lede" set:html={md(C.text)} />}
        {C.tags?.length > 0 && <ul class="meta mono">{C.tags.map((t: string) => <li>{t}</li>)}</ul>}
        {hasEmail && (
          <div class="mailbox">
            <span class="mb-k mono">Email</span>
            <a class="mb-addr" href={`mailto:${site.email}`}>{site.email}</a>
            <button type="button" class="mb-copy mono" data-copy={site.email} aria-label={`Copy ${site.email}`}>Copy</button>
          </div>
        )}
        <div class="actions">
          {hasEmail && <a class="btn primary" href={`mailto:${site.email}?subject=${encodeURIComponent(C.email_subject ?? '')}`}>{C.email_button}</a>}
          {hasCv && <a class="btn" href={url(site.cv)}>{C.cv_button}</a>}
          {(site.links ?? []).map((l: any) => <a class="btn" href={l.url} rel="noopener" target="_blank">{l.label} ↗</a>)}
        </div>
      </div>
      {C.photo && <img class="avatar" src={url(C.photo)} alt={`Portrait of ${site.name}`} width="570" height="731" loading="lazy" />}
    </div>
  </div>
  <div class="wrap foot-base mono">
    <span>© {year} {site.name}</span>
    <span>{C.footer}</span>
  </div>
</footer>

<script>
  // 이메일 복사 버튼
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const text = b.dataset.copy || '';
      try { await navigator.clipboard.writeText(text); }
      catch {
        const t = document.createElement('textarea'); t.value = text; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } finally { t.remove(); }
      }
      b.textContent = 'Copied'; b.classList.add('done');
      setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1600);
    });
  });
</script>

<style>
  .foot { background: #000; color: var(--on-dark); padding-top: clamp(88px, 12vw, 150px); border-top: 1px solid var(--rule); }
  .kicker { color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 20px; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 40px var(--gutter); align-items: end; }
  h2 { font-size: clamp(32px, 4.4vw, 60px); font-weight: 300; letter-spacing: -0.035em; margin: 0 0 32px; color: #fff; line-height: 1.05; max-width: 18ch; text-wrap: balance; }
  .who { color: #d6d6d6; line-height: 1.6; margin: 0 0 16px; }
  .who strong { color: #fff; font-weight: 500; letter-spacing: 0.02em; }
  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0; padding: 0; }
  .meta li { border: 1px solid #2c2c2c; padding: 5px 9px; color: #bdbdbd; letter-spacing: 0.1em; text-transform: uppercase; }
  .lede { color: #a9a9a9; max-width: 56ch; line-height: 1.7; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .btn {
    display: inline-block; text-decoration: none; color: #fff; border: 1.5px solid #fff; padding: 13px 22px;
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; transition: background 200ms, color 200ms;
  }
  .btn:hover, .btn.primary { background: #fff; color: #000; }
  .btn.primary:hover { background: transparent; color: #fff; }
  /* 이메일 칸: 주소를 크게 보여주고 복사 버튼을 둬요 */
  .mailbox { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0 18px; max-width: 620px; margin-top: 32px; border: 1px solid #2c2c2c; background: #050505; }
  .mb-k { padding: 18px 0 18px 18px; color: #7d7d7d; letter-spacing: 0.12em; text-transform: uppercase; }
  .mb-addr { color: #fff; text-decoration: none; font-size: clamp(17px, 1.9vw, 22px); font-weight: 350; letter-spacing: -0.01em; overflow-wrap: anywhere; padding: 14px 0; }
  .mb-addr:hover { color: #a8c8ff; }
  .mb-copy { align-self: stretch; background: none; border: 0; border-left: 1px solid #2c2c2c; color: #cfcfcf; padding: 0 20px; cursor: pointer; letter-spacing: 0.12em; text-transform: uppercase; }
  .mb-copy:hover { background: #fff; color: #000; }
  .mb-copy.done { color: #a8c8ff; }
  .avatar {
    width: 180px; height: auto; flex: none; justify-self: end;
    filter: grayscale(1) contrast(1.06); transition: filter 400ms; box-shadow: 0 0 0 1px #222;
  }
  .avatar:hover { filter: none; }
  .foot-base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: clamp(72px, 9vw, 110px); padding-block: 22px; border-top: 1px solid #222; color: #6a6a6a;
  }
  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr; }
    .mailbox { grid-template-columns: minmax(0, 1fr) auto; }
    .mb-k { grid-column: 1 / -1; padding: 12px 14px 0; }
    .mb-addr { padding: 6px 0 14px 14px; }
    .avatar { justify-self: start; width: 140px; }
  }
  @media (prefers-reduced-motion: reduce) { .avatar, .btn { transition: none; } }
</style>
