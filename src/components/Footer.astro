---
// 04 · Contact. 예전 About 내용을 여기로 합쳤어요 (큰 사진은 빼고 작은 사진 하나만).
import fs from 'node:fs';
import path from 'node:path';
import { site, md, url } from '../lib/content';
const C = site.contact ?? {};
const year = new Date().getFullYear();
// 이메일이 아직 예시 주소이거나 CV 파일이 없으면 버튼을 숨겨서 깨진 링크가 없게 해요.
const hasEmail = !!site.email && !site.email.includes('your.email');
const hasCv = !!site.cv && fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
---
<footer id="contact" class="foot" aria-labelledby="contact-h">
  <div class="wrap">
    <h2 id="contact-h">{C.title}</h2>
    <div class="foot-grid">
      <div class="copy">
        {C.text && <p class="lede" set:html={md(C.text)} />}
        <p class="who"><span class="who-n">{site.name}</span>{(C.who ?? []).map((l: string) => <span>{l}</span>)}</p>
        {C.tags?.length > 0 && <ul class="meta" aria-label="Interests">{C.tags.map((t: string) => <li>{t}</li>)}</ul>}
      </div>
      {C.photo && <img class="avatar" src={url(C.photo)} alt={`Portrait of ${site.name}`} width="570" height="731" loading="lazy" />}
    </div>

    {hasEmail && (
      <div class="mail">
        <a class="mail-a" href={`mailto:${site.email}?subject=${encodeURIComponent(C.email_subject ?? '')}`}>{site.email}</a>
        <button type="button" class="btn-text mail-c" data-copy={site.email} aria-label={`Copy ${site.email}`}>Copy</button>
      </div>
    )}
    <div class="actions">
      {hasEmail && <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent(C.email_subject ?? '')}`}>{C.email_button}</a>}
      {hasCv && <a class="btn-text" href={url(site.cv)}>{C.cv_button}</a>}
      {(site.links ?? []).map((l: any) => <a class="btn-text" href={l.url} rel="noopener" target="_blank">{l.label}</a>)}
    </div>
  </div>
  <div class="wrap foot-base">
    <span>© {year} {site.name}</span>
    <span>{C.footer}</span>
  </div>
</footer>

<script>
  // 이메일 복사 버튼
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      const text = b.dataset.copy || '';
      try { await navigator.clipboard.writeText(text); }
      catch {
        const t = document.createElement('textarea'); t.value = text; document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } finally { t.remove(); }
      }
      b.textContent = 'Copied'; b.classList.add('done');
      setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1600);
    });
  });
</script>

<style>
  .foot { background: #000; color: var(--on-dark); padding-top: clamp(112px, 14vw, 184px); }
  h2 { font-size: clamp(40px, 6vw, 92px); font-weight: 300; letter-spacing: -0.05em; margin: 0; color: #fff; line-height: 1; max-width: 15ch; text-wrap: balance; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1fr) 160px; gap: 40px var(--gutter); align-items: start; margin-top: clamp(28px, 3.4vw, 44px); }
  .lede { color: #a9a9a9; max-width: 52ch; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.55; margin: 0; }
  .who { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 24px 0 0; color: #7a7a7a; font-size: 14px; }
  .who-n { color: #fff; }
  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 10px 0 0; padding: 0; color: #5a5a5a; font-size: 14px; }

  .mail { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 28px; margin-top: clamp(56px, 7vw, 88px); padding-top: 28px; border-top: 1px solid #1f1f1f; }
  .mail-a { color: #fff; text-decoration: none; font-size: clamp(26px, 3.6vw, 52px); font-weight: 300; letter-spacing: -0.035em; line-height: 1.1; overflow-wrap: anywhere; transition: color .2s; }
  .mail-a:hover { color: #a8c8ff; }
  .mail-c { font-size: 14px; }
  .mail-c.done { color: #a8c8ff; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 28px; }

  .avatar { width: 160px; height: auto; justify-self: end; filter: grayscale(1) contrast(1.05); transition: filter 400ms; }
  .avatar:hover { filter: none; }
  .foot-base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: clamp(96px, 11vw, 144px); padding-block: 24px; color: #555; font-size: 13px;
    background: linear-gradient(#1a1a1a, #1a1a1a) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }
  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr; }
    .avatar { justify-self: start; width: 120px; order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .avatar, .mail-a { transition: none; } }
</style>
