---
// 04 · Contact. 예전 About 내용을 여기로 합쳤어요 (큰 사진은 빼고 작은 사진 하나만).
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../data/site';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 이메일이 아직 예시 주소이거나 CV 파일이 없으면 버튼을 숨겨서 깨진 링크가 없게 해요.
const hasEmail = !!site.email && !site.email.includes('your.email');
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', site.cv.replace(/^\//, '')));
---
<footer id="contact" class="foot" aria-labelledby="contact-h">
  <div class="wrap">
    <p class="kicker mono">04 / Contact</p>
    <div class="foot-grid">
      <div class="copy">
        <h2 id="contact-h">Get in touch</h2>
        <p class="role">University of Toronto · Honours BSc<br />Research Assistant &amp; Thesis Student · Krembil Brain Institute, UHN</p>
        <p class="lede">I’m looking for research positions and collaborations in human neuromodulation, neural state decoding and neurotechnology, in Toronto and beyond.</p>
        <div class="mini">
          <div><h3 class="mono">Research</h3><p>Individual brain modelling<br />Human neuromodulation<br />Neural state decoding</p></div>
          <div><h3 class="mono">Open to</h3><p>Research positions<br />Summer 2027<br />Collaborations</p></div>
        </div>
        <div class="actions">
          {hasEmail && <a class="btn primary" href={`mailto:${site.email}`}>Email me</a>}
          {site.links.map((l) => <a class="btn" href={l.href} rel="noopener" target="_blank">{l.label}</a>)}
          {hasCv && <a class="btn" href={`${base}${site.cv}`}>CV (PDF)</a>}
        </div>
        {hasEmail && <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
      <img class="avatar" src={`${base}/profile.jpg`} alt={`Portrait of ${site.name}`} width="570" height="731" loading="lazy" />
    </div>
  </div>
  <div class="wrap foot-base mono">
    <span>© {year} {site.name}</span>
    <span>Built by hand with Astro. Source on GitHub.</span>
  </div>
</footer>

<style>
  .foot { background: #000; color: var(--on-dark); padding-top: clamp(88px, 12vw, 150px); border-top: 1px solid var(--rule); }
  .kicker { color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 20px; }
  .foot-grid { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 40px var(--gutter); align-items: end; }
  h2 { font-size: clamp(38px, 6vw, 80px); font-weight: 500; letter-spacing: 0.01em; text-transform: uppercase; margin: 0 0 28px; color: #fff; line-height: 1; }
  .role { color: #d6d6d6; line-height: 1.6; margin: 0 0 16px; }
  .lede { color: #a9a9a9; max-width: 56ch; line-height: 1.7; margin: 0; }
  .mini { display: grid; grid-template-columns: repeat(2, minmax(0, 220px)); gap: 24px; margin-top: 32px; padding-top: 20px; border-top: 1px solid #222; }
  .mini h3 { margin: 0 0 8px; color: #7d7d7d; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; }
  .mini p { margin: 0; color: #cfcfcf; font-size: 14.5px; line-height: 1.75; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .btn {
    display: inline-block; text-decoration: none; color: #fff; border: 1.5px solid #fff; padding: 13px 22px;
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; transition: background 200ms, color 200ms;
  }
  .btn:hover, .btn.primary { background: #fff; color: #000; }
  .btn.primary:hover { background: transparent; color: #fff; }
  .mail { display: inline-block; margin-top: 16px; color: #a9a9a9; font-size: 15px; word-break: break-all; }
  .avatar {
    width: 180px; height: auto; flex: none; justify-self: end;
    filter: grayscale(1) contrast(1.06); transition: filter 400ms; box-shadow: 0 0 0 1px #222;
  }
  .avatar:hover { filter: none; }
  .foot-base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: clamp(72px, 9vw, 110px); padding-block: 22px; border-top: 1px solid #222; color: #6a6a6a;
  }
  @media (max-width: 760px) {
    .foot-grid { grid-template-columns: 1fr; }
    .avatar { justify-self: start; width: 140px; }
  }
  @media (prefers-reduced-motion: reduce) { .avatar, .btn { transition: none; } }
</style>
