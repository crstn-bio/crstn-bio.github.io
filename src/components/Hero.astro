---
import Nav from './Nav.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-name">
  <canvas id="array" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <Nav />
    <div class="wrap hero-body">
      <h1 id="hero-name">{site.name}</h1>
      <p class="hero-title">{site.title}</p>
      <p class="hero-current">{site.current}. {site.location}.</p>
    </div>

    <div class="wrap readout">
      <dl class="mono">
        <div><dt>array</dt><dd>simulated electrode grid</dd></div>
        <div><dt>stimulus</dt><dd>θ-burst, 3 pulses at 50 Hz every 200 ms</dd></div>
        <div><dt>playback</dt><dd>slowed 10×</dd></div>
      </dl>
      <p class="mono note">Illustration of the stimulation pattern in my thesis work, not recorded data.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: radial-gradient(1100px 700px at 72% 42%, #111822 0%, var(--theatre) 62%);
    color: var(--on-dark);
    min-height: min(100svh, 940px);
    overflow: hidden;
    isolation: isolate;
  }
  canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1;
    -webkit-mask-image: linear-gradient(90deg, transparent 28%, #000 62%);
            mask-image: linear-gradient(90deg, transparent 28%, #000 62%);
  }
  .hero-inner { min-height: inherit; display: flex; flex-direction: column; }
  .hero-body { padding-top: clamp(64px, 14vh, 160px); }
  h1 {
    font-size: clamp(56px, 10.5vw, 156px);
    font-weight: 250;
    letter-spacing: -0.055em;
    line-height: 0.92;
    color: #f2f5f8;
    max-width: 8ch;
  }
  .hero-title {
    margin-top: clamp(24px, 3vw, 36px);
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 330;
    letter-spacing: -0.01em;
    color: var(--phosphor);
  }
  .hero-current { max-width: 46ch; color: var(--on-dark-muted); margin-top: 6px; font-weight: 330; }

  .readout { margin-top: auto; padding-top: 48px; padding-bottom: 28px; }
  dl {
    display: flex; flex-wrap: wrap; gap: 10px 40px; margin: 0;
    border-top: 1px solid var(--theatre-line); padding-top: 16px;
  }
  dl div { display: flex; gap: 12px; }
  dt { color: var(--on-dark-faint); }
  dd { margin: 0; color: var(--on-dark); }
  .note { color: var(--on-dark-faint); margin: 10px 0 0; }

  @media (max-width: 760px) {
    canvas {
      -webkit-mask-image: linear-gradient(180deg, transparent 50%, #000 64%, #000 74%, transparent 84%);
              mask-image: linear-gradient(180deg, transparent 50%, #000 64%, #000 74%, transparent 84%);
    }
    h1 { max-width: none; }
    dl { flex-direction: column; gap: 6px; }
  }
</style>

<script>
  // 전극 배열처럼 보이는 점 격자. 초점(집속 초음파 목표 지점)에서
  // 세타 버스트 펄스마다 파동이 퍼지고, 지나가는 전극이 잠시 밝아져요.
  const canvas = document.getElementById('array') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SLOW = 10;                         // 재생 속도 1/10
    const BURST_EVERY = 0.2 * SLOW;          // 5 Hz → 실제 2초마다
    const PULSE_GAP = 0.02 * SLOW;           // 50 Hz → 0.2초 간격
    const SPEED = 150;                       // 파동 속도 (px/s)
    const SIGMA = 16;

    type Ripple = { t0: number; amp: number };
    let w = 0, h = 0, dpr = 1, gap = 24;
    let fx = 0, fy = 0;
    let dots: { x: number; y: number; d: number; glow: number; n: number }[] = [];
    let ripples: Ripple[] = [];
    let start = performance.now();
    let lastBurst = -Infinity;
    let running = true;

    function layout() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas!.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas!.width = Math.round(w * dpr); canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const mobile = w < 760;
      gap = mobile ? 20 : 24;
      fx = mobile ? w * 0.62 : w * 0.72;
      fy = mobile ? h * 0.69 : h * 0.44;
      dots = [];
      const ox = (w % gap) / 2, oy = (h % gap) / 2;
      for (let y = oy; y <= h; y += gap) {
        for (let x = ox; x <= w; x += gap) {
          dots.push({ x, y, d: Math.hypot(x - fx, y - fy), glow: 0, n: Math.random() * 6.28 });
        }
      }
    }

    function spawnBurst(t: number) {
      for (let k = 0; k < 3; k++) ripples.push({ t0: t + k * PULSE_GAP, amp: 1 });
    }

    function draw(t: number, dt: number) {
      ctx.clearRect(0, 0, w, h);
      ripples = ripples.filter((r) => (t - r.t0) * SPEED < Math.max(w, h) * 1.1);
      const reach = Math.max(w, h);

      for (const p of dots) {
        let a = 0;
        for (const r of ripples) {
          const age = t - r.t0;
          if (age < 0) continue;
          const front = age * SPEED;
          const off = p.d - front;
          if (off > 3 * SIGMA || off < -3 * SIGMA) continue;
          a += Math.exp(-(off * off) / (2 * SIGMA * SIGMA)) * Math.exp(-p.d / (reach * 0.24));
        }
        // 초점 근처 전극은 버스트가 반복될수록 잔광이 조금씩 쌓임
        p.glow += (a * 0.35 - p.glow) * Math.min(1, dt * 1.2);
        const flicker = 0.04 * (1 + Math.sin(t * 0.7 + p.n));
        const v = Math.min(1, a + p.glow + flicker);

        const rad = 0.9 + v * 1.5;
        if (v > 0.25) {
          ctx.fillStyle = `rgba(156, 194, 240, ${0.12 * v})`;
          ctx.beginPath(); ctx.arc(p.x, p.y, rad * 4, 0, 6.2832); ctx.fill();
        }
        const base = [30, 37, 46], hi = [196, 220, 248];
        const c = base.map((b, i) => Math.round(b + (hi[i] - b) * v));
        ctx.fillStyle = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, rad, 0, 6.2832); ctx.fill();
      }

      // 초점 표시: 얇은 원과 눈금
      ctx.strokeStyle = 'rgba(156, 194, 240, 0.55)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(fx, fy, 26, 0, 6.2832); ctx.stroke();
      ctx.strokeStyle = 'rgba(156, 194, 240, 0.22)';
      ctx.beginPath(); ctx.arc(fx, fy, 64, 0, 6.2832); ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 4; i++) {
        const ang = (i * Math.PI) / 2;
        ctx.moveTo(fx + Math.cos(ang) * 34, fy + Math.sin(ang) * 34);
        ctx.lineTo(fx + Math.cos(ang) * 46, fy + Math.sin(ang) * 46);
      }
      ctx.strokeStyle = 'rgba(156, 194, 240, 0.55)';
      ctx.stroke();
    }

    let prev = 0;
    function frame(now: number) {
      if (!running) return;
      const t = (now - start) / 1000;
      const dt = Math.min(0.05, t - prev); prev = t;
      if (t - lastBurst >= BURST_EVERY) { spawnBurst(t); lastBurst = t; }
      draw(t, dt);
      requestAnimationFrame(frame);
    }

    layout();
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(layout, 120);
    });

    if (reduce) {
      // 움직임 줄이기: 파동이 퍼져 있는 한 장면만 그림
      ripples = [{ t0: 0, amp: 1 }, { t0: 0.2, amp: 1 }, { t0: 0.4, amp: 1 }];
      draw(1.4, 1);
      window.addEventListener('resize', () => setTimeout(() => draw(1.4, 1), 150));
    } else {
      // 화면 밖에 있을 때는 멈춰서 배터리 절약
      new IntersectionObserver(([e]) => {
        const was = running;
        running = e.isIntersecting;
        if (running && !was) { prev = (performance.now() - start) / 1000; requestAnimationFrame(frame); }
      }).observe(canvas);
      requestAnimationFrame(frame);
    }
  }
</script>
