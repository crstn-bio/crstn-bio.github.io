---
// 첫 화면: 실제 해부 데이터(HCP S1200 집단 평균)로 그린 뇌.
// MRI처럼 뒤에서 앞으로 한 번 스캔되며 나타나고, 사이트의 세 표적(M1 · STN · 해마)이 차례로 켜져요.
// 그 뒤에는 아주 천천히 돌기만 해요. 마우스를 움직이면 살짝 따라 돌아요.
// 글은 src/content/site.yaml 의 hero: 에서.
import Nav from './Nav.astro';
import { site, getRoadmap, url } from '../lib/content';
const h = site.hero ?? {};
const firstNode = (await getRoadmap())[0];
const targets = h.targets ?? [];
---
<section class="hero" aria-labelledby="hero-h" data-targets={JSON.stringify(targets)}>
  <canvas id="hero-gl" aria-hidden="true"></canvas>
  <canvas id="hero-ov" aria-hidden="true"></canvas>
  <div class="shade" aria-hidden="true"></div>

  <Nav fixed />

  <div class="wrap hero-body">
    <h1 id="hero-h">{h.title}</h1>
    {h.line && <p class="lede">{h.line}</p>}
    <div class="actions">
      {h.button && <a class="btn" href="#question">{h.button}</a>}
      {h.button_method && firstNode && <a class="btn-text" href={url(`/how/${firstNode.slug}/`)}>{h.button_method}</a>}
    </div>
  </div>

  {h.caption && <p class="credit">{h.caption}</p>}
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    background: #000; color: #fff;
    min-height: max(680px, min(100svh, 1040px));
    display: flex; flex-direction: column;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  #hero-ov { z-index: -1; }
  /* 글 뒤를 어둡게: 왼쪽 아래만 */
  .shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0,0,0,.7) 0%, rgba(0,0,0,.25) 36%, transparent 54%),
      linear-gradient(0deg, #000 0%, rgba(0,0,0,.6) 22%, transparent 48%);
  }

  .hero-body { margin-top: auto; padding-bottom: clamp(56px, 9vh, 104px); }
  h1 {
    font-size: clamp(48px, 7.6vw, 116px); font-weight: 300; line-height: 0.96; letter-spacing: -0.05em;
    max-width: 9.5ch; margin: 0;
  }
  .lede { margin: clamp(20px, 2.4vw, 30px) 0 0; max-width: 38ch; color: #b3b3b3; font-size: clamp(17px, 1.45vw, 20px); line-height: 1.5; font-weight: 350; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: clamp(28px, 3.4vw, 40px); }

  .credit {
    position: absolute; right: var(--gutter); bottom: 22px; margin: 0;
    max-width: 52ch; text-align: right; color: #5c5c5c; font-size: 12px; line-height: 1.45;
  }

  @media (max-width: 760px) {
    .hero { min-height: max(720px, 100svh); }
    .shade { background: linear-gradient(0deg, #000 0%, rgba(0,0,0,.92) 40%, transparent 62%); }
    .hero-body { padding-bottom: 64px; }
    .credit { right: auto; left: var(--gutter); text-align: left; bottom: 20px; }
  }
</style>

<script>
  import { loadBrain, createRenderer, makeCamera, project, type BrainData, type Pass, type Renderer, type V3 } from '../scripts/hcpBrain';

  const hero = document.querySelector<HTMLElement>('.hero');
  const glc0 = document.getElementById('hero-gl') as HTMLCanvasElement | null;
  const ov = document.getElementById('hero-ov') as HTMLCanvasElement | null;

  if (hero && glc0 && ov) {
    const ctx = ov.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ACC: V3 = [168 / 255, 200 / 255, 1];
    type T = { id: 'm1' | 'stn' | 'hpc'; name: string; note?: string };
    let TG: T[] = [];
    try { TG = JSON.parse(hero.dataset.targets || '[]'); } catch { /* 이름표 없이 */ }

    let data: BrainData | null = null, renderer: Renderer | null = null, glc = glc0;
    let w = 0, h = 0, dpr = 1, mobile = false;
    function layout() {
      const r = hero!.getBoundingClientRect();
      w = r.width; h = r.height; mobile = w < 760;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      ov!.width = Math.round(w * dpr); ov!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      renderer?.resize(w, h, dpr);
    }

    // 시간표 (초): 스캔 0–2.8 → 표적이 하나씩 켜짐
    const SWEEP = 3.2, ON = { m1: 3.0, stn: 3.6, hpc: 4.2 } as const, FADE = 0.9;
    const ease = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : 1 - (1 - x) ** 3);
    const inout = (x: number) => (x <= 0 ? 0 : x >= 1 ? 1 : x * x * (3 - 2 * x));
    const clamp01 = (x: number) => Math.max(0, Math.min(1, x));

    // 마우스를 따라 살짝 도는 양 (부드럽게 따라감)
    let mx = 0, mxS = 0, my = 0, myS = 0;
    if (!reduce) window.addEventListener('pointermove', (e) => { mx = e.clientX / window.innerWidth - 0.5; my = e.clientY / window.innerHeight - 0.5; }, { passive: true });

    const C: V3 = [0, -17, 12];          // 뇌 가운데 (MNI mm)
    function draw(t: number) {
      if (!data || !renderer) return;
      mxS += (mx - mxS) * 0.04; myS += (my - myS) * 0.04;
      const az = 0.42 + (reduce ? 0 : 0.2 * Math.sin(t * 0.07)) + mxS * 0.35;
      const el = 0.16 + (reduce ? 0 : 0.03 * Math.sin(t * 0.05)) - myS * 0.12;
      const k = mobile ? Math.min((0.94 * w) / 172, (0.44 * h) / 150) : Math.min((0.52 * w) / 172, (0.78 * h) / 150);
      const cam = makeCamera(az, el, C, k, mobile ? w * 0.5 : w * 0.66, mobile ? h * 0.3 : h * 0.46);

      const s = clamp01(t / SWEEP);
      const reveal = -112 + 194 * inout(s);
      const band = s < 1 ? 0.16 * Math.sin(Math.PI * s) : 0;
      const on = (id: keyof typeof ON) => ease((t - ON[id]) / FADE);
      const g = 1.15;                                       // 피질 밝기
      const passes: Pass[] = [
        { part: 'ctxL', mode: 'cortex', gain: g },
        { part: 'ctxR', mode: 'cortex', gain: g * 0.55 },
        { part: 'm1', mode: 'cortex', gain: g * (1 - on('m1')) },
        { part: 'm1', mode: 'accent', gain: 0.22 * on('m1'), color: ACC, glow: true },
        { part: 'cb', mode: 'faint', gain: 0.09 },
        { part: 'bs', mode: 'faint', gain: 0.1, cutZ: -60 },
        { part: 'thal', mode: 'faint', gain: 0.06 },
        { part: 'hpcL', mode: 'faint', gain: 0.07 * (1 - on('hpc')) },
        { part: 'hpcR', mode: 'faint', gain: 0.07 },
        { part: 'hpcL', mode: 'accent', gain: 0.42 * on('hpc'), color: ACC, glow: true },
        { part: 'stnL', mode: 'accent', gain: 0.26 * on('stn'), color: ACC, glow: true },
      ];
      renderer.draw(cam, passes, mobile ? 0.6 : 1, { reveal, band });

      // 이름표: 표적에서 짧은 선을 그어 오른쪽에
      ctx.clearRect(0, 0, w, h);
      if (!TG.length) return;
      const lm = data.landmarks;
      const at: Record<T['id'], V3> = { m1: lm.m1.target, stn: lm.stn.L, hpc: lm.hpc.L.centroid };
      // 이름표 자리 (표적에서의 거리, px): 겹치지 않게 손으로 정했어요
      const off: Record<T['id'], [number, number]> = mobile
        ? { m1: [34, -40], stn: [70, -8], hpc: [56, 40] }
        : { m1: [64, -72], stn: [150, -28], hpc: [118, 70] };
      ctx.save();
      ctx.textBaseline = 'middle'; ctx.lineWidth = 1;
      for (const tg of TG) {
        const a = on(tg.id);
        if (a <= 0.01 || !at[tg.id]) continue;
        const [px, py] = project(cam, at[tg.id]);
        let [dx, dy] = off[tg.id];
        // 이름표가 화면 오른쪽 밖으로 나가면 왼쪽으로 뒤집어요
        ctx.font = `400 ${mobile ? 12 : 13}px "Geist Variable", system-ui, sans-serif`;
        const tw = ctx.measureText(tg.name).width;
        const flip = px + dx + 8 + tw > w - 12;
        if (flip) dx = -Math.min(Math.abs(dx), Math.max(14, px - tw - 26));
        const lx = px + dx, ly = py + dy, run = Math.min(1, a * 1.4);
        ctx.globalAlpha = a;
        ctx.strokeStyle = 'rgba(255,255,255,0.45)';
        ctx.beginPath(); ctx.arc(px, py, 3.5, 0, Math.PI * 2); ctx.stroke();
        // 꺾인 선: 비스듬히 → 가로
        const kx = px + dx * 0.55, ky = ly;
        ctx.beginPath(); ctx.moveTo(px + (dx > 0 ? 3 : -3), py + (dy > 0 ? 2.5 : -2.5));
        ctx.lineTo(px + (kx - px) * run, py + (ky - py) * run);
        if (run >= 1) ctx.lineTo(lx, ly);
        ctx.stroke();
        ctx.font = `400 ${mobile ? 12 : 13}px "Geist Variable", system-ui, sans-serif`;
        ctx.fillStyle = 'rgba(255,255,255,0.88)';
        ctx.textAlign = flip ? 'right' : 'left';
        const tx = flip ? lx - 8 : lx + 8;
        ctx.fillText(tg.name, tx, ly - (tg.note ? 7 : 0));
        if (tg.note) {
          ctx.font = `400 ${mobile ? 11 : 12}px "Geist Variable", system-ui, sans-serif`;
          ctx.fillStyle = 'rgba(168,200,255,0.85)';
          ctx.fillText(tg.note, tx, ly + 10);
        }
      }
      ctx.restore();
    }

    layout();
    let rt = 0;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { layout(); if (reduce) draw(99); }, 150); });

    let t0 = 0, running = false, visible = true, paused = 0, pausedAt = 0;
    const frame = (now: number) => {
      if (!running) return;
      if (!document.querySelector('dialog[open]')) draw((now - t0 - paused) / 1000);
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (reduce || !data || running || !visible) return;
      if (pausedAt) { paused += performance.now() - pausedAt; pausedAt = 0; }
      running = true; requestAnimationFrame(frame);
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) start(); else if (running) { running = false; pausedAt = performance.now(); }
    }).observe(hero);

    (async () => {
      try {
        const file = import.meta.env.PUBLIC_BRAIN_FILE || 'brain/hcp-mni152.bin';
        data = await loadBrain(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${file}`);
        const made = createRenderer(glc, data); renderer = made.renderer; glc = made.canvas;
        layout();
        if (document.fonts?.ready) await document.fonts.ready;
        t0 = performance.now();
        if (reduce) draw(99); else start();
      } catch { /* 데이터를 못 받으면 글만 보여요 */ }
    })();
  }
</script>
