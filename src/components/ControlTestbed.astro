---
// 05 Control 페이지: 파킨슨병은 가까운 시험대. 내가 만든 임상 시스템이 아님을 분명히 해요.
import Status from './Status.astro';
---
<div class="testbed">
  <div class="tb-top"><span class="mono">Translational testbed</span><Status kind="question" /></div>
  <p class="tb-name">Parkinson’s disease</p>
  <dl>
    <div><dt class="mono">Signal</dt><dd>β bursts in subthalamic LFP, 13–30 Hz</dd></div>
    <div><dt class="mono">Today</dt><dd>Adaptive DBS that adjusts to brain signals was approved by the FDA in 2025.</dd></div>
    <div><dt class="mono">Open</dt><dd>How fast can it be personalized, and with how little sensing?</dd></div>
  </dl>
  <p class="tb-not mono">I have not built a clinical adaptive DBS system.</p>
</div>

<style>
  .testbed { --acc: #a8c8ff; border: 1px dashed #3a4a5e; padding: clamp(16px, 2vw, 24px); background: #04070b; }
  .tb-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tb-top > .mono { color: #7d7d7d; letter-spacing: 0.12em; text-transform: uppercase; }
  .tb-name { margin: 14px 0 0; font-size: 22px; color: #fff; }
  dl { margin: 14px 0 0; border-top: 1px solid #1f1f1f; }
  dl div { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid #161616; }
  dt { color: #7d7d7d; letter-spacing: 0.1em; text-transform: uppercase; padding-top: 2px; }
  dd { margin: 0; color: #d6d6d6; font-size: 15px; line-height: 1.5; }
  .tb-not { margin: 12px 0 0; color: #8a8a8a; }
  @media (max-width: 760px) { dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
