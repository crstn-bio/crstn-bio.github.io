---
// 04 · Evidence: 실제로 한 일만, 그 일이 받치는 단계 옆에. 누르면 방법 상세 창.
// 아래 띠: 만들기 경로 (Build 01 물리 제어 → Build 02 신경 제어 → 사람 데이터 닫힌 고리).
import Status from './Status.astro';
import ProjectDialogs from './ProjectDialogs.astro';
import { projects, buildPath } from '../data/projects';
---
<section class="builds section" id="work" aria-labelledby="build-h">
  <div class="wrap">
    <div class="build-head">
      <div><p class="mono kicker">04 / Evidence</p><h2 id="build-h">Capabilities so far.</h2></div>
      <p>What I have actually done, next to the stage it supports.</p>
    </div>

    <ol class="plist">
      {projects.map((x) => (
        <li>
          <button type="button" class="row" data-open={x.id} aria-haspopup="dialog">
            <span class="p-meta mono"><span class="p-cap">{x.cap}</span><span class="p-stage">Stage {x.stage}</span></span>
            <span class="p-main">
              <span class="p-top"><span class="p-title">{x.title}</span><Status kind={x.status} text={x.statusText} /></span>
              <span class="p-line">{x.line}</span>
            </span>
            <span class="p-open mono" aria-hidden="true">Method →</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="path" aria-label="Build path">
      <p class="path-k mono">Build path</p>
      <ol>
        {buildPath.map((b) => (
          <li>
            <span class="b-top"><span class="b-tag mono">{b.tag}</span><Status kind={b.status} text={b.statusText} /></span>
            <span class="b-name">{b.name}</span>
            <span class="b-chain mono">{b.chain.join(' → ')}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <ProjectDialogs />
</section>

<style>
  .builds { --acc: #a8c8ff; background: #000; color: #fff; border-top: 1px solid #1f1f1f; }
  .build-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 30px; align-items: end; margin-bottom: clamp(28px, 4vw, 44px); }
  .kicker { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #8d8d8d; margin: 0 0 14px; }
  .build-head h2 { font-size: clamp(32px, 4.2vw, 56px); font-weight: 300; letter-spacing: -.035em; margin: 0; }
  .build-head > p { color: #a9a9a9; font-size: 17px; max-width: 44ch; margin: 0; line-height: 1.65; }

  .plist { list-style: none; margin: 0; padding: 0; border-top: 1px solid #262626; }
  .row { all: unset; box-sizing: border-box; width: 100%; cursor: pointer; display: grid; grid-template-columns: 210px minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; padding: 16px 0; border-bottom: 1px solid #1c1c1c; }
  .row:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .p-meta { display: grid; gap: 4px; }
  .p-cap { color: #e6e6e6; letter-spacing: .1em; text-transform: uppercase; }
  .p-stage { color: #6a6a6a; }
  .p-main { display: grid; gap: 4px; }
  .p-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .p-title { font-size: clamp(17px, 1.6vw, 20px); font-weight: 400; letter-spacing: -0.015em; }
  .p-line { color: #9a9a9a; font-size: 15px; line-height: 1.5; }
  .p-open { color: #8d8d8d; letter-spacing: .08em; text-transform: uppercase; border: 1px solid #333; padding: 8px 12px; transition: color .2s, border-color .2s; }
  .row:hover .p-open, .row:focus-visible .p-open { color: var(--acc); border-color: var(--acc); }
  .row:hover .p-title { color: var(--acc); }

  .path { margin-top: clamp(28px, 4vw, 44px); }
  .path-k { margin: 0 0 12px; color: #6a6a6a; letter-spacing: .14em; text-transform: uppercase; }
  .path ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
  .path li { display: grid; gap: 8px; align-content: start; padding: 16px 18px; border: 1px solid #262626; position: relative; }
  .path li + li { border-left: 0; }
  .path li:not(:first-child) { border-style: dashed; border-color: #3a4a5e; }
  .path li + li::before { content: '→'; position: absolute; left: -9px; top: 16px; color: #5a5a5a; background: #000; line-height: 1; }
  .b-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
  .b-tag { color: #8d8d8d; letter-spacing: .12em; text-transform: uppercase; }
  .b-name { font-size: 18px; letter-spacing: -0.01em; }
  .b-chain { color: var(--acc); line-height: 1.6; }

  @media (max-width: 900px) {
    .build-head { grid-template-columns: 1fr; }
    .row { grid-template-columns: minmax(0, 1fr); }
    .p-meta { grid-auto-flow: column; justify-content: start; gap: 12px; }
    .p-open { justify-self: start; }
    .path ol { grid-template-columns: 1fr; }
    .path li + li { border-left: 1px dashed #3a4a5e; border-top: 0; }
    .path li + li::before { content: '↓'; left: 18px; top: -9px; }
  }
</style>
