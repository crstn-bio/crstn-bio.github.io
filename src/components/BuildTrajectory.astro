---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  {n:'01',cat:'INTERVENTION',title:'a-tbTUS + FES',sub:'Human neuromodulation · honours thesis',kind:'brain',status:'ACTIVE / UHN'},
  {n:'02',cat:'NEURAL SIGNALS',title:'Human DBS electrophysiology',sub:'Signal processing closer to the target system',kind:'signal',status:'PYTHON / ANALYSIS'},
  {n:'03',cat:'CONTROL',title:'Motion-controlled pan–tilt',sub:'IMU → orientation → microcontroller → servo',kind:'control',status:'BUILT'},
  {n:'04',cat:'MODELLING',title:'Plasma biomarkers → amyloid PET',sub:'Participant-grouped CV · bootstrap inference',kind:'model',status:'R / ADNI'},
  {n:'05',cat:'SPECTRA',title:'EEG / EMG state analysis',sub:'FFT · PSD · behavioral neuroscience',kind:'spectra',status:'PYTHON / MATLAB'},
];
---
<section class="builds section" id="work" aria-labelledby="build-h">
  <div class="wrap">
    <div class="build-head">
      <div><p class="mono kicker">03 / Build-up</p><h2 id="build-h">Building the pieces.</h2></div>
      <p>What I have built so far, and how each piece feeds the loop: intervention, signals, control, modelling.</p>
    </div>
    <div class="build-grid">
      {items.map((x)=><article class={`build ${x.kind}`}>
        <div class="viz" aria-hidden="true">
          {x.kind==='brain' && <><div class="mini-brain"></div><span class="target"></span><span class="waves"></span></>}
          {x.kind==='signal' && <svg viewBox="0 0 240 90"><path d="M0 49 L12 48 18 45 23 60 28 20 33 67 39 38 45 50 59 47 67 44 72 57 77 28 82 65 88 39 96 49 112 48 120 46 126 56 132 25 138 63 144 41 153 49 168 48 178 43 185 60 191 23 197 64 203 39 212 49 240 48"/></svg>}
          {x.kind==='control' && <img class="photo" src={`${base}/builds/imu-pan-tilt/hand-control.jpg`} alt="A hand tilts a small IMU while the 3D-printed two-servo mount follows, wired to an Elegoo UNO R3." loading="lazy" />}
          {x.kind==='model' && <svg viewBox="0 0 240 100"><path class="axis" d="M20 82H225M20 82V10"/><path d="M20 80 C45 76,55 62,78 52 S125 30,220 18"/><path class="dash" d="M20 80 C55 78,70 68,95 54 S145 25,220 14"/></svg>}
          {x.kind==='spectra' && <svg viewBox="0 0 240 100"><path class="axis" d="M20 82H225M20 82V10"/><path d="M20 80 C35 77,40 24,52 18 S66 67,78 73 100 61,112 54 128 72,145 75 170 70,190 76 210 78,225 79"/></svg>}
        </div>
        <div class="meta mono"><span>{x.n} / {x.cat}</span><span>{x.status}</span></div>
        <h3>{x.title}</h3><p>{x.sub}</p>
      </article>)}
    </div>
    <p class="trajectory mono"><span>HUMAN RESPONSE</span> → <span>NEURAL SIGNAL</span> → <span>PHYSICAL CONTROL</span> → <span>PREDICTION</span> → <strong>PATIENT-SPECIFIC CLOSED LOOP</strong></p>
  </div>
</section>
<style>
.builds{background:#000;color:#fff;border-top:1px solid #1f1f1f}.build-head{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:end;margin-bottom:36px}.kicker{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#8d8d8d;margin:0 0 14px}.build-head h2{font-size:clamp(32px,4.2vw,56px);font-weight:300;letter-spacing:-.035em;margin:0}.build-head>p{color:#a9a9a9;font-size:17px;max-width:46ch;margin:0;line-height:1.65}.build-grid{display:grid;grid-template-columns:repeat(12,1fr);border-top:1px solid #242424;border-left:1px solid #242424}.build{grid-column:span 4;min-height:300px;padding:14px 16px 18px;border-right:1px solid #242424;border-bottom:1px solid #242424;background:#050505}.build:nth-child(4),.build:nth-child(5){grid-column:span 6}.viz .photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.05);opacity:.9;transition:filter .4s}.build:hover .viz .photo{filter:none}.viz{height:150px;position:relative;overflow:hidden;border-bottom:1px solid #191919;margin-bottom:13px;background-image:linear-gradient(#101010 1px,transparent 1px),linear-gradient(90deg,#101010 1px,transparent 1px);background-size:24px 24px}.meta{display:flex;justify-content:space-between;gap:10px;color:#8d8d8d;font-size:12px;letter-spacing:.06em}.build h3{font-size:18px;font-weight:430;margin:12px 0 6px}.build p{font-size:14.5px;color:#9a9a9a;margin:0;line-height:1.55}.viz svg{width:100%;height:100%}.viz path{fill:none;stroke:#e6e6e6;stroke-width:1.3}.viz .axis{stroke:#353535}.viz .dash{stroke:#6f6f6f;stroke-dasharray:4 4}.mini-brain{position:absolute;width:130px;height:92px;left:50%;top:26px;transform:translateX(-50%);border:1px solid #555;border-radius:53% 47% 45% 55%;box-shadow:inset 0 0 30px #161616}.target{position:absolute;width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 14px rgba(255,255,255,.6);left:54%;top:62px}.waves{position:absolute;width:54px;height:54px;border:1px solid #fff;border-radius:50%;left:calc(54% - 23px);top:39px;opacity:.3}.servo{position:absolute;border:1px solid #777;background:#151515}.pan{width:58px;height:30px;left:50%;bottom:26px;transform:translateX(-50%)}.tilt{width:30px;height:48px;left:50%;bottom:55px;transform:translateX(-50%)}.arm{position:absolute;width:70px;height:1px;background:#8ec5ff;left:50%;bottom:78px;transform-origin:left;transform:rotate(-30deg)}.imu{position:absolute;left:22px;top:24px;border:1px solid #3c5369;color:#8ec5ff;padding:5px;font:9px var(--mono)}.trajectory{margin:24px 0 0;color:#6a6a6a;font-size:12px;letter-spacing:.08em;text-transform:uppercase}.trajectory strong{color:#a8c8ff;font-weight:500}.trajectory span{color:#92928d}@media(max-width:820px){.build-head{grid-template-columns:1fr}.build{grid-column:span 6!important;min-height:250px}.build:last-child{grid-column:span 12!important}.viz{height:120px}.trajectory{line-height:2}}@media(max-width:520px){.build{grid-column:span 12!important}.build-head h2{font-size:32px}}
</style>
