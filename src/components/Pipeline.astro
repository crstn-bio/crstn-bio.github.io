  svg .acc { fill: none; stroke: var(--acc); stroke-width: 1.4; }
  svg .acc-f { fill: var(--acc); }
  svg .w-f { fill: #d6d6d6; }
  svg .hollow { fill: #050505; stroke: #666; }
