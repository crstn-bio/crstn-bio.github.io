  .cap { display: grid; gap: 3px; margin-top: auto; padding-top: 10px; }
  .cap b { font-weight: 450; font-size: 14.5px; color: #f2f2f2; letter-spacing: -0.01em; }
  .cap .mono { font-size: 12px; color: #8d8d8d; }

  svg .ln { fill: none; stroke: #d6d6d6; stroke-width: 1.3; }
  svg .ln.thin { stroke-width: 1; }
  svg .dim { fill: none; stroke: #474747; stroke-width: 1; }
