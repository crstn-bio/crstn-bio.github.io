---
// 해독(decode) → 부호화(encode) 폐루프 파이프라인
// 네 개의 캔버스가 하나의 시뮬레이션 시계를 공유해요.
// 모드 1 (dbs): 병적 상태를 감지하면 자극 세기를 올리고, 상태가 돌아오면 내림
// 모드 2 (memory): 해독한 표상을 저장된 패턴과 비교해 차이만큼 패턴 자극을 줌 (추측성 확장)
const cols = [
  {
    key: 'record', n: '01', name: 'Record',
    dbs: 'Local field potentials from the DBS lead in the subthalamic nucleus.',
    memory: 'Activity across hippocampal and distributed memory circuits.',
  },
  {
    key: 'decode', n: '02', name: 'Decode',
    dbs: 'A patient-specific model estimates brain state and flags pathological activity, such as elevated beta-band power.',
    memory: 'A decoder estimates memory-related representations and compares them with the pattern that should be there.',
  },
  {
    key: 'encode', n: '03', name: 'Encode',
    dbs: 'The estimate sets stimulation: more when the state is pathological, less or none when it is not.',
    memory: 'The gap between the decoded and intended pattern becomes a map of where to stimulate.',
  },
  {
    key: 'stim', n: '04', name: 'Stimulate',
    dbs: 'Stimulation is delivered, and its effect shows up in the next recording.',
    memory: 'Patterned stimulation writes the pattern back, aiming to reconstruct disrupted memory function.',
  },
];
---
<div class="pipe" data-mode="dbs">
  <div class="pipe-head">
    <div>
      <h3>Decode, then encode</h3>
      <div class="pipe-toggle" role="group" aria-label="Application">
        <button type="button" data-set="dbs" aria-pressed="true">Step one: closed-loop DBS</button>
        <button type="button" data-set="memory" aria-pressed="false">Later: memory circuits</button>
      </div>
    </div>
    <p>My interest is in whether we can build closed-loop systems that continuously interpret a patient’s changing brain state, identify pathological states, and adapt stimulation accordingly. Closed-loop DBS for Parkinson’s disease is the first step. Pointed at memory circuits, the same loop could decode memory-related representations and encode them back.</p>
  </div>

  <ol class="pipe-cols">
    {cols.map((c) => (
      <li>
        <header><span class="mono">{c.n}</span><h4>{c.name}</h4></header>
        <canvas data-pipe={c.key} aria-hidden="true"></canvas>
        <p><span data-show="dbs">{c.dbs}</span><span data-show="memory">{c.memory}</span></p>
      </li>
    ))}
  </ol>
  <div class="pipe-return" aria-hidden="true"><span class="mono">the next recording measures the effect</span></div>
  <p class="pipe-note mono">Simulated signals, not recorded data. <span data-show="memory">The memory view is a speculative extension, not an existing method.</span></p>
</div>

<style>
  .pipe { margin-top: clamp(24px, 4vw, 48px); padding-bottom: clamp(56px, 9vw, 120px); }
  .pipe-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 20px var(--gutter); align-items: end; }
  .pipe-head h3 { font-size: clamp(26px, 3vw, 38px); font-weight: 400; letter-spacing: -0.02em; margin-bottom: 22px; }
  .pipe-head > p { color: #b5b5b5; font-size: 17px; line-height: 1.7; max-width: 56ch; margin: 0; }

  .pipe-toggle { display: inline-flex; flex-wrap: wrap; border: 1px solid #333; padding: 3px; }
  .pipe-toggle button {
    font: inherit; font-size: 13.5px; color: #8d8d8d; background: transparent; border: 0; padding: 9px 14px; cursor: pointer;
  }
  .pipe-toggle button[aria-pressed='true'] { background: #fff; color: #000; }
  .pipe-toggle button[aria-pressed='false']:hover { color: #fff; }

  .pipe-cols { list-style: none; margin: clamp(28px, 4vw, 44px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .pipe-cols li { position: relative; border: 1px solid #1f1f1f; background: #030303; display: flex; flex-direction: column; }
  .pipe-cols li:not(:last-child)::after {
    content: ''; position: absolute; right: -15px; top: calc(46px + (100% - 46px) * 0.36); width: 9px; height: 9px;
    border-top: 1px solid #fff; border-right: 1px solid #fff; transform: rotate(45deg);
  }
  .pipe-cols header { display: flex; align-items: baseline; gap: 12px; padding: 14px 16px 12px; }
  .pipe-cols header .mono { color: #8d8d8d; }
  .pipe-cols h4 { margin: 0; font-size: 16px; font-weight: 500; }
  .pipe-cols canvas { display: block; width: 100%; aspect-ratio: 5 / 4; border-block: 1px solid #1f1f1f; }
  .pipe-cols p { margin: 0; padding: 14px 16px 18px; color: #8d8d8d; font-size: 14px; line-height: 1.55; }

  .pipe-return {
    position: relative; height: 40px; margin: 0 12.5%;
    border: 1px solid #555; border-top: 0;
    display: flex; justify-content: center; align-items: flex-end;
  }
  .pipe-return::before {
    content: ''; position: absolute; left: -5px; top: -1px; width: 9px; height: 9px;
    border-top: 1px solid #fff; border-left: 1px solid #fff; transform: rotate(45deg);
  }
  .pipe-return span { background: #000; color: #8d8d8d; padding: 0 12px; transform: translateY(50%); }
  .pipe-note { color: #5a5a5a; margin: 30px 0 0; }

  .pipe[data-mode='dbs'] [data-show='memory'],
  .pipe[data-mode='memory'] [data-show='dbs'] { display: none; }

  @media (max-width: 1000px) {
    .pipe-head { grid-template-columns: 1fr; }
    .pipe-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pipe-cols li::after, .pipe-return { display: none; }
    .pipe-note::before { content: '04 loops back to 01. '; color: #8d8d8d; }
  }
  @media (max-width: 600px) {
    .pipe-cols { grid-template-columns: 1fr; }
    .pipe-cols canvas { aspect-ratio: 16 / 11; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.pipe');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MONO = '10.5px "Geist Mono Variable", ui-monospace, monospace';
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const sstep = (v: number) => { v = clamp01(v); return v * v * (3 - 2 * v); };
    const hash = (n: number) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };
    type Mode = 'dbs' | 'memory';
    let mode: Mode = 'dbs';

    // ── 캔버스 ──
    type Pane = { el: HTMLCanvasElement; ctx: CanvasRenderingContext2D; w: number; h: number };
    const panes: Record<string, Pane> = {};
    root.querySelectorAll<HTMLCanvasElement>('canvas[data-pipe]').forEach((el) => {
      panes[el.dataset.pipe!] = { el, ctx: el.getContext('2d')!, w: 0, h: 0 };
    });
    function size() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      for (const p of Object.values(panes)) {
        const r = p.el.getBoundingClientRect();
        p.w = r.width; p.h = r.height;
        p.el.width = Math.round(p.w * dpr); p.el.height = Math.round(p.h * dpr);
        p.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
    }

    // ── 시뮬레이션 ──
    const C = 12;                         // 한 주기 (초)
    const HZ = 60, HN = HZ * 9;           // 9초 기록
    const H = { p: new Float32Array(HN), ph: new Float32Array(HN), A: new Float32Array(HN), s: new Float32Array(HN) };
    let head = 0, simT = 0, acc = 0, lastK = 0;
    let p = 0.2, ph = 0.2, A = 0;         // DBS: 상태, 추정치, 자극 세기
    let s = 0.35;                         // 기억: 저장된 패턴과의 일치도 (A는 자극 세기로 공용)
    const THR = 0.6;

    const target: number[] = [];          // 저장된 8×8 패턴
    for (let i = 0; i < 64; i++) target.push(hash(i * 7.3 + 1.1) < 0.42 ? 1 : 0);

    const at = (arr: Float32Array, ago: number) => {
      const n = Math.min(HN - 1, Math.max(0, Math.round(ago * HZ)));
      return arr[(head - 1 - n + HN * 2) % HN];
    };
    function push() { H.p[head] = p; H.ph[head] = ph; H.A[head] = A; H.s[head] = s; head = (head + 1) % HN; }

    function step(dt: number) {
      const h = 1 / 120;
      for (let n = Math.max(1, Math.round(dt / h)); n > 0; n--) {
        simT += h;
        const k = ((simT % C) + C) % C;
        if (mode === 'dbs') {
          // 병적 활동을 일으키는 구동 (1.5초~6.5초)
          const drive = 0.9 * sstep((k - 1.5) / 0.4) * (1 - sstep((k - 6.5) / 0.4));
          p = clamp01(p + (0.07 + drive - p * (0.35 + 2.4 * A)) * h);
          ph += (p - ph + (hash(simT * 50) - 0.5) * 0.03) * (h / 0.25);
          const want = clamp01((ph - 0.38) / 0.25);   // 추정치에 비례하는 자극
          A += (want - A) * (h / 0.8);
        } else {
          if (k < lastK) s = 0.35;                    // 새 주기: 다시 흐트러진 상태
          const on = k > 1.5 && k < 9;
          const want = on ? clamp01((0.9 - s) / 0.25) : 0;
          A += (want - A) * (h / 0.6);
          s += (A * 0.55 * (0.95 - s) - 0.02 * (s - 0.35)) * h;
          p = 1 - s; ph = p;
        }
        lastK = k;
        acc += h;
        while (acc >= 1 / HZ) { acc -= 1 / HZ; push(); }
      }
    }

    function reset() {
      simT = C - 7; acc = 0; head = 0; lastK = simT % C;
      p = 0.2; ph = 0.2; A = 0; s = 0.9;
      for (const a of Object.values(H)) a.fill(mode === 'dbs' ? 0.2 : 0);
      step(7);                                         // 기록이 꽉 차도록 미리 돌림
    }

    // ── 그리기 도우미 ──
    const txt = (c: CanvasRenderingContext2D, s: string, x: number, y: number, col = 'rgba(255,255,255,0.45)', align: CanvasTextAlign = 'left') => {
      c.font = MONO; c.fillStyle = col; c.textAlign = align; c.textBaseline = 'top'; c.fillText(s, x, y);
    };
    const PX = 64;                                     // 흐르는 그래프 속도 (px/초)

    function drawRecord(P: Pane) {
      const { ctx: c, w, h } = P;
      c.clearRect(0, 0, w, h);
      txt(c, mode === 'dbs' ? 'LFP  STN' : 'LFP  HPC + CORTEX', 12, 10);
      txt(c, '10 ch', w - 12, 10, 'rgba(255,255,255,0.45)', 'right');
      const top = 30, rows = 10, rh = (h - top - 10) / rows;
      c.strokeStyle = 'rgba(255,255,255,0.78)'; c.lineWidth = 1;
      for (let ch = 0; ch < rows; ch++) {
        const y0 = top + rh * (ch + 0.5);
        c.beginPath();
        for (let x = 0; x <= w; x += 1) {
          const ago = (w - x) / PX, tau = simT - ago;
          const pv = at(H.p, ago);
          let v: number;
          if (mode === 'dbs') {
            const beta = Math.sin(2 * Math.PI * 5 * tau + ch * 1.3) * (0.12 + 0.95 * pv);
            v = beta * 0.7 + (hash(Math.floor(tau * 80) * 31 + ch * 7) - 0.5) * 0.55;
          } else {
            const sv = at(H.s, ago);
            const theta = Math.sin(2 * Math.PI * 1.6 * tau + ch * 0.4);
            const gamma = Math.sin(2 * Math.PI * 11 * tau + ch) * (0.5 + 0.5 * theta) * sv;
            v = theta * 0.45 * sv + gamma * 0.45 + (hash(Math.floor(tau * 80) * 31 + ch * 7) - 0.5) * (0.9 - 0.6 * sv);
          }
          if (hash(Math.floor(tau * 30) + ch * 101) > 0.986) v -= 1.3;   // 스파이크
          const y = y0 + v * rh * 0.34;
          x ? c.lineTo(x, y) : c.moveTo(x, y);
        }
        c.stroke();
      }
    }

    function drawDecode(P: Pane) {
      const { ctx: c, w, h } = P;
      c.clearRect(0, 0, w, h);
      if (mode === 'dbs') {
        const x0 = 14, y0 = 30, pw = w - 28, phh = h - 84;
        txt(c, 'STATE SPACE', 12, 10);
        c.strokeStyle = 'rgba(255,255,255,0.12)'; c.setLineDash([2, 4]);
        c.strokeRect(x0 + 0.5, y0 + 0.5, pw - 1, phh - 1); c.setLineDash([]);
        const N = [0.28, 0.68], Pt = [0.72, 0.32];
        const r = Math.min(pw, phh) * 0.2;
        c.strokeStyle = 'rgba(255,255,255,0.55)'; c.setLineDash([3, 3]);
        c.beginPath(); c.arc(x0 + Pt[0] * pw, y0 + Pt[1] * phh, r, 0, 6.2832); c.stroke(); c.setLineDash([]);
        txt(c, 'pathological', x0 + Pt[0] * pw, y0 + Pt[1] * phh - r - 14, 'rgba(255,255,255,0.55)', 'center');
        const pos = (pv: number, tau: number): [number, number] => {
          const u = clamp01((pv - 0.2) / 0.55);
          const wx = Math.sin(tau * 1.7) * 0.05 + Math.sin(tau * 3.1 + 1) * 0.03;
          const wy = Math.cos(tau * 1.3) * 0.05 + Math.sin(tau * 2.3) * 0.03;
          return [x0 + (N[0] + (Pt[0] - N[0]) * u + wx) * pw, y0 + (N[1] + (Pt[1] - N[1]) * u + wy) * phh];
        };
        c.lineWidth = 1;
        for (let ago = 2.4; ago > 0; ago -= 1 / 30) {
          const [xa, ya] = pos(at(H.ph, ago), simT - ago), [xb, yb] = pos(at(H.ph, ago - 1 / 30), simT - ago + 1 / 30);
          c.strokeStyle = `rgba(255,255,255,${(0.6 * (1 - ago / 2.4)).toFixed(3)})`;
          c.beginPath(); c.moveTo(xa, ya); c.lineTo(xb, yb); c.stroke();
        }
        const [dx, dy] = pos(ph, simT);
        c.fillStyle = '#fff'; c.beginPath(); c.arc(dx, dy, 3.5, 0, 6.2832); c.fill();
        c.strokeStyle = 'rgba(255,255,255,0.4)'; c.beginPath(); c.arc(dx, dy, 8, 0, 6.2832); c.stroke();
        // 추정치 막대
        const by = h - 40;
        txt(c, 'STATE ESTIMATE', 14, by - 16);
        const flag = ph > THR ? 'DETECTED' : A > 0.15 ? 'CONTROLLED' : 'NORMAL';
        txt(c, flag, w - 14, by - 16, flag === 'DETECTED' ? '#fff' : 'rgba(255,255,255,0.6)', 'right');
        c.fillStyle = 'rgba(255,255,255,0.12)'; c.fillRect(14, by, w - 28, 6);
        c.fillStyle = '#fff'; c.fillRect(14, by, (w - 28) * clamp01(ph), 6);
        const tx = 14 + (w - 28) * THR;
        c.fillRect(tx - 0.5, by - 5, 1, 16);
        txt(c, 'threshold', tx, by + 14, 'rgba(255,255,255,0.4)', 'center');
      } else {
        txt(c, 'DECODED vs STORED', 12, 10);
        const g = Math.min(w - 40, h - 88), cell = g / 8, gx = (w - g) / 2, gy = 32;
        const slot = Math.floor(simT * 3);
        for (let i = 0; i < 64; i++) {
          const r = Math.floor(i / 8), col = i % 8;
          const noise = hash(i * 3.1 + slot * 17.7);
          const q = target[i] ? s + (1 - s) * noise * 0.9 : (1 - s) * noise * 0.75;
          c.fillStyle = `rgba(255,255,255,${(0.08 + 0.85 * q).toFixed(3)})`;
          c.fillRect(gx + col * cell + 2, gy + r * cell + 2, cell - 4, cell - 4);
          if (target[i]) { c.strokeStyle = 'rgba(255,255,255,0.55)'; c.lineWidth = 1; c.strokeRect(gx + col * cell + 0.5, gy + r * cell + 0.5, cell - 1, cell - 1); }
        }
        txt(c, 'MATCH TO STORED PATTERN', 14, h - 44);
        txt(c, `${Math.round(s * 100)}%`, w - 14, h - 44, '#fff', 'right');
        c.fillStyle = 'rgba(255,255,255,0.12)'; c.fillRect(14, h - 26, w - 28, 6);
        c.fillStyle = '#fff'; c.fillRect(14, h - 26, (w - 28) * s, 6);
      }
    }

    function drawEncode(P: Pane) {
      const { ctx: c, w, h } = P;
      c.clearRect(0, 0, w, h);
      if (mode === 'dbs') {
        txt(c, 'AMPLITUDE', 12, 10, '#fff');
        txt(c, '- - state', w - 12, 10, 'rgba(255,255,255,0.45)', 'right');
        const x0 = 14, y0 = 32, pw = w - 28, phh = h - 84;
        c.strokeStyle = 'rgba(255,255,255,0.1)'; c.lineWidth = 1;
        for (const g of [0, 0.5, 1]) { const y = y0 + phh * (1 - g) + 0.5; c.beginPath(); c.moveTo(x0, y); c.lineTo(x0 + pw, y); c.stroke(); }
        const series = (arr: Float32Array) => {
          c.beginPath();
          for (let x = 0; x <= pw; x += 2) { const y = y0 + phh * (1 - at(arr, (pw - x) / PX)); x ? c.lineTo(x0 + x, y) : c.moveTo(x0 + x, y); }
        };
        c.setLineDash([3, 3]); c.strokeStyle = 'rgba(255,255,255,0.4)'; series(H.ph); c.stroke(); c.setLineDash([]);
        series(H.A); c.lineTo(x0 + pw, y0 + phh); c.lineTo(x0, y0 + phh); c.closePath();
        c.fillStyle = 'rgba(255,255,255,0.08)'; c.fill();
        c.strokeStyle = '#fff'; c.lineWidth = 1.3; series(H.A); c.stroke();
        txt(c, 'OUTPUT', 14, h - 44); txt(c, `${A.toFixed(2)}  normalized`, w - 14, h - 44, '#fff', 'right');
        txt(c, 'RULE', 14, h - 26); txt(c, 'rises with the estimate', w - 14, h - 26, 'rgba(255,255,255,0.7)', 'right');
      } else {
        txt(c, 'STIMULATION MAP', 12, 10);
        const g = Math.min(w - 40, h - 88), cell = g / 8, gx = (w - g) / 2, gy = 32;
        let active = 0;
        for (let i = 0; i < 64; i++) {
          const r = Math.floor(i / 8), col = i % 8;
          const e = target[i] ? clamp01((1 - s) * (0.6 + 0.8 * hash(i * 5.3))) * A : 0;
          if (e > 0.15) active++;
          c.strokeStyle = 'rgba(255,255,255,0.1)'; c.lineWidth = 1;
          c.strokeRect(gx + col * cell + 0.5, gy + r * cell + 0.5, cell - 1, cell - 1);
          if (e > 0.02) {
            c.fillStyle = `rgba(255,255,255,${Math.min(1, e * 1.4).toFixed(3)})`;
            const m = (cell - 4) * (0.35 + 0.65 * Math.min(1, e * 1.4));
            c.fillRect(gx + col * cell + (cell - m) / 2, gy + r * cell + (cell - m) / 2, m, m);
          }
        }
        txt(c, 'SITES ACTIVE', 14, h - 44); txt(c, String(active), w - 14, h - 44, '#fff', 'right');
        txt(c, 'RULE', 14, h - 26); txt(c, 'stored minus decoded', w - 14, h - 26, 'rgba(255,255,255,0.7)', 'right');
      }
    }

    function drawStim(P: Pane) {
      const { ctx: c, w, h } = P;
      c.clearRect(0, 0, w, h);
      const trend = A - at(H.A, 0.4);
      const state = A < 0.04 ? 'OFF' : trend > 0.02 ? 'RAMPING UP' : trend < -0.02 ? 'RAMPING DOWN' : 'HOLDING';
      txt(c, mode === 'dbs' ? 'PULSE TRAIN  STN' : 'PATTERNED  8 CH', 12, 10);
      txt(c, state, w - 12, 10, state === 'OFF' ? 'rgba(255,255,255,0.45)' : '#fff', 'right');
      const rows = mode === 'dbs' ? 1 : 8;
      const top = 34, bottom = h - 16, rh = (bottom - top) / rows;
      const gap = mode === 'dbs' ? 6 : 9;
      for (let r = 0; r < rows; r++) {
        const base = mode === 'dbs' ? top + rh * 0.62 : top + rh * (r + 0.78);
        const amp = mode === 'dbs' ? rh * 0.5 : rh * 0.7;
        const rowW = mode === 'dbs' ? 1 : target.slice(r * 8, r * 8 + 8).reduce((a, b) => a + b, 0) / 4;
        c.strokeStyle = 'rgba(255,255,255,0.25)'; c.lineWidth = 1;
        c.beginPath(); c.moveTo(0, base + 0.5); c.lineTo(w, base + 0.5); c.stroke();
        c.strokeStyle = '#fff';
        c.beginPath();
        const first = Math.floor((simT - w / PX) * PX / gap);
        for (let k = first; k <= Math.floor(simT * PX / gap); k++) {
          const x = w - (simT - (k * gap) / PX) * PX;
          const a = at(H.A, (w - x) / PX) * Math.min(1, rowW) * (mode === 'dbs' ? 1 : (hash(k * 3 + r * 11) > 0.35 ? 1 : 0));
          if (a < 0.03) continue;
          c.moveTo(x, base); c.lineTo(x, base - amp * a); c.moveTo(x + 2, base); c.lineTo(x + 2, base + amp * a * 0.35);
        }
        c.stroke();
      }
    }

    function drawAll() {
      if (panes.record) drawRecord(panes.record);
      if (panes.decode) drawDecode(panes.decode);
      if (panes.encode) drawEncode(panes.encode);
      if (panes.stim) drawStim(panes.stim);
    }

    // ── 모드 전환 ──
    const buttons = root.querySelectorAll<HTMLButtonElement>('.pipe-toggle button');
    function setMode(m: Mode) {
      mode = m; root!.dataset.mode = m;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === m)));
      reset();
      if (reduce) { step(m === 'dbs' ? 3.2 : 4.5); drawAll(); }
    }
    buttons.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.set as Mode)));

    size();
    window.addEventListener('resize', () => { size(); if (reduce) drawAll(); });
    setMode('dbs');

    if (!reduce) {
      let running = false, prev = 0;
      const loop = (now: number) => {
        if (!running) return;
        const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
        step(dt); drawAll();
        requestAnimationFrame(loop);
      };
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; prev = performance.now(); requestAnimationFrame(loop); }
        else if (!e.isIntersecting) running = false;
      }).observe(root);
    }
  }
</script>
