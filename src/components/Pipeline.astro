---
// 방법론을 단계별 도식으로 (글자는 최소, 움직임으로 설명)
//   tus    a-tbTUS + FES 논문 연구
//   spikes 심부 뇌 미세전극 기록 → 스파이크 → 발화율 → 스펙트럼 (Python, NeuroTech 워크숍)
//   imu    IMU로 움직이는 팬·틸트 (Arduino)
//   adni   혈장 바이오마커 → 아밀로이드 PET 예측 (R, ADNI)
//   eeg    EEG / EMG 스펙트럼 분석
//   aidbs  (계획) 여러 환자로 미리 학습 → 한 환자에게 빠르게 맞춤 → 폐쇄루프 고빈도 DBS
//   engram (계획) Neuropixels로 기록 → 엔그램 세포 집단 해독 → 재생 → 그 세포만 다시 활성화
//   goal   (궁극) 여러 척도의 신호 → 한 사람의 뇌 모델 → 증상 전에 변화 예측
// 파형·점·곡선은 코드로 만든 도식이에요. 숫자로 적힌 값(필터 대역, 임계값, 표본 수, AUC 등)만 실제 분석 값이에요.
type Kind = 'tus' | 'spikes' | 'imu' | 'adni' | 'eeg' | 'aidbs' | 'engram' | 'goal';
interface Props { kind: Kind; label: string }
const { kind, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 재현 가능한 난수
let seed = { tus: 3, spikes: 11, imu: 5, adni: 29, eeg: 17, aidbs: 41, engram: 53, goal: 61 }[kind];
const rnd = () => ((seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0) / 4294967296);
const f1 = (v: number) => v.toFixed(1);
const line = (xs: number[], fy: (x: number) => number) => 'M' + xs.map((x) => `${f1(x)} ${f1(fy(x))}`).join(' L');
const range = (a: number, b: number, s = 1) => Array.from({ length: Math.floor((b - a) / s) + 1 }, (_, i) => a + i * s);

// ── spikes ──
const P = 200;                                              // 한 주기 폭 (두 주기를 이어 붙여 끊김 없이 흘려보냄)
const noise = Array.from({ length: P }, () => rnd() * 2 - 1);
const spikes = [16, 43, 58, 92, 117, 141, 172];
const spikeAt = (x: number) => {
  let v = 0;
  for (const s of spikes) { const d = x - s; v += d === -1 ? -5 : d === 0 ? -24 : d === 1 ? 9 : d === 2 ? 3 : 0; }
  return v;
};
const wander = (x: number) => 9 * Math.sin((2 * Math.PI * x) / P) + 4 * Math.sin((6 * Math.PI * x) / P + 1.3);
const trace = (fn: (x: number) => number, y0: number) => line(range(0, 2 * P), (x) => y0 - fn(x % P));
const rawPath = trace((x) => wander(x) + 3 * noise[x] + spikeAt(x), 70);
const filtPath = trace((x) => 2 * noise[x] + spikeAt(x), 86);
const filtPath2 = trace((x) => 2 * noise[x] + spikeAt(x), 58);
const spikeMarks = [...spikes, ...spikes.map((s) => s + P)];

// 4차 버터워스 대역통과의 크기 응답 (로그 주파수 10 Hz–30 kHz)
const fx = (f: number) => 12 + ((Math.log10(f) - 1) / (Math.log10(30000) - 1)) * 176;
const bandPath = 'M' + range(0, 120).map((i) => {
  const f = 10 ** (1 + (i / 120) * (Math.log10(30000) - 1));
  const q = (f * f - 300 * 3000) / (f * 2700);
  return `${f1(fx(f))} ${f1(46 - 32 / Math.sqrt(1 + q ** 8))}`;
}).join(' L');

// 래스터: 8줄, 줄마다 발화 빈도가 다름
const raster = Array.from({ length: 8 }, (_, r) => {
  const rate = 0.05 + rnd() * 0.09;
  const xs: number[] = [];
  for (let x = 14 + rnd() * 10; x < 186; x += -Math.log(1 - rnd()) / rate) xs.push(x);
  return { y: 10 + r * 11, xs };
});
// 발화율: 모든 줄의 스파이크를 가우시안 커널로 부드럽게
const allTicks = raster.flatMap((r) => r.xs);
const ratePath = (() => {
  const xs = range(12, 188, 2);
  const vals = xs.map((x) => allTicks.reduce((s, t) => s + Math.exp(-((x - t) ** 2) / (2 * 6 * 6)), 0));
  const mx = Math.max(...vals);
  return 'M' + xs.map((x, i) => `${x} ${f1(92 - (vals[i] / mx) * 70)}`).join(' L');
})();
const kernelPath = line(range(16, 44), (x) => 110 - 9 * Math.exp(-((x - 30) ** 2) / 32));   // 가우시안 커널 모양
// 파워 스펙트럼 밀도: 1/f 형태 + 낮은 주파수 봉우리
const psdPath = 'M' + range(0, 100).map((i) => {
  const f = (i / 100) * 50;
  const p = 60 / (1 + (f / 3) ** 1.7) + 34 * Math.exp(-((f - 2.4) ** 2) / 0.5) + 5 * Math.exp(-((f - 7) ** 2) / 3);
  return `${f1(26 + i * 1.64)} ${f1(Math.max(12, 96 - p))}`;
}).join(' L');

// ── adni ──
// 혈장(위)과 PET(아래) 시점을 사람 안에서 1:1로 짝짓기 (≤ 365일). 마지막 혈장은 짝이 없음
const plasma = [22, 64, 108, 150, 186];
const pet = [34, 74, 100, 168];
const pairs: [number, number][] = [[22, 34], [64, 74], [108, 100], [150, 168]];
// 코호트: 관측 1,524건 → CU 863 / CI 661 (점 하나 ≈ 33건). 채운 점 = 아밀로이드 PET 양성 (CU 31%, CI 62%)
const CU = 26, CI = 20;
const posCU = new Set([1, 5, 9, 12, 16, 19, 22, 25]);          // 8 / 26 ≈ 31%
const posCI = new Set([0, 1, 3, 4, 6, 8, 9, 11, 13, 14, 16, 18]); // 12 / 20 = 60%
const order = Array.from({ length: CU + CI }, (_, i) => i).sort(() => rnd() - 0.5);
const cohort = Array.from({ length: CU + CI }, (_, i) => {
  const cu = i < CU, j = cu ? i : i - CU;
  const x1 = cu ? 16 + (j % 6) * 12 : 120 + (j % 5) * 12;
  const y1 = 30 + Math.floor(j / (cu ? 6 : 5)) * 13;
  const m = order[i];
  return { x0: 42 + (m % 10) * 12, y0: 30 + Math.floor(m / 10) * 13, x1, y1, cu, pos: cu ? posCU.has(j) : posCI.has(j) };
});
// 로지스틱 곡선 3개
const sig = (k: number, x0: number) => line(range(14, 186, 3), (x) => 96 - 70 / (1 + Math.exp(-k * (x - x0))));
const dots0 = Array.from({ length: 16 }, () => ({ x: 14 + rnd() * 110, y: 96 + (rnd() - 0.5) * 6 }));
const dots1 = Array.from({ length: 16 }, () => ({ x: 76 + rnd() * 110, y: 26 + (rnd() - 0.5) * 6 }));
// 교차검증: 5번 반복 × 5개 묶음, 줄마다 검증용 묶음 위치가 다름
const cvStart = [0, 2, 4, 1, 3];
// ΔAUC (p-tau217 + Aβ42/40 − p-tau217), 1,000번 참가자 단위 부트스트랩 95% CI
const DX = (d: number) => 44 + ((d + 0.01) / 0.06) * 146;     // −0.01 … +0.05
const forest = [
  { k: 'All', d: 0.017, lo: 0.010, hi: 0.026, y: 30, c: 'ln' },
  { k: 'CU', d: 0.027, lo: 0.014, hi: 0.044, y: 58, c: 'acc' },
  { k: 'CI', d: 0.012, lo: 0.003, hi: 0.023, y: 86, c: 'ln' },
];
// ROC: 보고된 AUC와 고정 민감도(90%)에서의 특이도에 맞춘 이항정규(binormal) 곡선
const erf = (x: number) => {
  const t = 1 / (1 + 0.3275911 * Math.abs(x));
  const y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
  return x >= 0 ? y : -y;
};
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
const PhiInv = (p: number) => {                              // Acklam 근사
  const a = [-39.69683028665376, 220.9460984245205, -275.9285104469687, 138.357751867269, -30.66479806614716, 2.506628277459239];
  const b = [-54.47609879822406, 161.5858368580409, -155.6989798598866, 66.80131188771972, -13.28068155288572];
  const c = [-0.007784894002430293, -0.3223964580411365, -2.400758277161838, -2.549732539343734, 4.374664141464968, 2.938163982698783];
  const d = [0.007784695709041462, 0.3224671290700398, 2.445134137142996, 3.754408661907416];
  const pl = 0.02425;
  if (p < pl) { const q = Math.sqrt(-2 * Math.log(p)); return (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1); }
  if (p > 1 - pl) { const q = Math.sqrt(-2 * Math.log(1 - p)); return -(((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1); }
  const q = p - 0.5, r = q * q;
  return (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1);
};
const R0 = { x: 72, y: 8, s: 100 };                          // ROC 상자 위치·크기
const rocPath = (A: number, B: number) => {
  const pts: string[] = [`${R0.x} ${R0.y + R0.s}`];
  for (let i = 1; i < 60; i++) {
    const fpr = (i / 60) ** 2;
    pts.push(`${f1(R0.x + fpr * R0.s)} ${f1(R0.y + R0.s - Phi(A + B * PhiInv(fpr)) * R0.s)}`);
  }
  pts.push(`${R0.x + R0.s} ${R0.y}`);
  return 'M' + pts.join(' L');
};
const rocPtau = rocPath(1.873, 1.05);                        // AUC 0.902, 민감도 90%에서 특이도 0.713
const rocBoth = rocPath(2.661, 1.62);                        // AUC 0.919, 민감도 90%에서 특이도 0.803
const sens90 = R0.y + R0.s - 0.9 * R0.s;

// ── tus (400 × 120) ──
const bursts = range(0, 7).map((k) => 96 + k * 40);         // 200 ms마다 (5 Hz), 한 번에 20 ms 초음파 (duty 10%)
const fesPulses = range(0, 14).map((k) => 96 + k * 21);
const fesPath = 'M90 84 ' + fesPulses.map((x) => `H${x} V58 H${x + 3} V100 H${x + 6} V84`).join(' ') + ' H392';
const resp = (A: number) => line(range(150, 390, 2), (x) => 70 - A * (Math.exp(-(((x - 230) / 13) ** 2)) - 0.75 * Math.exp(-(((x - 268) / 17) ** 2))));

// ── eeg (400 × 120) ──
const eegN = Array.from({ length: 360 }, () => rnd() * 2 - 1);
const emgEnv = (x: number) => Math.max(0, Math.sin((2 * Math.PI * x) / 360 * 2 - 0.6)) ** 3;
const eegPath = line(range(0, 720), (x) => 40 - 9 * Math.sin((2 * Math.PI * x) / 36) - 3 * Math.sin((2 * Math.PI * x) / 13 + 1) - 2.5 * eegN[x % 360]);
const emgPath = line(range(0, 720), (x) => 92 - 16 * emgEnv(x % 360) * eegN[(x * 7) % 360] - 1.2 * eegN[(x * 3) % 360]);
const fftTrace = line(range(10, 262), (x) => 64 - 10 * Math.sin((2 * Math.PI * x) / 30) - 4 * Math.sin((2 * Math.PI * x) / 11) - 2 * eegN[x % 360]);
const hann = line(range(10, 90), (x) => 100 - 70 * Math.sin((Math.PI * (x - 10)) / 80) ** 2);   // 한 창 (Hann)
const fftBars = [0.35, 0.55, 0.95, 0.6, 0.3, 0.22, 0.16, 0.12];
const PX = (f: number) => 40 + (f / 40) * 340;               // 0–40 Hz
const eegPsdPath = 'M' + range(0, 170).map((i) => {
  const f = (i / 170) * 40;
  const p = 55 / (1 + (f / 2.5) ** 1.3) + 46 * Math.exp(-((f - 10) ** 2) / 2.2) + 9 * Math.exp(-((f - 20) ** 2) / 8);
  return `${f1(PX(f))} ${f1(Math.max(10, 100 - p))}`;
}).join(' L');

// ── aidbs ──
// 여러 환자의 LFP (줄마다 다른 베타 리듬)
const lfpN = Array.from({ length: 400 }, () => rnd() * 2 - 1);
// 200 단위마다 반복되게 만들어서 끊김 없이 흘려보내요
const lfps = range(0, 4).map((k) => {
  const n = 14 + k * 3, ph = rnd() * 6;
  return line(range(0, 400), (x) => 20 + k * 19 - 5 * Math.sin((2 * Math.PI * n * x) / 200 + ph) * (0.6 + 0.4 * Math.sin((2 * Math.PI * x) / 200 + k)) - 1.5 * lfpN[(x + k * 37) % 200]);
});
// 작은 신경망: 5 → 4 → 2
const L1 = range(0, 4).map((k) => [236, 20 + k * 19]), L2 = range(0, 3).map((k) => [300, 30 + k * 19]), L3 = [[362, 48], [362, 72]];
const edges = [...L1.flatMap((a) => L2.map((b) => [a, b])), ...L2.flatMap((a) => L3.map((b) => [a, b]))];
// 맞춤 학습 곡선: 미리 학습한 모델은 적은 데이터로 빨리 오차가 줄어요
const errPre = line(range(34, 188, 2), (x) => 96 - 76 * (0.12 + 0.36 * Math.exp(-(x - 34) / 18)));
const errScratch = line(range(34, 188, 2), (x) => 96 - 76 * (0.36 + 0.64 * Math.exp(-(x - 34) / 90)));
// 베타 감지: 진폭이 오르내리는 13–30 Hz 리듬
const betaEnv = (x: number) => 0.35 + 0.65 * Math.max(0, Math.sin((2 * Math.PI * x) / 100)) ** 2;
const betaPath = line(range(0, 400), (x) => 56 - 22 * betaEnv(x) * Math.sin((2 * Math.PI * x) / 10) - 1.5 * lfpN[x % 200]);
const betaTop = line(range(0, 400), (x) => 56 - 22 * betaEnv(x));
// 폐쇄루프: 베타 포락선이 문턱을 넘을 때만 130 Hz 자극
const envL = (x: number) => 0.25 + 0.75 * Math.max(0, Math.sin((2 * Math.PI * (x - 30)) / 170 - 0.6)) ** 1.6;
const envPath = line(range(30, 390, 2), (x) => 56 - 42 * envL(x));
const TH = 0.55;
const stimPath = 'M30 104 ' + range(30, 390, 4).map((x) => (envL(x) > TH ? `H${x} V82 H${x + 1.5} V104` : `H${x}`)).join(' ');

// ── engram ──
// 해마 띠 (머리 ↙ · 꼬리 ↗) 안의 세포들, 그중 몇 개가 엔그램
const hpcC = (t: number) => [14 + t * 172, 100 - 74 * t ** 1.3 - 8 * Math.sin(Math.PI * t)];
const hpcBand = (o: number) => 'M' + range(0, 40).map((i) => { const [x, y] = hpcC(i / 40); return `${f1(x)} ${f1(y + o)}`; }).join(' L');
const cells = range(0, 21).map((i) => { const t = 0.04 + (i / 22) * 0.92; const [x, y] = hpcC(t); return { x: x + (rnd() - 0.5) * 10, y: y + (rnd() - 0.5) * 22, e: [3, 8, 11, 15, 19].includes(i) }; });
// 래스터 12줄: 신호(cue) 구간에서 엔그램 줄(2, 5, 7, 10)만 함께 발화
const ENG = new Set([2, 5, 7, 10]);
const eRaster = range(0, 11).map((r) => {
  const xs: number[] = [];
  for (let x = 20 + rnd() * 12; x < 250; x += 10 + rnd() * 34) xs.push(x);
  if (ENG.has(r)) for (let x = 124 + rnd() * 4; x < 168; x += 5 + rnd() * 3) xs.push(x);
  return { y: 20 + r * 8, xs: xs.filter((x) => !(x > 120 && x < 170) || ENG.has(r)), e: ENG.has(r) };
});
const grid16 = range(0, 15).map((i) => ({ c: i % 4, r: Math.floor(i / 4), e: [1, 6, 8, 15].includes(i) }));

// ── goal ──
const gN = Array.from({ length: 400 }, () => rnd() * 2 - 1);
const gM1 = line(range(50, 330), (x) => { const u = (x - 50) % 70; return 26 - 10 * Math.exp(-(((u - 22) / 6) ** 2)) + 6 * Math.exp(-(((u - 32) / 7) ** 2)); });
const gSTN = line(range(50, 330), (x) => 60 - 7 * Math.sin((2 * Math.PI * x) / 12) * (0.5 + 0.5 * Math.sin(x / 30)) - gN[x % 400]);
const gHPC = range(0, 26).map(() => 52 + rnd() * 276);
const brainOutline = 'M64 74 C58 40 108 14 196 12 C282 10 338 28 350 58 C358 80 340 98 306 96 C292 108 252 110 232 100 C196 108 120 108 88 98 C72 92 66 86 64 74 Z';
const nodes = [
  { x: 120, y: 44 }, { x: 170, y: 26, k: 'M1' }, { x: 230, y: 28 }, { x: 290, y: 40 }, { x: 326, y: 66 },
  { x: 96, y: 76 }, { x: 160, y: 66 }, { x: 206, y: 62, k: 'STN' }, { x: 256, y: 70 }, { x: 186, y: 92, k: 'HPC' }, { x: 290, y: 84 },
];
const links = [[0, 1], [1, 2], [2, 3], [3, 4], [0, 5], [5, 6], [6, 7], [1, 7], [7, 8], [8, 3], [7, 9], [9, 6], [8, 10], [10, 4], [2, 8], [9, 8]];
const fx2 = (t: number) => 30 + t * 360;                       // 시간 0–1 → x
const NOW = 0.42, THY = 52;                                   // 지금, 증상 문턱 (y)
const bio = (t: number) => 92 - 80 * Math.max(0, t - 0.1) ** 2; // 바이오마커 (위로 갈수록 나쁨)
const pastPath = 'M' + range(0, 42).map((i) => `${f1(fx2(i / 100))} ${f1(bio(i / 100) - 2.5 * gN[i * 7])}`).join(' L');
const futPath = 'M' + range(42, 100).map((i) => `${f1(fx2(i / 100))} ${f1(bio(i / 100))}`).join(' L');
const bandPoly = 'M' + range(42, 100).map((i) => `${f1(fx2(i / 100))} ${f1(bio(i / 100) - (i - 42) * 0.3)}`).join(' L')
  + ' L' + range(42, 100).reverse().map((i) => `${f1(fx2(i / 100))} ${f1(bio(i / 100) + (i - 42) * 0.3)}`).join(' L') + ' Z';
const symT = (() => { for (let i = 42; i < 100; i++) if (bio(i / 100) < THY) return i / 100; return 0.95; })();

type Step = { k: string; t: string; p: string; span?: number };
const STEPS: Record<Kind, Step[]> = {
  tus: [
    { k: 'tus', t: 'a-tbTUS', p: 'theta burst · 5 Hz', span: 2 },
    { k: 'fes', t: 'FES', p: 'muscle · same session', span: 2 },
    { k: 'meas', t: 'Measure', p: 'response · pre vs post', span: 2 },
  ],
  spikes: [
    { k: 'rec', t: 'Record', p: 'Vim · STN · SNr · Rt' },
    { k: 'filt', t: 'Band-pass', p: '300–3000 Hz' },
    { k: 'det', t: 'Detect', p: '−10 × MAD' },
    { k: 'ras', t: 'Raster', p: '115 recordings' },
    { k: 'rate', t: 'Firing rate', p: 'Gaussian σ 10 ms' },
    { k: 'psd', t: 'Spectrum', p: 'LFP · Welch PSD' },
  ],
  imu: [
    { k: 'photo', t: 'Build', p: 'UNO R3 · 2 × SG90', span: 2 },
    { k: 'imu', t: 'Sense', p: 'IMU tilt θ' },
    { k: 'map', t: 'Map', p: 'θ → PWM' },
    { k: 'servo', t: 'Actuate', p: 'pan · tilt', span: 2 },
  ],
  adni: [
    { k: 'match', t: 'Match', p: '1:1 · ≤ 365 d' },
    { k: 'cohort', t: 'Cohort', p: 'CU 863 · CI 661' },
    { k: 'model', t: 'Model', p: '3 × logistic' },
    { k: 'cv', t: 'Validate', p: 'grouped 5-fold × 5' },
    { k: 'forest', t: 'ΔAUC', p: '1,000 × bootstrap' },
    { k: 'roc', t: 'Specificity', p: '+9 pp @ 90% sens' },
  ],
  eeg: [
    { k: 'sig', t: 'Signal', p: 'EEG · EMG', span: 2 },
    { k: 'fft', t: 'FFT', p: 'windowed', span: 2 },
    { k: 'bands', t: 'PSD', p: 'band power', span: 2 },
  ],
  aidbs: [
    { k: 'pre', t: 'Pretrain', p: 'many patients’ LFP', span: 2 },
    { k: 'tune', t: 'Personalize', p: 'one patient · little data' },
    { k: 'sense', t: 'Sense', p: 'β from the implanted lead' },
    { k: 'loop', t: 'Stimulate', p: '130 Hz · only when β is high', span: 2 },
  ],
  engram: [
    { k: 'probe', t: 'Record', p: 'Neuropixels 1.0 Long' },
    { k: 'decode', t: 'Decode', p: 'which cells hold the memory', span: 2 },
    { k: 'replay', t: 'Replay', p: 'same cells, recalled' },
    { k: 'write', t: 'Write', p: 'the engram, not the region', span: 2 },
  ],
  goal: [
    { k: 'inputs', t: 'Measure', p: 'cortex · circuit · cell', span: 2 },
    { k: 'twin', t: 'Model', p: 'one brain, as it changes', span: 2 },
    { k: 'forecast', t: 'Predict', p: 'change before symptoms', span: 2 },
  ],
};
const steps = STEPS[kind];
const uid = `pp-${kind}`;
---
<figure class="pipe" data-pipe aria-label={label} style={`--n:${steps.length}`}>
  <ol class="stations">
    {steps.map((s, i) => {
      const W = 200 * (s.span ?? 1);
      return (
      <li class={`st${(s.span ?? 1) > 1 ? ' wide' : ''}`} style={`--i:${i};grid-column:span ${s.span ?? 1}`}>
        <span class="st-n mono" aria-hidden="true">S{i + 1}</span>
        {s.k === 'photo' ? (
          <img class="photo" src={`${base}/builds/imu-pan-tilt/hand-control.jpg`} alt="" loading="lazy" />
        ) : (
        <svg viewBox={`0 0 ${W} 120`} aria-hidden="true">
          <defs><clipPath id={`${uid}-${i}`}><rect x={({ sig: 40, pre: 10, sense: 46 } as Record<string, number>)[s.k] ?? 0} y="0" width={({ pre: 176, sense: 154 } as Record<string, number>)[s.k] ?? W} height="120" /></clipPath></defs>

          {/* ── tus ── */}
          {s.k === 'tus' && <>
            <rect class="box" x="12" y="12" width="48" height="14" />
            <path class="dim dash" d="M16 26 L36 72 M56 26 L36 72" />
            <path class="dim" d="M6 74 Q36 64 66 74" />
            <ellipse class="acc-f pulse" cx="36" cy="76" rx="4" ry="8" />
            <text class="tx" x="36" y="104" text-anchor="middle">M1</text>
            <path class="dim" d="M88 96 H392" />
            {bursts.map((x) => <rect class="pk" style={`--d:${((x - 88) / 304 * 4).toFixed(2)}s`} x={x} y="50" width="4" height="46" />)}
            <path class="scan" d="M88 40 V100" />
            <path class="dim" d={`M${bursts[1]} 106 V112 H${bursts[2]} V106`} />
            <text class="tx" x={bursts[2] + 8} y="114">200 ms</text>
          </>}
          {s.k === 'fes' && <>
            <path class="dim" d="M8 66 C24 60 50 60 70 64 M8 92 C24 98 50 98 70 94" />
            <rect class="pad" x="16" y="54" width="16" height="7" />
            <rect class="pad" x="44" y="54" width="16" height="7" />
            <path class="dim" d="M24 54 V30 H52 V54" />
            <path class="dim" d="M88 84 H392" />
            <g clip-path={`url(#${uid}-${i})`}><path class="ln" d={fesPath} /></g>
            <path class="scan" d="M88 40 V108" />
          </>}
          {s.k === 'meas' && <>
            <path class="dim" d="M12 70 H392" />
            <path class="ln dash" d={resp(26)} />
            <path class="acc draw" pathLength="1" d={resp(40)} />
            <path class="dim" d="M236 30 H256 M236 44 H256 M250 30 V44" />
            <text class="tx" x="260" y="42">Δ ?</text>
            <text class="tx" x="20" y="34">pre</text>
            <text class="tx acc-t" x="20" y="52">post</text>
            <path class="dim" d="M60 30 H76" stroke-dasharray="3 3" />
            <path class="acc" d="M60 48 H76" />
          </>}

          {/* ── spikes ── */}
          {s.k === 'rec' && <>
            <path class="dim" d="M14 4 L14 32 L16 38 L18 32 L18 4" />
            <circle class="acc-f pulse" cx="16" cy="40" r="2.4" />
            <g class="scroll"><path class="ln thin" d={rawPath} /></g>
          </>}
          {s.k === 'filt' && <>
            <rect class="band" x={fx(300)} y="12" width={fx(3000) - fx(300)} height="34" />
            <path class="dim" d="M12 46 H188" />
            <path class="acc" d={bandPath} />
            <path class="dim dash" d={`M${fx(300)} 10 V48 M${fx(3000)} 10 V48`} />
            <text class="tx" x={fx(300) - 4} y="13" text-anchor="end">300</text>
            <text class="tx" x={fx(3000) + 4} y="13">3k</text>
            <g class="scroll"><path class="ln thin" d={filtPath} /></g>
          </>}
          {s.k === 'det' && <>
            <path class="acc dash" d="M0 76 H200" />
            <g class="scroll">
              <path class="ln thin" d={filtPath2} />
              {spikeMarks.map((x) => <path class="acc-f" d={`M${x - 4} 98 L${x + 4} 98 L${x} 91 Z`} />)}
            </g>
          </>}
          {s.k === 'ras' && <>
            {raster.map((r) => r.xs.map((x) => <path class="tk" style={`--d:${((x - 12) / 176 * 4).toFixed(2)}s`} d={`M${f1(x)} ${r.y} V${r.y + 7}`} />))}
            <path class="scan" d="M12 6 V98" />
            <path class="dim" d="M12 102 H188" />
          </>}
          {s.k === 'rate' && <>
            {allTicks.map((x) => <path class="dim" d={`M${f1(x)} 96 V100`} />)}
            <path class="ln draw" pathLength="1" d={ratePath} />
            <path class="acc" d={kernelPath} />
            <path class="dim" d="M12 110 H188" />
          </>}
          {s.k === 'psd' && <>
            <path class="dim" d="M26 96 H190 M26 96 V8" />
            <path class="ln draw" pathLength="1" d={psdPath} />
            <circle class="acc-f pulse" cx={26 + (2.4 / 50) * 164} cy="20" r="3" />
            <text class="tx" x="26" y="114" text-anchor="middle">0</text>
            <text class="tx" x="190" y="114" text-anchor="end">50 Hz</text>
          </>}

          {/* ── imu ── */}
          {s.k === 'imu' && <>
            <path class="dim dash" d="M40 60 H160" />
            <g class="tilt">
              <rect class="box" x="74" y="46" width="52" height="28" />
              {[82, 92, 102, 112].map((x) => <path class="dim" d={`M${x} 46 V42 M${x + 4} 74 V78`} />)}
              <path class="acc" d="M100 60 H146" /><path class="acc-f" d="M146 56 L154 60 L146 64 Z" />
              <path class="ln" d="M100 60 V22" /><path class="w-f" d="M96 22 L100 14 L104 22 Z" />
            </g>
            <text class="tx" x="168" y="64">θ</text>
          </>}
          {s.k === 'map' && <>
            <path class="dim" d="M36 100 H186 M36 100 V14" />
            <path class="ln" d="M36 92 L180 22" />
            <path class="dim dash" d="M36 57 H108 V100" />
            <g class="slide"><circle class="acc-f" cx="108" cy="57" r="4" /></g>
            <text class="tx" x="30" y="96" text-anchor="end">1</text>
            <text class="tx" x="30" y="26" text-anchor="end">2</text>
            <text class="tx" x="30" y="58" text-anchor="end">ms</text>
            <text class="tx" x="186" y="116" text-anchor="end">θ</text>
          </>}
          {s.k === 'servo' && <>
            {/* 팬: 위에서 본 회전 */}
            <circle class="dim dash" cx="100" cy="64" r="38" />
            <rect class="box" x="82" y="52" width="36" height="24" />
            <g class="pan"><path class="acc" d="M100 64 L100 30" /><circle class="acc-f" cx="100" cy="30" r="3" /></g>
            <circle class="w-f" cx="100" cy="64" r="3.5" />
            <text class="tx" x="100" y="116" text-anchor="middle">pan</text>
            {/* 틸트: 옆에서 본 회전 */}
            <path class="dim dash" d="M262 64 A38 38 0 0 1 338 64" />
            <rect class="box" x="276" y="70" width="48" height="28" />
            <g class="tilt2"><path class="acc" d="M300 70 L300 34" /><circle class="acc-f" cx="300" cy="34" r="3" /></g>
            <circle class="w-f" cx="300" cy="70" r="3.5" />
            <text class="tx" x="300" y="116" text-anchor="middle">tilt</text>
          </>}

          {/* ── adni ── */}
          {s.k === 'match' && <>
            <path class="dim" d="M10 34 H190 M10 86 H190" />
            {pairs.map(([a, b], j) => <path class="acc ml" pathLength="1" style={`--d:${j * 0.45}s`} d={`M${a} 34 L${b} 86`} />)}
            {plasma.map((x) => <circle class={x === 186 ? 'hollow' : 'w-f'} cx={x} cy="34" r="3.6" />)}
            {pet.map((x) => <circle class="w-f" cx={x} cy="86" r="3.6" />)}
            <text class="tx" x="10" y="22">plasma</text>
            <text class="tx" x="10" y="108">PET</text>
            <path class="dim" d="M150 96 V102 H168 V96" />
            <text class="tx" x="196" y="114" text-anchor="end">≤365 d</text>
          </>}
          {s.k === 'cohort' && <>
            {cohort.map((d) => <circle class={`cd ${d.pos ? (d.cu ? 'w-f' : 'acc-f') : (d.cu ? 'hollow-w' : 'hollow-a')}`} cx="0" cy="0" r="3.6" style={`--x0:${d.x0}px;--y0:${d.y0}px;--x1:${d.x1}px;--y1:${d.y1}px`} />)}
            <text class="tx" x="46" y="112" text-anchor="middle">CU</text>
            <text class="tx acc-t" x="144" y="112" text-anchor="middle">CI</text>
            <circle class="w-f" cx="142" cy="9" r="3.6" /><text class="tx" x="196" y="14" text-anchor="end">PET+</text>
          </>}
          {s.k === 'model' && <>
            {dots0.map((d) => <circle class="dot" cx={f1(d.x)} cy={f1(d.y)} r="1.8" />)}
            {dots1.map((d) => <circle class="dot" cx={f1(d.x)} cy={f1(d.y)} r="1.8" />)}
            <path class="dim dash" d={sig(0.035, 96)} />
            <path class="ln" d={sig(0.06, 100)} />
            <path class="acc draw" pathLength="1" d={sig(0.09, 100)} />
          </>}
          {s.k === 'cv' && <>
            {cvStart.map((st, r) => (
              <g transform={`translate(26 ${12 + r * 20})`}>
                {[0, 1, 2, 3, 4].map((c) => <rect class="fold" x={c * 30} y="0" width="26" height="13" />)}
                <rect class="held" style={`--d:${(-st * 1).toFixed(1)}s`} x="0" y="0" width="26" height="13" />
              </g>
            ))}
          </>}
          {s.k === 'forest' && <>
            <path class="dim dash" d={`M${f1(DX(0))} 14 V100`} />
            <path class="dim" d={`M44 100 H190`} />
            {forest.map((r, j) => <>
              <text class={`tx ${r.c === 'acc' ? 'acc-t' : ''}`} x="8" y={r.y + 4}>{r.k}</text>
              <path class={`${r.c} draw`} pathLength="1" style={`--d:${j * 0.3}s`} d={`M${f1(DX(r.lo))} ${r.y} H${f1(DX(r.hi))}`} />
              <path class={r.c} d={`M${f1(DX(r.lo))} ${r.y - 4} V${r.y + 4} M${f1(DX(r.hi))} ${r.y - 4} V${r.y + 4}`} />
              <rect class={r.c === 'acc' ? 'acc-f' : 'w-f'} x={f1(DX(r.d) - 3.5)} y={r.y - 3.5} width="7" height="7" />
            </>)}
            <text class="tx" x={f1(DX(0))} y="114" text-anchor="middle">0</text>
            <text class="tx" x={f1(DX(0.04))} y="114" text-anchor="middle">.04</text>
          </>}
          {s.k === 'roc' && <>
            <rect class="tbl" x={R0.x} y={R0.y} width={R0.s} height={R0.s} />
            <path class="dim dash" d={`M${R0.x} ${R0.y + R0.s} L${R0.x + R0.s} ${R0.y}`} />
            <path class="ln" d={rocPtau} />
            <path class="acc draw" pathLength="1" d={rocBoth} />
            <path class="dim" d={`M${R0.x} ${f1(sens90)} H${R0.x + R0.s}`} />
            <circle class="w-f" cx={f1(R0.x + 0.287 * R0.s)} cy={f1(sens90)} r="3" />
            <circle class="acc-f pulse" cx={f1(R0.x + 0.197 * R0.s)} cy={f1(sens90)} r="3" />
            <text class="tx" x={R0.x - 6} y={f1(sens90 + 4)} text-anchor="end">90%</text>
            <text class="tx acc-t" x={R0.x + 40} y={R0.y + 62}>.919</text>
            <text class="tx" x={R0.x + 52} y={R0.y + 80}>.902</text>
            <text class="tx" x={R0.x - 6} y={R0.y + R0.s} text-anchor="end">AUC</text>
          </>}

          {/* ── aidbs ── */}
          {s.k === 'pre' && <>
            <g clip-path={`url(#${uid}-${i})`}><g transform="translate(10 0)"><g class="scroll">{lfps.map((d) => <path class="ln thin" d={d} />)}</g></g></g>
            {L1.map(([x, y]) => <path class="dim" d={`M190 ${y} H${x - 5}`} />)}
            {edges.map(([a, b], j) => <path class="edge" style={`--d:${((j * 0.37) % 3).toFixed(2)}s`} d={`M${a[0]} ${a[1]} L${b[0]} ${b[1]}`} />)}
            {[...L1, ...L2].map(([x, y]) => <circle class="node" cx={x} cy={y} r="4.5" />)}
            {L3.map(([x, y]) => <circle class="node out" cx={x} cy={y} r="4.5" />)}
            <path class="dim" d="M367 48 H392 M367 72 H392" />
          </>}
          {s.k === 'tune' && <>
            <path class="dim" d="M34 100 H190 M34 100 V18" />
            <path class="dim dash" d={errScratch} />
            <path class="acc draw" pathLength="1" d={errPre} />
            <text class="tx" x="38" y="14">error</text>
            <text class="tx" x="190" y="38" text-anchor="end">scratch</text>
            <text class="tx acc-t" x="190" y="78" text-anchor="end">pretrained</text>
            <text class="tx" x="190" y="116" text-anchor="end">data →</text>
          </>}
          {s.k === 'sense' && <>
            <ellipse class="band" cx="22" cy="76" rx="14" ry="9" style="opacity:.25" />
            <rect class="box" x="18" y="0" width="8" height="84" rx="4" />
            {[54, 62, 70, 78].map((y) => <rect class="w-f" x="18" y={y} width="8" height="5" />)}
            <g clip-path={`url(#${uid}-${i})`}><g transform="translate(46 0)"><g class="scroll"><path class="ln thin" d={betaPath} /><path class="acc dash" d={betaTop} /></g></g></g>
            <text class="tx" x="194" y="14" text-anchor="end">β</text>
          </>}
          {s.k === 'loop' && <>
            <text class="tx" x="4" y="40">β</text>
            <text class="tx" x="4" y="98">DBS</text>
            <path class="dim" d="M30 100 H390" />
            <path class="ln" d={envPath} />
            <path class="dim dash" d={`M30 ${f1(56 - 42 * TH)} H390`} />
            <path class="acc" d={stimPath} />
            <path class="scanL" d="M30 6 V108" />
            <path class="dim dash" d="M396 96 V40" /><path class="w-f" d="M392 44 L396 36 L400 44 Z" />
          </>}

          {/* ── engram ── */}
          {s.k === 'probe' && <>
            <path class="dim" d={hpcBand(-13)} /><path class="dim" d={hpcBand(13)} />
            {cells.map((c) => <circle class={c.e ? 'eng' : 'cell'} cx={f1(c.x)} cy={f1(c.y)} r={c.e ? 3.4 : 2.6} />)}
            <path class="shank" d="M198 4 L36 104" />
            {range(0, 13).map((k) => <rect class="acc-f" x={f1(48 + k * 11 - 1.2)} y={f1(104 - (k * 11 + 12) * (100 / 162) - 1.2)} width="2.4" height="2.4" />)}
          </>}
          {s.k === 'decode' && <>
            <rect class="band hi" x="120" y="12" width="50" height="104" />
            <text class="tx" x="145" y="13" text-anchor="middle">cue</text>
            {eRaster.map((r) => r.xs.map((x) => <path class={r.e && x > 120 && x < 170 ? 'tka' : 'tk'} style={`--d:${((x - 20) / 230 * 4).toFixed(2)}s`} d={`M${f1(x)} ${r.y} V${r.y + 5}`} />))}
            <path class="scan2" d="M20 14 V112" />
            <path class="dim" d="M258 64 H276" /><path class="w-f" d="M276 60 L283 64 L276 68 Z" />
            {grid16.map((g) => <circle class={g.e ? 'eng big' : 'cell big'} cx={300 + g.c * 24} cy={28 + g.r * 24} r="6" />)}
          </>}
          {s.k === 'replay' && <>
            {grid16.map((g) => <circle class={g.e ? 'eng-s' : 'cell'} cx={22 + g.c * 17} cy={26 + g.r * 17} r="5" />)}
            {grid16.map((g) => <circle class={g.e ? 'eng-r' : 'cell'} cx={114 + g.c * 17} cy={26 + g.r * 17} r="5" />)}
            <path class="dim" d="M94 0 V100" />
            <text class="tx" x="47" y="114" text-anchor="middle">learn</text>
            <text class="tx acc-t" x="140" y="114" text-anchor="middle">recall</text>
          </>}
          {s.k === 'write' && <>
            <ellipse class="region" cx="100" cy="56" rx="78" ry="40" />
            {grid16.map((g) => <circle class="cell lit" cx={46 + g.c * 36} cy={28 + g.r * 18} r="4.5" />)}
            <path class="dim" d="M200 6 V104" />
            {grid16.map((g) => <circle class={g.e ? 'eng' : 'cell'} cx={246 + g.c * 36} cy={28 + g.r * 18} r="4.5" />)}
            {grid16.filter((g) => g.e).map((g) => <circle class="ring" cx={246 + g.c * 36} cy={28 + g.r * 18} r="9" />)}
            <text class="tx" x="100" y="116" text-anchor="middle">region</text>
            <text class="tx acc-t" x="300" y="116" text-anchor="middle">engram</text>
          </>}

          {/* ── goal ── */}
          {s.k === 'inputs' && <>
            <text class="tx" x="4" y="30">M1</text>
            <text class="tx" x="4" y="64">STN</text>
            <text class="tx" x="4" y="98">HPC</text>
            <path class="ln thin" d={gM1} />
            <path class="ln thin" d={gSTN} />
            {gHPC.map((x) => <path class="tk" style={`--d:${((x - 52) / 276 * 4).toFixed(2)}s`} d={`M${f1(x)} 88 V100`} />)}
            <path class="dim" d="M336 26 C360 26 360 60 384 60 M336 60 H384 M336 94 C360 94 360 60 384 60" />
            <circle class="acc-f pulse" cx="388" cy="60" r="4" />
            <path class="scanL" d="M50 10 V108" style="animation-name:scanIn" />
          </>}
          {s.k === 'twin' && <>
            <path class="dim" d={brainOutline} />
            {links.map(([a, b], j) => <path class="edge" style={`--d:${((j * 0.41) % 3).toFixed(2)}s`} d={`M${nodes[a].x} ${nodes[a].y} L${nodes[b].x} ${nodes[b].y}`} />)}
            {nodes.map((n) => <circle class={n.k ? 'node out' : 'node'} cx={n.x} cy={n.y} r={n.k ? 5.5 : 4} />)}
            {nodes.filter((n) => n.k).map((n) => <text class="tx acc-t" x={n.x + 9} y={n.y + 5}>{n.k}</text>)}
          </>}
          {s.k === 'forecast' && <>
            <path class="dim" d="M30 104 H390 M30 104 V8" />
            <path class="dim dash" d={`M30 ${THY} H390`} />
            <path class="band-a" d={bandPoly} />
            <path class="ln" d={pastPath} />
            <path class="acc dash draw" pathLength="1" d={futPath} />
            <path class="ln" d={`M${f1(fx2(NOW))} 26 V104`} />
            <path class="dim dash" d={`M${f1(fx2(symT))} 26 V104`} />
            <text class="tx" x={f1(fx2(NOW))} y="18" text-anchor="middle">now</text>
            <text class="tx" x={f1(fx2(symT))} y="18" text-anchor="middle">symptoms</text>
            <path class="acc" d={`M${f1(fx2(NOW) + 4)} 98 H${f1(fx2(symT) - 4)}`} /><path class="acc-f" d={`M${f1(fx2(symT) - 4)} 94 L${f1(fx2(symT) + 3)} 98 L${f1(fx2(symT) - 4)} 102 Z`} />
            <text class="tx acc-t" x={f1((fx2(NOW) + fx2(symT)) / 2)} y="116" text-anchor="middle">lead time</text>
          </>}

          {/* ── eeg ── */}
          {s.k === 'sig' && <>
            <text class="tx" x="4" y="44">EEG</text>
            <text class="tx" x="4" y="96">EMG</text>
            <g clip-path={`url(#${uid}-${i})`}>
              <g class="scroll2"><path class="ln thin" d={eegPath} /><path class="ln thin" d={emgPath} /></g>
            </g>
          </>}
          {s.k === 'fft' && <>
            <path class="ln thin" d={fftTrace} />
            <g class="win"><path class="acc dash" d={hann} /><path class="dim" d="M10 24 V104 M90 24 V104" /></g>
            <path class="dim" d="M280 60 H300" /><path class="w-f" d="M300 56 L307 60 L300 64 Z" />
            <path class="dim" d="M318 104 H394" />
            {fftBars.map((h, j) => <rect class="bar" style={`--d:${(j * 0.12).toFixed(2)}s`} x={320 + j * 9} y={f1(104 - h * 76)} width="6" height={f1(h * 76)} />)}
          </>}
          {s.k === 'bands' && <>
            <rect class="band" x={PX(4)} y="12" width={PX(8) - PX(4)} height="88" />
            <rect class="band hi" x={PX(8)} y="12" width={PX(13) - PX(8)} height="88" />
            <rect class="band" x={PX(13)} y="12" width={PX(30) - PX(13)} height="88" />
            <path class="dim" d={`M40 100 H384 M40 100 V8`} />
            <path class="ln draw" pathLength="1" d={eegPsdPath} />
            <text class="tx" x={(PX(4) + PX(8)) / 2} y="28" text-anchor="middle">θ</text>
            <text class="tx acc-t" x={(PX(8) + PX(13)) / 2} y="28" text-anchor="middle">α</text>
            <text class="tx" x={(PX(13) + PX(30)) / 2} y="28" text-anchor="middle">β</text>
            <text class="tx" x="384" y="116" text-anchor="end">Hz</text>
          </>}
        </svg>
        )}
        <span class="cap"><b>{s.t}</b><span class="mono">{s.p}</span></span>
      </li>
      );
    })}
  </ol>
</figure>

<style>
  .pipe { --acc: #a8c8ff; margin: 0; }
  .stations { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 1px solid #1d1d1d; border-left: 1px solid #1d1d1d; }
  .st { position: relative; display: flex; flex-direction: column; border-right: 1px solid #1d1d1d; border-bottom: 1px solid #1d1d1d; padding: 10px 12px 12px; background-image: linear-gradient(#0e0e0e 1px, transparent 1px), linear-gradient(90deg, #0e0e0e 1px, transparent 1px); background-size: 20px 20px; min-width: 0; }
  /* 단계 사이 화살표 */
  .st + .st::before { content: ''; position: absolute; left: -5px; top: 50%; width: 8px; height: 8px; border-top: 1px solid #5a5a5a; border-right: 1px solid #5a5a5a; transform: translateY(-50%) rotate(45deg); background: #050505; z-index: 1; }
  .st-n { position: absolute; left: 12px; top: 8px; font-size: 12px; color: #6a6a6a; letter-spacing: .06em; z-index: 1; }
  .st svg { display: block; width: 100%; height: auto; margin-top: 16px; overflow: hidden; }
