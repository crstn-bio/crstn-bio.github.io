  svg .hollow-a { fill: #050505; stroke: var(--acc); stroke-width: 1; }
  svg .dot { fill: #6a6a6a; }
  svg .box { fill: #050505; stroke: #bdbdbd; stroke-width: 1.1; }
  svg .pad { fill: none; stroke: var(--acc); stroke-width: 1.2; }
  svg .band { fill: var(--acc); opacity: .08; }
  svg .band.hi { opacity: .18; }
  svg .tx { fill: #8a8a8a; font: 15.5px var(--mono); }
  svg .acc-t { fill: var(--acc); }
  svg .tbl { fill: #050505; stroke: #5a5a5a; }
  svg .fold { fill: #0b0b0b; stroke: #3a3a3a; }
  svg .held { fill: var(--acc); opacity: .75; }
  svg .bar { fill: #cfcfcf; }
  svg .tk { stroke: #cfcfcf; stroke-width: 1.2; }
  svg .pk { fill: #cfcfcf; }
  svg .scan { stroke: var(--acc); stroke-width: 1; opacity: .7; }
  svg .cd { transform: translate(var(--x1), var(--y1)); }
  svg .edge { fill: none; stroke: #3a3a3a; stroke-width: 1; }
  svg .node { fill: #050505; stroke: #bdbdbd; stroke-width: 1.2; }
  svg .node.out { stroke: var(--acc); fill: rgba(168, 200, 255, .25); }
  svg .cell { fill: #050505; stroke: #5f5f5f; stroke-width: 1; }
  svg .cell.big { stroke-width: 1.2; }
  svg .cell.lit { fill: #8a8a8a; stroke: #bdbdbd; }
  svg .eng, svg .eng-s { fill: var(--acc); }
  svg .eng-r { fill: var(--acc); }
  svg .region { fill: rgba(255, 255, 255, .06); stroke: #6a6a6a; stroke-dasharray: 3 3; }
  svg .ring { fill: none; stroke: var(--acc); stroke-width: 1; }
  svg .shank { fill: none; stroke: #e6e6e6; stroke-width: 2; }
  svg .tka { stroke: var(--acc); stroke-width: 1.4; }
  svg .scanL, svg .scan2 { stroke: var(--acc); stroke-width: 1; opacity: .7; }
  svg .band-a { fill: var(--acc); opacity: .12; }

  /* ── 움직임: 화면에 보일 때만 (.run) ── */
  .pipe .scroll { animation: scroll 6s linear infinite; }
  .pipe .scroll2 { animation: scroll2 9s linear infinite; }
  .pipe .pulse { transform-box: fill-box; transform-origin: center; animation: pulse 1.6s ease-out infinite; }
  .pipe .draw { stroke-dasharray: 1; animation: draw 5s ease-in-out infinite backwards; animation-delay: var(--d, 0s); }
  .pipe .ml { stroke-dasharray: 1; animation: draw 5s ease-out infinite backwards; animation-delay: var(--d); }
  .pipe .tk { animation: tk 4s linear infinite; animation-delay: var(--d); }
  .pipe .pk { animation: pk 4s linear infinite; animation-delay: var(--d); }
  .pipe .scan { animation: scan 4s linear infinite; }
  .pipe .held { animation: fold 5s steps(5, jump-none) infinite; animation-delay: var(--d); }
  .pipe .bar { transform-box: fill-box; transform-origin: bottom; animation: grow 2.4s ease-in-out infinite alternate; animation-delay: var(--d); }
  .pipe .cd { animation: sort 6s ease-in-out infinite; }
  .pipe .tilt { transform-box: view-box; transform-origin: 100px 60px; animation: tilt 4s ease-in-out infinite alternate; }
  .pipe .slide { animation: slide 4s ease-in-out infinite alternate; }
  .pipe .pan { transform-box: view-box; transform-origin: 100px 64px; animation: tilt 4s ease-in-out infinite alternate; }
  .pipe .tilt2 { transform-box: view-box; transform-origin: 300px 70px; animation: tilt 4s ease-in-out infinite alternate; }
  .pipe .win { animation: win 5s ease-in-out infinite alternate; }
  .pipe .edge { animation: edge 3s linear infinite; animation-delay: var(--d); }
  .pipe .scanL { animation: scanL 4.5s linear infinite; }
  .pipe .scan2 { animation: scan2 4s linear infinite; }
  .pipe .eng { transform-box: fill-box; transform-origin: center; animation: eng 2s ease-in-out infinite; }
  .pipe .eng-r { animation: engr 4s ease-in-out infinite; }
  .pipe .ring { transform-box: fill-box; transform-origin: center; animation: pulse 1.6s ease-out infinite; }
  .pipe .band-a { animation: fade 5s ease-in-out infinite; }
  .pipe .st { animation: st calc(var(--n) * 1.2s) infinite; animation-delay: calc(var(--i) * 1.2s); }
  .pipe .st-n { animation: stn calc(var(--n) * 1.2s) infinite; animation-delay: calc(var(--i) * 1.2s); }
  .pipe:not(.run) .st, .pipe:not(.run) .st * { animation-play-state: paused; }

  /* tus·fes의 훑는 선은 400 폭 */
  .pipe svg[viewBox^='0 0 400'] .scan { animation-name: scan400; }

  @keyframes scroll { to { transform: translateX(-200px); } }
  @keyframes scroll2 { to { transform: translateX(-360px); } }
  @keyframes pulse { 0% { transform: scale(.6); opacity: 1; } 70%, 100% { transform: scale(1.8); opacity: .25; } }
  @keyframes draw { 0% { stroke-dashoffset: 1; } 55%, 100% { stroke-dashoffset: 0; } }
  @keyframes tk { 0% { stroke: #a8c8ff; } 12%, 100% { stroke: #cfcfcf; } }
  @keyframes pk { 0% { fill: #a8c8ff; } 12%, 100% { fill: #cfcfcf; } }
  @keyframes scan { from { transform: translateX(0); } to { transform: translateX(176px); } }
  @keyframes scan400 { from { transform: translateX(0); } to { transform: translateX(304px); } }
  @keyframes fold { from { transform: translateX(0); } to { transform: translateX(120px); } }
  @keyframes grow { 0% { transform: scaleY(.25); } 100% { transform: scaleY(1); } }
  @keyframes sort { 0%, 12% { transform: translate(var(--x0), var(--y0)); } 42%, 88% { transform: translate(var(--x1), var(--y1)); } 100% { transform: translate(var(--x0), var(--y0)); } }
  @keyframes tilt { from { transform: rotate(-35deg); } to { transform: rotate(35deg); } }
  @keyframes slide { from { transform: translate(-31px, 15px); } to { transform: translate(31px, -15px); } }
  @keyframes win { from { transform: translateX(0); } to { transform: translateX(172px); } }
  @keyframes edge { 0%, 70%, 100% { stroke: #3a3a3a; } 80% { stroke: #a8c8ff; } }
  @keyframes scanL { from { transform: translateX(0); } to { transform: translateX(360px); } }
  @keyframes scanIn { from { transform: translateX(0); } to { transform: translateX(278px); } }
  @keyframes scan2 { from { transform: translateX(0); } to { transform: translateX(230px); } }
  @keyframes eng { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .55; transform: scale(.8); } }
  @keyframes engr { 0%, 35% { fill: #050505; } 50%, 100% { fill: #a8c8ff; } }
  @keyframes fade { 0%, 20% { opacity: 0; } 60%, 100% { opacity: .12; } }
  @keyframes st { 0%, 13% { background-color: rgba(168, 200, 255, .05); } 22%, 100% { background-color: transparent; } }
  @keyframes stn { 0%, 13% { color: #a8c8ff; } 22%, 100% { color: #6a6a6a; } }

  /* 좁은 화면: 2열. 넓은 단계(파형·사진)는 한 줄 전체, 그림 높이는 고정하고 비율 유지 */
  @media (max-width: 1000px) {
    .stations { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st { grid-column: span 1 !important; }
    .st.wide { grid-column: span 2 !important; }
    .st svg { height: 124px; }
    .photo { aspect-ratio: auto; height: 124px; }
    .st + .st::before { display: none; }
  }
  @media (max-width: 560px) {
    .st { padding: 8px 8px 10px; }
    .st svg { height: 108px; }
    .photo { height: 120px; }
    .st-n { left: 8px; }
    .cap b { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pipe .st, .pipe .st * { animation: none !important; }
    .pipe .draw, .pipe .ml { stroke-dasharray: none; }
  }
</style>

<script>
  // 화면에 들어왔을 때만 움직이게
  document.querySelectorAll<HTMLElement>('[data-pipe]').forEach((el) => {
    new IntersectionObserver(([e]) => el.classList.toggle('run', e.isIntersecting), { threshold: 0.15 }).observe(el);
  });
</script>
