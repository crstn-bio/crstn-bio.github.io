---
// 상태 표시 하나. 종류마다 테두리 모양이 달라요 (실선 = 한 일, 점선 = 질문·개념).
export type StatusKind = 'current' | 'done' | 'build' | 'next' | 'question' | 'concept' | 'frontier';
interface Props { kind: StatusKind; text?: string }
const LABEL: Record<StatusKind, string> = {
  current: 'Current work', done: 'Completed', build: 'Independent build', next: 'Next experiment',
  question: 'Research question', concept: 'Translational concept', frontier: 'Long-term frontier',
};
const { kind, text } = Astro.props;
---
<span class={`status status--${kind}`}>{text ?? LABEL[kind]}</span>
