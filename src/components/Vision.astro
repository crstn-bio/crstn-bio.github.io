---
import Pipeline from './Pipeline.astro';

// 연구 비전 섹션
// 1) 스크롤하면 한 단어씩 밝아지는 문장
// 2) 해독 → 부호화 폐루프 파이프라인 (Pipeline.astro)
// 3) 화면에 고정된 뇌 모델 + 세 단계 (파킨슨병 → 기억 회로 → 전뇌 모델과 이식형 기기)
const statements = [
  'A patient’s brain state is always changing.',
  'Most stimulation is still programmed in clinic and left running.',
  'I want to build systems that listen, and adapt.',
];

const stages = [
  {
    n: '01',
    when: 'Starting point',
    title: 'Adaptive stimulation for Parkinson’s disease',
    body: 'Deep brain stimulation already lets us record from and stimulate deep circuits such as the subthalamic nucleus. That makes Parkinson’s the place I would begin, while increasingly adaptive and personalized approaches are still being investigated.',
  },
  {
    n: '02',
    when: 'Longer term',
    title: 'Memory circuits and Alzheimer’s disease',
    body: 'I’m curious whether similar principles could extend to hippocampal and distributed memory circuits, potentially toward decoding memory-related representations and, eventually, reconstructing and modulating them to restore disrupted memory function in conditions such as Alzheimer’s disease.',
  },
  {
    n: '03',
    when: 'Ultimately',
    title: 'A personalized, implantable system',
    body: 'Whole-brain modelling of each patient, a brain–computer interface that reads their changing state, and an implantable device that uses both to personalize neuromodulation.',
  },
];
---
<section class="vision" id="vision" aria-labelledby="vision-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="vision-h">Vision</h2>
      <p>Where I want this work to go.</p>
    </div>

    <div class="statements">
      {statements.map((s) => (
        <p class="reveal">{s.split(' ').map((w) => <><span class="w">{w}</span>{' '}</>)}</p>
      ))}
    </div>

    <svg class="leads" viewBox="0 0 200 220" aria-hidden="true">
      <path d="M40 0 L40 40 L80 90 L80 220" />
      <path d="M90 0 L90 220" />
      <path d="M110 0 L110 220" />
      <path d="M160 0 L160 40 L120 90 L120 220" />
      <path class="spark" d="M40 0 L40 40 L80 90 L80 220" />
      <path class="spark s2" d="M110 0 L110 220" />
      <path class="spark s3" d="M160 0 L160 40 L120 90 L120 220" />
    </svg>

    <Pipeline />
  </div>

  <div class="scrolly">
    <div class="stage">
      <canvas id="vision-brain" aria-hidden="true"></canvas>
      <dl class="stage-hud mono" aria-hidden="true">
        <div><dt>phase</dt><dd data-vh="phase">01 / 03</dd></div>
        <div><dt>target</dt><dd data-vh="target">subthalamic nucleus</dd></div>
        <div><dt>mode</dt><dd data-vh="mode">closed-loop DBS</dd></div>
      </dl>
      <p class="stage-note mono">Illustrative model. Structure positions are approximate.</p>
    </div>

    <ol class="steps wrap">
      {stages.map((s, i) => (
        <li class="step" data-stage={i + 1}>
          <div class="step-inner">
            <p class="step-when mono"><span>{s.n}</span>{s.when}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .vision { background: #000; color: #fff; padding-top: clamp(72px, 11vw, 144px); border-top: 1px solid var(--rule); }

  /* 1) 한 단어씩 밝아지는 문장 */
  .statements { display: grid; gap: clamp(28px, 5vw, 56px); text-align: center; margin: clamp(24px, 6vw, 72px) auto 0; }
  .reveal {
    margin: 0 auto; max-width: 18ch; font-size: clamp(30px, 4.6vw, 60px); font-weight: 300; letter-spacing: -0.025em; line-height: 1.12;
    text-wrap: balance;
  }
  .w { opacity: 0.16; transition: opacity 500ms ease; }
  .w.on { opacity: 1; }

  /* 전극 리드처럼 내려오는 선 */
  .leads { display: block; width: 200px; height: 220px; margin: clamp(40px, 6vw, 72px) auto 0; overflow: visible; }
  .leads path { fill: none; stroke: rgba(255, 255, 255, 0.28); stroke-width: 1; }
  .leads .spark { stroke: #fff; stroke-width: 1.4; stroke-dasharray: 18 400; stroke-dashoffset: 18; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .leads .spark { opacity: 1; animation: spark 3.2s cubic-bezier(.5,0,.5,1) infinite; }
    .leads .s2 { animation-delay: 1.1s; }
    .leads .s3 { animation-delay: 2.1s; }
  }
  @keyframes spark { to { stroke-dashoffset: -300; } }

  /* 3) 고정된 뇌 + 단계 */
  .scrolly { position: relative; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage-hud {
    position: absolute; right: var(--gutter); bottom: 52px; margin: 0;
    display: grid; grid-template-columns: auto auto; gap: 5px 18px; min-width: 250px;
    padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.22);
  }
  .stage-hud div { display: contents; }
  .stage-hud dt { color: rgba(255, 255, 255, 0.42); }
  .stage-hud dd { margin: 0; text-align: right; color: rgba(255, 255, 255, 0.86); }
  .stage-note { position: absolute; right: var(--gutter); bottom: 28px; margin: 0; color: rgba(255, 255, 255, 0.34); }

  .steps { list-style: none; margin: -100svh auto 0; padding-top: 0; padding-bottom: 0; position: relative; }
  .step { min-height: 100svh; display: flex; align-items: center; }
  .step-inner { max-width: 430px; }
  .step-when { display: flex; gap: 14px; color: #8d8d8d; margin-bottom: 18px; }
  .step-when span { color: #fff; }
  .step h3 { font-size: clamp(26px, 2.8vw, 36px); font-weight: 400; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 18px; }
  .step p:last-child { color: #b5b5b5; font-size: 17px; line-height: 1.7; margin: 0; }
  .step:last-child { min-height: 110svh; }

  @media (max-width: 1100px) { .stage-hud { display: none; } }
  @media (max-width: 760px) {
    .step { align-items: flex-end; padding-bottom: 12svh; }
    .step-inner {
      max-width: none; padding-top: 48px;
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.9) 48px, #000 100%);
    }
    .stage-note { left: var(--gutter); right: auto; bottom: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .w { transition: none; } }
</style>

<script>
  import { buildBrain, buildNetwork, makeRng, makeProjector, depthOf, REGION, type BrainPoint } from '../scripts/brain';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── 1) 문장이 스크롤에 맞춰 한 단어씩 밝아짐 ──
  const reveals = [...document.querySelectorAll<HTMLElement>('.vision .reveal')];
  const words = reveals.map((p) => [...p.querySelectorAll<HTMLElement>('.w')]);
  function updateReveal() {
    const vh = window.innerHeight;
    reveals.forEach((p, k) => {
      const r = p.getBoundingClientRect();
      const prog = Math.min(1, Math.max(0, (vh * 0.82 - r.top) / (r.height + vh * 0.28)));
      const on = Math.round(prog * words[k].length);
      words[k].forEach((w, i) => w.classList.toggle('on', i < on));
    });
  }
  if (reduce) words.flat().forEach((w) => w.classList.add('on'));
  else {
    let queued = false;
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; updateReveal(); }); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateReveal();
  }

  // ── 2) 고정된 뇌 모델: 단계마다 다른 구조가 켜짐 ──
  const canvas = document.getElementById('vision-brain') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const R = makeRng(99);
    let w = 0, h = 0, cx = 0, cy = 0, scale = 1, mobile = false;
    let pts: BrainPoint[] = [];
    let PX = new Float32Array(0), PY = new Float32Array(0), PZ = new Float32Array(0);
    let stnIdx: number[] = [], hipIdx: number[] = [];
    let net = { nodes: [] as number[], edges: [] as [number, number][] };
    let mem: [number, number][] = [];              // 해마 ↔ 대뇌 피질 연결
    let stnC = [0, 0, 0], hipC = [0, 0, 0];

    function build() {
      pts = buildBrain(mobile ? 4200 : 7000, { deep: true });
      PX = new Float32Array(pts.length); PY = new Float32Array(pts.length); PZ = new Float32Array(pts.length);
      const cortex: number[] = [];
      stnIdx = []; hipIdx = [];
      pts.forEach((p, i) => {
        if (p.r === REGION.cortex) cortex.push(i);
        else if (p.r === REGION.stn) stnIdx.push(i);
        else if (p.r === REGION.hippo) hipIdx.push(i);
      });
      const mean = (ids: number[]) => {
        const near = ids.filter((i) => pts[i].z > 0);
        return [0, 1, 2].map((k) => near.reduce((s, i) => s + [pts[i].x, pts[i].y, pts[i].z][k], 0) / near.length);
      };
      stnC = mean(stnIdx); hipC = mean(hipIdx);
      net = buildNetwork(pts, cortex, 200, R);
      mem = [];
      for (let k = 0; k < 44; k++) {
        const c = cortex[Math.floor(R() * cortex.length)];
        const side = Math.sign(pts[c].z) || 1;
        const hs = hipIdx.filter((i) => Math.sign(pts[i].z) === side);
        mem.push([hs[Math.floor(R() * hs.length)], c]);
      }
    }

    function layout() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas!.getBoundingClientRect();
      const wasMobile = mobile;
      w = r.width; h = r.height; mobile = w < 760;
      canvas!.width = Math.round(w * dpr); canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = mobile ? w * 0.5 : w * 0.66;
      cy = mobile ? h * 0.3 : h * 0.47;
      scale = mobile ? Math.min(w * 0.36, h * 0.2) : Math.min(w * 0.21, h * 0.32);
      if (!pts.length || wasMobile !== mobile) build();
    }

    // 단계별 목표 가중치
    type W = { cortex: number; stn: number; hip: number; lead: number; mem: number; net: number; device: number };
    const TARGET: Record<number, W> = {
      1: { cortex: 0.3, stn: 1, hip: 0.08, lead: 1, mem: 0, net: 0, device: 0 },
      2: { cortex: 0.34, stn: 0.1, hip: 1, lead: 0, mem: 1, net: 0, device: 0 },
      3: { cortex: 0.9, stn: 0.75, hip: 0.75, lead: 1, mem: 0.35, net: 1, device: 1 },
    };
    const HUD: Record<number, [string, string, string]> = {
      1: ['01 / 03', 'subthalamic nucleus', 'closed-loop DBS'],
      2: ['02 / 03', 'hippocampal circuits', 'memory modulation'],
      3: ['03 / 03', 'whole brain', 'personalized implant'],
    };
    let stage = 1;
    const cur: W = { ...TARGET[1] };

    type Pulse = { a: number; b: number; t0: number; dur: number; kind: 'net' | 'mem' };
    let pulses: Pulse[] = [];
    let lastSpawn = 0;

    const label = (x: number, y: number, dx: number, dy: number, text: string, a: number) => {
      if (a < 0.02) return;
      ctx.globalAlpha = a;
      ctx.strokeStyle = 'rgba(255,255,255,0.6)';
      ctx.lineWidth = 1;
      ctx.font = '11px "Geist Mono Variable", ui-monospace, monospace';
      const tw = ctx.measureText(text.toUpperCase()).width + 8;
      if (dx < 0 && x + dx - tw < 8) dx = x + Math.abs(dx) + tw < w - 8 ? Math.abs(dx) : -(x - tw - 8);
      else if (dx > 0 && x + dx + tw > w - 8) dx = x - dx - tw > 8 ? -dx : w - 8 - tw - x;
      ctx.fillStyle = '#fff';
      ctx.textAlign = dx < 0 ? 'right' : 'left';
      ctx.textBaseline = 'middle';
      ctx.strokeStyle = 'rgba(255,255,255,0.6)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx * 0.6, y + dy); ctx.lineTo(x + dx, y + dy); ctx.stroke();
      ctx.fillText(text.toUpperCase(), x + dx + (dx < 0 ? -8 : 8), y + dy);
      ctx.globalAlpha = 1;
    };

    function draw(t: number, dt: number) {
      const k = reduce ? 1 : Math.min(1, dt * 2.6);
      const tgt = TARGET[stage];
      (Object.keys(cur) as (keyof W)[]).forEach((key) => { cur[key] += (tgt[key] - cur[key]) * k; });

      const P = makeProjector({ yaw: -0.5 + 0.22 * Math.sin(t * 0.09), pitch: -0.16, cx, cy, scale });
      ctx.clearRect(0, 0, w, h);

      // 점 투영과 그리기 (밝기 단계별로 묶어서)
      const B = 10;
      const buckets: number[][] = Array.from({ length: B }, () => []);
      const deep: number[] = [];
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        const [x, y, z] = P(p.x, p.y, p.z);
        PX[i] = x; PY[i] = y; PZ[i] = z;
        if (p.r === REGION.stn || p.r === REGION.hippo) { deep.push(i); continue; }
        const a = Math.min(0.999, p.b * (0.3 + 0.7 * depthOf(z)) * cur.cortex);
        if (a > 0.02) buckets[Math.floor(a * B)].push(i);
      }
      for (let b = 0; b < B; b++) {
        if (!buckets[b].length) continue;
        ctx.fillStyle = `rgba(255,255,255,${((b + 0.5) / B).toFixed(3)})`;
        for (const i of buckets[b]) ctx.fillRect(PX[i], PY[i], 1.2, 1.2);
      }

      // 대뇌 네트워크 (3단계)
      if (cur.net > 0.02) {
        ctx.strokeStyle = `rgba(255,255,255,${(0.1 * cur.net).toFixed(3)})`;
        ctx.lineWidth = 0.7;
        ctx.beginPath();
        for (const [a, b] of net.edges) {
          const i = net.nodes[a], j = net.nodes[b];
          ctx.moveTo(PX[i], PY[i]); ctx.lineTo(PX[j], PY[j]);
        }
        ctx.stroke();
      }
      // 해마 ↔ 피질 연결 (2단계)
      if (cur.mem > 0.02) {
        ctx.strokeStyle = `rgba(255,255,255,${(0.14 * cur.mem).toFixed(3)})`;
        ctx.lineWidth = 0.7;
        ctx.beginPath();
        for (const [a, b] of mem) { ctx.moveTo(PX[a], PY[a]); ctx.lineTo(PX[b], PY[b]); }
        ctx.stroke();
      }

      // 신호 펄스
      if (!reduce && t - lastSpawn > 0.12) {
        lastSpawn = t;
        if (cur.net > 0.3 && net.edges.length) {
          const [a, b] = net.edges[Math.floor(Math.random() * net.edges.length)];
          pulses.push({ a: net.nodes[a], b: net.nodes[b], t0: t, dur: 0.6 + Math.random() * 0.4, kind: 'net' });
        }
        if (cur.mem > 0.3 && Math.random() < 0.7) {
          const [a, b] = mem[Math.floor(Math.random() * mem.length)];
          const out = Math.random() < 0.5;
          pulses.push({ a: out ? a : b, b: out ? b : a, t0: t, dur: 0.9 + Math.random() * 0.5, kind: 'mem' });
        }
      }
      pulses = pulses.filter((p) => t - p.t0 < p.dur);
      for (const p of pulses) {
        const u = (t - p.t0) / p.dur, u0 = Math.max(0, u - 0.22);
        const wgt = p.kind === 'net' ? cur.net : cur.mem;
        ctx.strokeStyle = `rgba(255,255,255,${(0.8 * wgt).toFixed(3)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(PX[p.a] + (PX[p.b] - PX[p.a]) * u0, PY[p.a] + (PY[p.b] - PY[p.a]) * u0);
        ctx.lineTo(PX[p.a] + (PX[p.b] - PX[p.a]) * u, PY[p.a] + (PY[p.b] - PY[p.a]) * u);
        ctx.stroke();
      }

      // 깊은 구조: 시상하핵, 해마
      for (const i of deep) {
        const wgt = pts[i].r === REGION.stn ? cur.stn : cur.hip;
        const d = 0.45 + 0.55 * depthOf(PZ[i]);
        const a = Math.min(1, 0.06 + wgt * d);
        if (wgt > 0.3) {
          ctx.fillStyle = `rgba(255,255,255,${(0.07 * wgt).toFixed(3)})`;
          ctx.beginPath(); ctx.arc(PX[i], PY[i], 3.2, 0, 6.2832); ctx.fill();
        }
        ctx.fillStyle = `rgba(255,255,255,${a.toFixed(3)})`;
        ctx.fillRect(PX[i] - 0.2, PY[i] - 0.2, 1.6, 1.6);
      }

      // 이식형 기기와 리드
      const [sx, sy] = P(stnC[0], stnC[1], stnC[2]);
      const [hx, hy] = P(hipC[0], hipC[1], hipC[2]);
      const [ex, ey] = P(stnC[0] + 0.06, 1.12, stnC[2]);         // 두개골 위 진입점
      const [dx, dy] = P(-0.08, 1.12, 0.12);                        // 기기 위치
      if (cur.lead > 0.02) {
        ctx.globalAlpha = cur.lead;
        ctx.strokeStyle = 'rgba(255,255,255,0.85)';
        ctx.lineWidth = 1.2;
        const fromX = cur.device > 0.5 ? dx : ex, fromY = cur.device > 0.5 ? dy : ey;
        ctx.beginPath(); ctx.moveTo(fromX, fromY); ctx.lineTo(sx, sy); ctx.stroke();
        // 전극 접점 4개
        const len = Math.hypot(sx - fromX, sy - fromY) || 1;
        const ux = (sx - fromX) / len, uy = (sy - fromY) / len;
        ctx.fillStyle = '#fff';
        for (let c = 0; c < 4; c++) {
          const px = sx - ux * c * 6, py = sy - uy * c * 6;
          ctx.fillRect(px - 2, py - 2, 4, 4);
        }
        // 자극 파동
        if (!reduce) {
          const ph = (t % 1.2) / 1.2;
          ctx.strokeStyle = `rgba(255,255,255,${(0.5 * (1 - ph)).toFixed(3)})`;
          ctx.beginPath(); ctx.arc(sx, sy, 6 + ph * 34, 0, 6.2832); ctx.stroke();
        }
        ctx.globalAlpha = 1;
      }
      if (cur.device > 0.02) {
        ctx.globalAlpha = cur.device;
        ctx.strokeStyle = 'rgba(255,255,255,0.85)';
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(dx, dy); ctx.lineTo(hx, hy); ctx.stroke();
        ctx.fillStyle = '#000';
        ctx.beginPath(); ctx.roundRect(dx - 22, dy - 9, 44, 18, 9); ctx.fill(); ctx.stroke();
        ctx.fillStyle = '#fff';
        ctx.beginPath(); ctx.arc(dx + 12, dy, 2.2, 0, 6.2832); ctx.fill();
        ctx.globalAlpha = 1;
      }

      // 구조 이름표
      const side = mobile ? -1 : 1;
      label(sx, sy, 90 * side, 58, 'Subthalamic nucleus', Math.max(0, (cur.stn - 0.5) * 2) * (stage === 3 ? 0 : 1));
      label(hx, hy, -96, 54, 'Hippocampus', Math.max(0, (cur.hip - 0.5) * 2) * (stage === 3 ? 0 : 1));
      label(dx, dy, 70, -34, 'Implant', cur.device);

      // 조준 프레임
      const bx = scale * 1.34, by = scale * 1.14, L = 14;
      ctx.strokeStyle = 'rgba(255,255,255,0.28)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (const [qx, qy] of [[-1, -1], [1, -1], [1, 1], [-1, 1]]) {
        const x0 = cx + qx * bx, y0 = cy + qy * by;
        ctx.moveTo(x0, y0 - qy * L); ctx.lineTo(x0, y0); ctx.lineTo(x0 - qx * L, y0);
      }
      ctx.stroke();
    }

    // 스크롤 위치에 따라 단계 바꾸기
    const hudEls = ['phase', 'target', 'mode'].map((k) => document.querySelector<HTMLElement>(`[data-vh="${k}"]`));
    function setStage(n: number) {
      if (n === stage) return;
      stage = n;
      HUD[n].forEach((v, i) => { if (hudEls[i]) hudEls[i]!.textContent = v; });
      if (reduce) draw(0, 1);
    }
    const steps = [...document.querySelectorAll<HTMLElement>('.vision .step')];
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) setStage(Number((e.target as HTMLElement).dataset.stage));
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s));

    layout();
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { layout(); if (reduce) draw(0, 1); }, 150);
    });

    if (reduce) draw(0, 1);
    else {
      let running = false, prev = 0, start = performance.now();
      const loop = (now: number) => {
        if (!running) return;
        const t = (now - start) / 1000;
        draw(t, Math.min(0.05, t - prev)); prev = t;
        requestAnimationFrame(loop);
      };
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; prev = (performance.now() - start) / 1000; requestAnimationFrame(loop); }
        else if (!e.isIntersecting) running = false;
      }).observe(document.querySelector('.vision .scrolly')!);
    }
  }
</script>
