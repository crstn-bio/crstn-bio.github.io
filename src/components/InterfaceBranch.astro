---
// MINIMIZE → INTERFACE: 고밀도로 찾아보고(발견) → 모델이 충분한 정보를 고르고 → "이 정보를 이식해야 하나?"
//   예 → 만성 심부 인터페이스, 아닐 수도 → 피질·비침습 대리 신호. 둘 다 같은 모델로 돌아가요.
const sites = Array.from({ length: 26 }, (_, i) => ({ r: Math.floor(i / 2), c: i % 2, keep: [3, 8, 15, 20].includes(i) }));
---
<figure class="ib" aria-label="From discovery to interface: a high-density probe measures many sites; the model identifies the few that carry sufficient information; then a decision: implant this information or not. Yes leads to a chronic deep interface; maybe not leads to cortical or non-invasive surrogate signals. Both feed the same brain model.">
  <!-- 가로 -->
  <svg class="h" viewBox="0 0 1040 330" aria-hidden="true">
    <defs>
      <marker id="ib-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#8a8a8a" stroke-width="1.4" /></marker>
      <path id="ib-yes" d="M560 131 V80 H1010 V175 H980" />
      <path id="ib-no" d="M560 219 V318 H1010 V175 H980" />
    </defs>
    <text class="k" x="100" y="24" text-anchor="middle">DISCOVERY</text>
    <text class="k" x="330" y="24" text-anchor="middle">MODEL IDENTIFIES</text>
    <text class="k" x="560" y="24" text-anchor="middle">TRANSLATION</text>

    <!-- 고밀도 탐침 -->
    <rect class="shank" x="88" y="44" width="24" height="262" rx="2" />
    {sites.map((s, i) => <rect class="site flick" style={`--d:${((i * 0.37) % 2).toFixed(2)}s`} x={92 + s.c * 10} y={52 + s.r * 19} width="6" height="6" />)}
    <text class="s" x="100" y="324" text-anchor="middle">many sites</text>
    <path class="ln" d="M130 175 H290" marker-end="url(#ib-a)" />

    <!-- 충분한 정보만 -->
    <rect class="shank" x="318" y="44" width="24" height="262" rx="2" />
    {sites.map((s) => <rect class={s.keep ? 'site keep' : 'site drop'} x={322 + s.c * 10} y={52 + s.r * 19} width="6" height="6" />)}
    <text class="s a" x="330" y="324" text-anchor="middle">sufficient information</text>
    <path class="ln" d="M360 175 H508" marker-end="url(#ib-a)" />

    <!-- 결정 -->
    <path class="dia" d="M560 131 L604 175 L560 219 L516 175 Z" />
    <text class="s w" x="560" y="180" text-anchor="middle">implant?</text>
    <path class="ln" d="M560 131 V80 H646 M668 80 H1010 V175 M560 219 V318 H1010 V175 M1010 175 H980" marker-end="url(#ib-a)" />

    <!-- 예: 만성 심부 인터페이스 -->
    <rect class="lead" x="652" y="40" width="10" height="80" rx="5" />
    {[86, 98, 110].map((y) => <rect class="contact" x="652" y={y} width="10" height="6" />)}
    <text class="s a" x="684" y="42">YES</text>
    <text class="s w" x="684" y="64">chronic deep interface</text>

    <!-- 아닐 수도: 피질·비침습 대리 신호 -->
    <path class="head" d="M622 300 A36 36 0 0 1 694 300" />
    {[[628, 284], [642, 270], [674, 270], [688, 284]].map(([x, y]) => <circle class="sensor" cx={x} cy={y} r="4" />)}
    <path class="deep" d="M640 300 Q650 286 658 300 T676 300" />
    <text class="s a" x="716" y="252">MAYBE NOT</text>
    <text class="s w" x="716" y="274">cortical / non-invasive</text>
    <text class="s" x="716" y="296">surrogate signals</text>

    <!-- 같은 모델 -->
    <rect class="model" x="880" y="150" width="92" height="50" />
    <text class="z" x="926" y="182" text-anchor="middle">z(t)</text>
    <text class="s" x="926" y="138" text-anchor="middle">same model</text>

    <circle class="mv" r="4"><animateMotion dur="5s" repeatCount="indefinite"><mpath href="#ib-yes" /></animateMotion></circle>
    <circle class="mv" r="4"><animateMotion dur="5s" begin="-2.5s" repeatCount="indefinite"><mpath href="#ib-no" /></animateMotion></circle>
  </svg>

  <!-- 세로 (좁은 화면) -->
  <svg class="v" viewBox="0 0 400 820" aria-hidden="true">
    <defs>
      <marker id="ib-av" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#8a8a8a" stroke-width="1.4" /></marker>
    </defs>
    <text class="k" x="200" y="26" text-anchor="middle">DISCOVERY</text>
    <rect class="shank" x="50" y="46" width="300" height="24" rx="2" />
    {sites.map((s, i) => <rect class="site flick" style={`--d:${((i * 0.37) % 2).toFixed(2)}s`} x={60 + s.r * 22} y={50 + s.c * 10} width="6" height="6" />)}
    <text class="s" x="200" y="98" text-anchor="middle">many sites</text>
    <path class="ln" d="M200 108 V150" marker-end="url(#ib-av)" />

    <text class="k" x="200" y="180" text-anchor="middle">MODEL IDENTIFIES</text>
    <rect class="shank" x="50" y="198" width="300" height="24" rx="2" />
    {sites.map((s) => <rect class={s.keep ? 'site keep' : 'site drop'} x={60 + s.r * 22} y={202 + s.c * 10} width="6" height="6" />)}
    <text class="s a" x="200" y="250" text-anchor="middle">sufficient information</text>
    <path class="ln" d="M200 260 V300" marker-end="url(#ib-av)" />

    <path class="dia" d="M200 306 L250 356 L200 406 L150 356 Z" />
    <text class="s w" x="200" y="362" text-anchor="middle">implant?</text>
    <path class="ln" d="M150 356 H100 V440 M250 356 H300 V440" marker-end="url(#ib-av)" />

    <rect class="lead" x="95" y="450" width="10" height="80" rx="5" />
    {[496, 508, 520].map((y) => <rect class="contact" x="95" y={y} width="10" height="6" />)}
    <text class="s a" x="100" y="560" text-anchor="middle">YES</text>
    <text class="s w" x="100" y="584" text-anchor="middle">chronic deep</text>
    <text class="s w" x="100" y="606" text-anchor="middle">interface</text>

    <path class="head" d="M262 520 A38 38 0 0 1 338 520" />
    {[[268, 503], [283, 489], [317, 489], [332, 503]].map(([x, y]) => <circle class="sensor" cx={x} cy={y} r="4" />)}
    <path class="deep" d="M280 520 Q290 506 298 520 T316 520" />
    <text class="s a" x="300" y="560" text-anchor="middle">MAYBE NOT</text>
    <text class="s w" x="300" y="584" text-anchor="middle">cortical /</text>
    <text class="s w" x="300" y="606" text-anchor="middle">non-invasive</text>

    <path class="ln" d="M100 620 V690 H196 M300 620 V690 H204 M200 690 V716" marker-end="url(#ib-av)" />
    <rect class="model" x="150" y="720" width="100" height="54" />
    <text class="z" x="200" y="754" text-anchor="middle">z(t)</text>
    <text class="s" x="200" y="802" text-anchor="middle">same model</text>
  </svg>
</figure>

<style>
  .ib { --acc: #a8c8ff; margin: 0; border: 1px solid #1f1f1f; background-color: #030303; background-image: linear-gradient(#0d0d0d 1px, transparent 1px), linear-gradient(90deg, #0d0d0d 1px, transparent 1px); background-size: 20px 20px; padding: clamp(12px, 2vw, 24px); }
  .ib svg { display: block; width: 100%; height: auto; }
  .ib .v { display: none; }
  .k { fill: #7d7d7d; font: 13px var(--mono); letter-spacing: 0.12em; }
  .s { fill: #8a8a8a; font: 14px var(--mono); }
  .s.a { fill: var(--acc); } .s.w { fill: #e6e6e6; }
  .z { fill: var(--acc); font: 20px var(--mono); }
  .ln { fill: none; stroke: #8a8a8a; stroke-width: 1.2; }
  .shank { fill: #050505; stroke: #8a8a8a; }
  .site { fill: #d6d6d6; }
  .site.keep { fill: var(--acc); }
  .site.drop { fill: #d6d6d6; }
  .dia { fill: #050505; stroke: #bdbdbd; }
  .lead { fill: #050505; stroke: #d6d6d6; }
  .contact { fill: #d6d6d6; }
  .head { fill: none; stroke: #d6d6d6; stroke-width: 1.3; }
  .sensor { fill: #050505; stroke: var(--acc); }
  .deep { fill: none; stroke: var(--acc); stroke-dasharray: 3 3; }
  .model { fill: #060a10; stroke: var(--acc); }
  .mv { fill: var(--acc); }
  .run .flick { animation: ib-flick 2s steps(2) infinite; animation-delay: var(--d); }
  .run .drop { animation: ib-drop 6s ease-in-out infinite; }
  .run .deep { animation: ib-dash 1.2s linear infinite; }
  @keyframes ib-flick { 0% { opacity: 1; } 50% { opacity: .35; } }
  @keyframes ib-drop { 0%, 15% { opacity: 1; } 45%, 85% { opacity: .1; } 100% { opacity: 1; } }
  @keyframes ib-dash { to { stroke-dashoffset: -12; } }
  .ib .drop { opacity: .1; }
  @media (max-width: 760px) {
    .ib .h { display: none; }
    .ib .v { display: block; }
    .ib .v .k, .ib .v .s { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .run .flick, .run .drop, .run .deep { animation: none; }
    .ib .mv { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ib').forEach((el) => {
    const svgs = [...el.querySelectorAll<SVGSVGElement>('svg')];
    new IntersectionObserver(([e]) => {
      el.classList.toggle('run', e.isIntersecting);
      svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations()));
    }, { threshold: 0.15 }).observe(el);
  });
</script>
