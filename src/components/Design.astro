---
// 02 · 구체적 설계
// 탭(Thesis / Parkinson's / Alzheimer's)을 누르면 뇌가 해당 표적 쪽으로 돌아가고,
// 오른쪽에 해부학적 위치, 아래에 엔지니어링 도안이 바뀌어요.
// 모든 그림은 코드로 그린 도식이에요. 실제 환자 데이터가 아니에요.
// 기억 도안용 5×5 패턴: 저장된 패턴, 부분만 해독된 패턴, 그 차이
const stored = [0,1,1,0,0, 1,0,1,1,0, 0,1,0,1,1, 1,1,0,0,1, 0,0,1,1,0];
const decoded = stored.map((v, i) => (v && [2, 5, 13, 16, 22].includes(i) ? 0 : v));
const diff = stored.map((v, i) => (v && !decoded[i] ? 1 : 0));
const cells = (bits: number[], x0: number, kind: string) =>
  bits.map((v, i) => ({ x: x0 + (i % 5) * 22, y: 106 + Math.floor(i / 5) * 22, v, kind }));
const grids = [...cells(decoded, 170, 'w'), ...cells(stored, 330, 'w'), ...cells(diff, 470, 'a')];

// 두피·두개골·피질을 타원으로, 피질에는 이랑(볼록)과 고랑(오목)을 넣어요.
const arc = (rx: number, ry: number) => `M${300 - rx} 410 A${rx} ${ry} 0 0 1 ${300 + rx} 410`;
const cortexPath = (() => {
  const pts: string[] = [];
  for (let i = 0; i <= 180; i++) {
    const th = Math.PI - (i / 180) * Math.PI;
    const r = 1 - 0.035 * Math.pow(0.5 + 0.5 * Math.cos(16 * th + Math.PI), 16);
    pts.push(`${(300 + 222 * r * Math.cos(th)).toFixed(1)} ${(410 - 234 * r * Math.sin(th)).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
})();

const targets = [
  {
    key: 'thesis',
    when: 'Now',
    name: 'Thesis',
    target: 'M1 · a-tbTUS + FES',
    kicker: 'Now · honours thesis, Krembil Brain Institute',
    title: 'Focused ultrasound on motor cortex, paired with movement',
    anatomy: [
      ['Structure', 'Primary motor cortex (M1), Brodmann area 4'],
      ['Location', 'Precentral gyrus, directly in front of the central sulcus, on the lateral and upper surface of the frontal lobe'],
      ['Depth', 'Cortical surface, roughly 1–2 cm beneath the scalp'],
      ['Why here', 'Motor cortex output can be measured at the muscle, so changes in its excitability are observable'],
    ],
    loop: ['a-tbTUS → M1', 'FES → muscle', 'Combined session', 'Measure response'],
    question: 'Does pairing focused ultrasound with functional electrical stimulation change motor cortex more than either on its own?',
    note: '',
  },
  {
    key: 'pd',
    when: 'Next',
    name: 'Parkinson’s',
    target: 'STN · closed-loop DBS',
    kicker: 'Next · the first step of the vision',
    title: 'Closed-loop deep brain stimulation of the subthalamic nucleus',
    anatomy: [
      ['Structure', 'Subthalamic nucleus (STN), both hemispheres'],
      ['Location', 'Small lens-shaped nucleus in the ventral diencephalon, below the thalamus and zona incerta, above the substantia nigra, medial to the internal capsule'],
      ['Coordinates', 'Typical indirect target ≈ 11–13 mm lateral, 2–4 mm posterior, 4–6 mm inferior to the mid-commissural point, refined per patient with imaging and microelectrode recording'],
      ['Why here', 'The DBS lead already sits in the circuit and can record local field potentials; beta-band (13–30 Hz) activity tracks bradykinesia and rigidity in many patients'],
    ],
    loop: ['LFP · beta', 'State z(t)', 'Patient model', 'DBS amplitude'],
    question: 'How little patient-specific data is enough to learn a new brain?',
    note: '',
  },
  {
    key: 'ad',
    when: 'Later',
    name: 'Alzheimer’s',
    target: 'Hippocampus · memory',
    kicker: 'Later · extending the loop to memory',
    title: 'Decoding and restoring memory-related activity in the hippocampus',
    anatomy: [
      ['Structure', 'Hippocampal formation: dentate gyrus, CA3, CA1 and subiculum'],
      ['Location', 'Medial temporal lobe, forming the floor of the temporal horn of the lateral ventricle, running from the head (front) to the tail, which curves up behind the thalamus'],
      ['Circuit', 'Entorhinal cortex → dentate gyrus → CA3 → CA1 → subiculum; the recurrent CA3 network supports recall from partial cues'],
      ['Why here', 'Among the earliest regions affected in Alzheimer’s disease, and central to forming and retrieving episodic memory'],
    ],
    loop: ['Spikes + LFP', 'Representation', 'Memory model', 'Patterned stimulation'],
    question: 'What remains when memory becomes inaccessible, and can it be written back?',
    note: 'Speculative extension, not an existing method.',
  },
];
---
<section class="design" id="design" aria-labelledby="design-h">
  <div class="wrap">
    <div class="d-head">
      <div>
        <p class="kicker mono">02 / The design</p>
        <h2 id="design-h">Three targets, one loop.</h2>
      </div>
      <p>Choose a stage. The model turns to the target, shows where it sits in the brain, and how I would reach it.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Stage">
      {targets.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-target={t.key}>
          <span class="t-when mono">{String(i + 1).padStart(2, '0')} · {t.when}</span>
          <span class="t-name">{t.name}</span>
          <span class="t-target mono">{t.target}</span>
        </button>
      ))}
    </div>

    <div class="stage">
      <div class="viewport">
        <canvas id="design-brain" aria-hidden="true"></canvas>
        <dl class="hud mono" aria-hidden="true">
          <div><dt>View</dt><dd data-hud="view">lateral, from above</dd></div>
          <div><dt>Target</dt><dd data-hud="target">M1</dd></div>
          <div><dt>Yaw</dt><dd data-hud="yaw">0°</dd></div>
        </dl>
        <p class="hint mono" aria-hidden="true">Drag to rotate</p>
      </div>

      <div class="panels">
        {targets.map((t, i) => (
          <div class="panel" role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={i !== 0}>
            <p class="p-kicker mono">{t.kicker}</p>
            <h3>{t.title}</h3>
            <dl class="anatomy">
              {t.anatomy.map(([k, v]) => (<div><dt class="mono">{k}</dt><dd>{v}</dd></div>))}
            </dl>
            <ol class="chips mono" aria-label="Loop">
              {t.loop.map((c, i) => (<><li>{c}</li>{i < t.loop.length - 1 && <li class="sep" aria-hidden="true">→</li>}</>))}
            </ol>
            <p class="q">{t.question}</p>
            {t.note && <p class="note mono">{t.note}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- 엔지니어링 도안: 탭마다 하나씩, 두 장씩 -->
    <figure class="dwg">
      <div class="dwg-bar mono">
        <span>Engineering drawing</span>
        <span data-dwg-id>DWG-01 · a-tbTUS + FES</span>
        <span>Schematic · not to scale</span>
      </div>
      <p class="swipe mono" aria-hidden="true">Swipe sideways to see the full drawing →</p>

      <!-- DWG-01 Thesis -->
      <div class="sheets" data-dwg="thesis">
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Coronal schematic: a focused ultrasound transducer on the scalp, its beam passing the skull and converging to a focal zone in the primary motor cortex.">
          <text class="h" x="24" y="34">A · Focus geometry</text><text class="s" x="24" y="54">coronal section through M1</text>
          <path class="ln" d={arc(260, 280)} />
          <path class="ln dim" d={arc(244, 262)} /><path class="ln dim" d={arc(232, 248)} />
          <path class="ln" d={cortexPath} />
          <rect class="box" x="236" y="80" width="128" height="34" />
          <path class="ln" d="M242 114 Q300 136 358 114" />
          <path class="beam" d="M248 120 L297 196 M352 120 L303 196" />
          <ellipse class="acc-fill" cx="300" cy="198" rx="8" ry="20" />
          <path class="acc" d="M300 150 L300 236" stroke-dasharray="2 4" />
          <path class="dim" d="M366 130 L412 130 M312 198 L412 198 M404 130 L404 198" />
          <rect class="tag" x="410" y="154" width="74" height="22" /><text class="t" x="416" y="170">≈ 1–2 cm</text>
          <path class="lead" d="M364 96 L428 74" /><text class="t" x="434" y="78">Focused transducer</text>
          <path class="lead" d="M276 126 L176 100" /><text class="t" x="24" y="104">Coupling gel</text>
          <path class="lead" d="M72 146 L212 146" /><text class="t" x="24" y="150">Scalp</text>
          <path class="lead" d="M72 176 L188 176" /><text class="t" x="24" y="180">Skull</text>
          <path class="lead" d="M80 206 L192 206" /><text class="t" x="24" y="210">Cortex</text>
          <path class="lead acc" d="M308 206 L430 244" />
          <rect class="tag acc-box" x="430" y="226" width="146" height="62" />
          <text class="t acc-t" x="440" y="246">Focal zone</text><text class="t" x="440" y="264">M1, precentral</text><text class="t" x="440" y="280">gyrus</text>
        </svg></div>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Timing schematic: theta-burst ultrasound bursts every 200 milliseconds, and functional electrical stimulation combined in the same session.">
          <text class="h" x="24" y="34">B · Combined protocol</text><text class="s" x="24" y="54">timing illustrative</text>
          <text class="t" x="24" y="122">a-tbTUS</text>
          <path class="ln dim" d="M120 130 L576 130" />
          <g class="acc">
            <path d="M130 130 V100 M136 130 V100 M142 130 V100" /><path d="M218 130 V100 M224 130 V100 M230 130 V100" />
            <path d="M306 130 V100 M312 130 V100 M318 130 V100" /><path d="M394 130 V100 M400 130 V100 M406 130 V100" />
            <path d="M482 130 V100 M488 130 V100 M494 130 V100" />
          </g>
          <path class="dim" d="M136 150 L224 150 M136 144 L136 156 M224 144 L224 156" /><text class="t" x="150" y="172">200 ms · 5 Hz</text>
          <path class="lead" d="M142 96 L170 76" /><text class="t" x="176" y="78">burst</text>
          <text class="t" x="24" y="232">FES</text>
          <path class="ln dim" d="M120 240 L576 240" />
          <rect class="box" x="130" y="212" width="370" height="28" />
          <path class="ln" d="M140 240 V216 M150 240 V216 M160 240 V216 M170 240 V216 M180 240 V216 M190 240 V216 M200 240 V216 M210 240 V216 M220 240 V216 M230 240 V216 M240 240 V216 M250 240 V216 M260 240 V216 M270 240 V216 M280 240 V216 M290 240 V216 M300 240 V216 M310 240 V216 M320 240 V216 M330 240 V216 M340 240 V216 M350 240 V216 M360 240 V216 M370 240 V216 M380 240 V216 M390 240 V216 M400 240 V216 M410 240 V216 M420 240 V216 M430 240 V216 M440 240 V216 M450 240 V216 M460 240 V216 M470 240 V216 M480 240 V216 M490 240 V216" />
          <text class="t" x="130" y="266">stimulation of the target muscle</text>
          <path class="dim" d="M112 90 L104 90 L104 250 L112 250" /><text class="t" x="24" y="176">same</text><text class="t" x="24" y="194">session</text>
          <text class="t" x="24" y="342">Measure</text>
          <path class="ln dim" d="M120 350 L576 350" />
          <path class="ln" d="M520 350 V318 L540 318 V350" />
          <text class="t" x="352" y="312">neurophysiological outcome</text>
          <path class="ln dim" d="M120 390 L576 390" />
          <text class="s" x="120" y="410">time →</text>
        </svg></div>
      </div>

      <!-- DWG-02 Parkinson's -->
      <div class="sheets" data-dwg="pd" hidden>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Coronal schematic: a DBS lead with four ring contacts passes the thalamus and zona incerta and ends in the subthalamic nucleus, above the substantia nigra.">
          <text class="h" x="24" y="34">A · Lead in target</text><text class="s" x="24" y="54">coronal, schematic</text>
          <path class="ln" d="M84 172 C92 124 240 112 286 140 C318 162 300 202 230 210 C160 218 80 214 84 172 Z" />
          <text class="t" x="110" y="176">Thalamus</text>
          <path class="ln dim" d="M120 232 C180 222 260 222 330 236" /><text class="s" x="96" y="250">zona incerta</text>
          <ellipse class="acc-fill soft" cx="262" cy="276" rx="74" ry="22" transform="rotate(-18 262 276)" />
          <ellipse class="acc" cx="262" cy="276" rx="74" ry="22" transform="rotate(-18 262 276)" />
          <path class="ln" d="M150 340 C220 318 300 300 380 300 C400 312 380 330 330 338 C260 348 200 360 150 356 Z" />
          <text class="t" x="96" y="382">Substantia nigra</text>
          <path class="ln dim" d="M432 150 L398 330 M462 150 L430 330" /><text class="s" x="470" y="176">internal</text><text class="s" x="470" y="192">capsule</text>
          <!-- lead -->
          <g transform="rotate(12 262 276)">
            <rect class="lead-body" x="255" y="40" width="14" height="250" rx="7" />
            <rect class="contact" x="255" y="276" width="14" height="10" /><rect class="contact" x="255" y="258" width="14" height="10" />
            <rect class="contact" x="255" y="240" width="14" height="10" /><rect class="contact" x="255" y="222" width="14" height="10" />
          </g>
          <path class="lead acc" d="M300 296 L470 330" /><text class="t acc-t" x="476" y="334">STN</text>
          <text class="t" x="476" y="352">subthalamic</text><text class="t" x="476" y="370">nucleus</text>
          <path class="lead" d="M300 96 L352 76" /><text class="t" x="358" y="74">DBS lead</text><text class="s" x="358" y="92">4 ring contacts</text>
        </svg></div>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Closed loop: STN local field potential beta power is estimated, a patient model sets stimulation amplitude, and the effect is measured again. A small plot shows amplitude rising when beta crosses a threshold.">
          <text class="h" x="24" y="34">B · Closed loop</text><text class="s" x="24" y="54">per patient</text>
          <rect class="box" x="24" y="84" width="124" height="52" /><text class="t" x="36" y="106">Sense</text><text class="s" x="36" y="124">LFP · 13–30 Hz</text>
          <rect class="box" x="170" y="84" width="124" height="52" /><text class="t" x="182" y="106">Estimate</text><text class="s" x="182" y="124">state z(t)</text>
          <rect class="box acc-box" x="316" y="84" width="124" height="52" /><text class="t acc-t" x="328" y="106">Patient model</text><text class="s" x="328" y="124">per person</text>
          <rect class="box" x="462" y="84" width="114" height="52" /><text class="t" x="474" y="106">Stimulate</text><text class="s" x="474" y="124">set amplitude</text>
          <path class="arrow" d="M148 110 L166 110 M294 110 L312 110 M440 110 L458 110" />
          <path class="arrow" d="M519 136 V162 H86 V140" /><text class="s" x="232" y="180">effect appears in the next recording</text>
          <!-- plot -->
          <path class="ln dim" d="M60 380 L576 380 M60 380 L60 220" />
          <text class="s" x="24" y="226">beta</text>
          <path class="ln" d="M60 330 C110 326 140 322 170 300 C200 270 220 250 250 256 C280 262 300 300 330 312 C370 322 420 318 470 322 C510 326 540 328 576 330" />
          <path class="acc" d="M60 290 L576 290" stroke-dasharray="5 5" /><text class="s acc-t" x="500" y="282">threshold</text>
          <path class="acc thick" d="M60 372 L196 372 L206 344 L300 344 L312 372 L576 372" />
          <text class="s" x="24" y="376">amp</text>
          <text class="s" x="210" y="402">stimulation rises only while beta is high</text>
        </svg></div>
      </div>

      <!-- DWG-03 Alzheimer's -->
      <div class="sheets" data-dwg="ad" hidden>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Hippocampal circuit schematic: entorhinal cortex to dentate gyrus, to CA3, to CA1, to subiculum, and back to entorhinal cortex.">
          <text class="h" x="24" y="34">A · Hippocampal circuit</text><text class="s" x="24" y="54">cross-section, schematic</text>
          <path class="ln" d="M150 300 C120 250 130 170 200 140 C270 112 360 124 400 170 C430 206 420 250 390 266" />
          <path class="ln" d="M210 280 C190 250 196 206 232 192 C268 180 300 196 306 226 C312 256 286 276 258 276" />
          <text class="t" x="232" y="244">DG</text>
          <text class="t" x="130" y="206">CA3</text>
          <text class="t acc-t" x="410" y="160">CA1</text>
          <path class="ln" d="M390 266 C400 300 440 318 490 318" /><text class="t" x="470" y="344">Subiculum</text>
          <rect class="box" x="40" y="330" width="168" height="44" /><text class="t" x="52" y="357">Entorhinal cortex</text>
          <path class="arrow" d="M150 330 C170 310 200 300 222 288" /><text class="s" x="150" y="392">perforant path</text>
          <path class="arrow" d="M214 262 C186 250 164 232 156 214" /><text class="s" x="40" y="250">mossy fibres</text>
          <path class="arrow acc thick" d="M176 162 C230 120 330 118 386 150" /><text class="s acc-t" x="230" y="108">Schaffer collaterals</text>
          <path class="arrow" d="M500 330 C470 390 280 400 210 360" />
          <path class="ln dim" d="M150 176 C120 170 118 146 140 142 C160 138 166 158 152 170" /><text class="s" x="40" y="146">recurrent</text>
        </svg></div>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Speculative concept: a high-density probe records the hippocampus, the decoded pattern is compared with a stored pattern, and the difference defines patterned stimulation.">
          <text class="h" x="24" y="34">B · Record → compare → write</text><text class="s acc-t" x="24" y="54">speculative</text>
          <!-- probe -->
          <rect class="box" x="40" y="80" width="40" height="30" />
          <path class="lead-body" d="M54 110 L54 360 L60 376 L66 360 L66 110 Z" />
          <g class="sites">
            <rect x="56" y="190" width="3" height="3" /><rect x="61" y="198" width="3" height="3" /><rect x="56" y="206" width="3" height="3" /><rect x="61" y="214" width="3" height="3" />
            <rect x="56" y="222" width="3" height="3" /><rect x="61" y="230" width="3" height="3" /><rect x="56" y="238" width="3" height="3" /><rect x="61" y="246" width="3" height="3" />
            <rect x="56" y="254" width="3" height="3" /><rect x="61" y="262" width="3" height="3" /><rect x="56" y="270" width="3" height="3" /><rect x="61" y="278" width="3" height="3" />
            <rect x="56" y="286" width="3" height="3" /><rect x="61" y="294" width="3" height="3" /><rect x="56" y="302" width="3" height="3" /><rect x="61" y="310" width="3" height="3" />
            <rect x="56" y="318" width="3" height="3" /><rect x="61" y="326" width="3" height="3" /><rect x="56" y="334" width="3" height="3" /><rect x="61" y="342" width="3" height="3" />
          </g>
          <path class="dim" d="M92 110 L92 376 M86 110 L98 110 M86 376 L98 376" /><text class="s" x="100" y="246">45 mm</text>
          <text class="t" x="24" y="404">Neuropixels 1.0 NHP · 4,416 sites · 384 ch</text>
          <!-- patterns -->
          <text class="s" x="170" y="96">decoded</text>
          <g class="grids">
            {grids.map((c) => <rect x={c.x} y={c.y} width="18" height="18" class={c.v ? (c.kind === 'a' ? 'on-a' : 'on') : 'off'} />)}
          </g>
          <text class="s" x="330" y="96">stored</text>
          <text class="s acc-t" x="470" y="96">difference</text>
          <path class="arrow" d="M290 170 L316 170 M450 170 L466 170" />
          <path class="arrow acc" d="M530 222 L530 262" />
          <rect class="box acc-box" x="360" y="268" width="216" height="52" />
          <text class="t acc-t" x="372" y="290">Patterned stimulation</text><text class="s" x="372" y="308">future implant</text>
          <text class="s" x="170" y="354">The probe records, to learn the code.</text>
          <text class="s" x="170" y="372">It does not stimulate.</text>
        </svg></div>
      </div>

      <figcaption class="mono">Drawn in code for illustration. Anatomy is simplified; device figures are representative, not a specific surgical plan.</figcaption>
    </figure>

    <div class="basis">
      <p class="mono">Research basis</p>
      <div>
        <a href="https://www.nature.com/articles/s41586-025-08993-1" target="_blank" rel="noreferrer">Ko et al., Nature 2025 · DG→CA3→CA1 engram circuitry reorganizes over time ↗</a>
        <a href="https://www.nature.com/articles/nrn4000" target="_blank" rel="noreferrer">Josselyn, Köhler &amp; Frankland · engram identification and reactivation ↗</a>
        <a href="https://www.neuropixels.org/probe-1-0-nhp-long" target="_blank" rel="noreferrer">Neuropixels 1.0 NHP Long · high-density deep recording ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .design { --acc: #a8c8ff; background: #000; border-top: 1px solid var(--rule); padding-block: clamp(80px, 11vw, 140px); color: #fff; }
  .kicker { color: var(--muted); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 14px; }
  .d-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px var(--gutter); align-items: end; }
  .d-head h2 { margin: 0; font-size: clamp(32px, 4.2vw, 56px); font-weight: 300; letter-spacing: -0.035em; line-height: 1.05; }
  .d-head > p { margin: 0; color: #a9a9a9; font-size: 17px; line-height: 1.65; max-width: 46ch; }

  /* 탭 */
  .tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: clamp(36px, 5vw, 56px); border-bottom: 1px solid #222; }
  .tabs button {
    font: inherit; text-align: left; color: #8d8d8d; background: none; border: 0; border-top: 1px solid #333;
    padding: 18px 20px 20px 0; cursor: pointer; display: grid; gap: 6px; position: relative; transition: color 200ms;
  }
  .tabs button::before { content: ''; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: #fff; transition: width 500ms cubic-bezier(.2,.7,.2,1); }
  .tabs button[aria-selected='true'] { color: #fff; }
  .tabs button[aria-selected='true']::before { width: 100%; }
  .tabs button:hover { color: #fff; }
  .t-when { letter-spacing: 0.12em; text-transform: uppercase; color: inherit; opacity: 0.8; }
  .t-name { font-size: clamp(20px, 2vw, 26px); font-weight: 400; letter-spacing: -0.02em; }
  .t-target { color: #8d8d8d; }
  .tabs button[aria-selected='true'] .t-target { color: var(--acc); }

  /* 뇌 + 설명 */
  .stage { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 0 clamp(24px, 4vw, 56px); margin-top: 28px; }
  .viewport { position: relative; aspect-ratio: 5 / 4; border: 1px solid #1c1c1c; background: radial-gradient(80% 70% at 50% 50%, #0b0b0b, #000); touch-action: pan-y; cursor: grab; }
  .viewport:active { cursor: grabbing; }
  .viewport canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hud { position: absolute; left: 16px; top: 14px; margin: 0; display: grid; grid-template-columns: auto auto; gap: 4px 14px; pointer-events: none; }
  .hud div { display: contents; }
  .hud dt { color: #6f6f6f; }
  .hud dd { margin: 0; color: #d9d9d9; }
  .hint { position: absolute; right: 16px; bottom: 12px; margin: 0; color: #5f5f5f; pointer-events: none; }

  .panel { padding-top: 4px; }
  .panel:focus-visible { outline-offset: 8px; }
  .p-kicker { color: var(--acc); letter-spacing: 0.06em; margin: 0 0 12px; }
  .panel h3 { font-size: clamp(22px, 2.2vw, 28px); font-weight: 400; letter-spacing: -0.02em; line-height: 1.2; margin: 0 0 20px; }
  .anatomy { margin: 0; border-top: 1px solid #222; }
  .anatomy div { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 12px; padding: 11px 0; border-bottom: 1px solid #1a1a1a; }
  .anatomy dt { color: #7d7d7d; padding-top: 2px; }
  .anatomy dd { margin: 0; color: #cfcfcf; font-size: 14.5px; line-height: 1.55; }
  .chips { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 6px; align-items: center; }
  .chips li { border: 1px solid #333; padding: 5px 9px; color: #d9d9d9; }
  .chips li.sep { border: 0; padding: 0 2px; color: #555; }
  .q { margin: 20px 0 0; color: #fff; font-size: 16px; line-height: 1.5; }
  .note { color: var(--acc); margin: 10px 0 0; }

  /* 도안 */
  .dwg { margin: clamp(40px, 6vw, 64px) 0 0; border: 1px solid #222; background: #030303; }
  .dwg-bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; padding: 12px 16px; border-bottom: 1px solid #222; color: #7d7d7d; text-transform: uppercase; letter-spacing: 0.08em; }
  .dwg-bar [data-dwg-id] { color: #fff; }
  .swipe { display: none; margin: 0; padding: 10px 16px 0; color: #6a6a6a; }
  .sheets { display: grid; grid-template-columns: 1fr 1fr; }
  .sheets[hidden] { display: none; }
  .sheet { background-image: linear-gradient(#0d0d0d 1px, transparent 1px), linear-gradient(90deg, #0d0d0d 1px, transparent 1px); background-size: 20px 20px; }
  .sheet + .sheet { border-left: 1px solid #222; }
  .sheet svg { display: block; width: 100%; height: auto; }
  .dwg figcaption { padding: 12px 16px; border-top: 1px solid #222; color: #6a6a6a; }

  svg .h { fill: #fff; font: 500 16px var(--sans); letter-spacing: -0.01em; }
  svg .s { fill: #8a8a8a; font: 12.5px var(--mono); }
  svg .t { fill: #d6d6d6; font: 13.5px var(--mono); }
  svg .acc-t { fill: var(--acc); }
  svg .ln { fill: none; stroke: #cfcfcf; stroke-width: 1.2; }
  svg .ln.dim, svg path.dim { stroke: #555; }
  svg .dim { fill: none; stroke: #6a6a6a; stroke-width: 1; }
  svg .lead { fill: none; stroke: #8a8a8a; stroke-width: 1; }
  svg .box { fill: #050505; stroke: #bdbdbd; stroke-width: 1.1; }
  svg .acc-box { stroke: var(--acc); }
  svg .acc, svg g.acc path { fill: none; stroke: var(--acc); stroke-width: 1.3; }
  svg .acc.thick, svg .thick { stroke-width: 2; }
  svg .acc-fill { fill: var(--acc); fill-opacity: 0.55; stroke: none; }
  svg .acc-fill.soft { fill-opacity: 0.14; }
  svg .tag { fill: #030303; stroke: #333; stroke-width: 1; }
  svg .tag.acc-box { stroke: var(--acc); }
  svg .beam { fill: none; stroke: #8a8a8a; stroke-width: 1; stroke-dasharray: 3 3; }
  svg .lead-body { fill: #0a0a0a; stroke: #e0e0e0; stroke-width: 1.2; }
  svg .contact { fill: var(--acc); }
  svg .sites rect { fill: var(--acc); }
  svg .grids .off { fill: none; stroke: #2a2a2a; }
  svg .grids .on { fill: #d6d6d6; }
  svg .grids .on-a { fill: var(--acc); }
  svg .arrow { fill: none; stroke: #bdbdbd; stroke-width: 1.2; marker-end: url(#dwg-arrow); }
  svg .arrow.acc { stroke: var(--acc); marker-end: url(#dwg-arrow-acc); }

  .basis { display: grid; grid-template-columns: 170px 1fr; gap: 12px 24px; margin-top: 28px; padding-top: 20px; border-top: 1px solid #1a1a1a; }
  .basis > p { margin: 0; color: #6a6a6a; letter-spacing: 0.1em; text-transform: uppercase; }
  .basis > div { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .basis a { color: #8d8d8d; text-decoration: none; font-size: 13.5px; line-height: 1.5; }
  .basis a:hover { color: #fff; }

  @media (max-width: 960px) {
    .d-head, .stage { grid-template-columns: 1fr; }
    .panels { margin-top: 24px; }
    .sheets { grid-template-columns: 1fr; }
    .sheet + .sheet { border-left: 0; border-top: 1px solid #222; }
    .sheet { overflow-x: auto; }
    .sheet svg { min-width: 540px; }
    .swipe { display: block; }
  }
  @media (max-width: 600px) {
    .tabs { grid-template-columns: 1fr; border-bottom: 0; }
    .tabs button { padding: 14px 0; grid-template-columns: auto 1fr; column-gap: 12px; align-items: baseline; }
    .tabs button .t-target { grid-column: 1 / -1; }
    .tabs button::before { width: 0; }
    .tabs button[aria-selected='true']::before { width: 40px; }
    .viewport { aspect-ratio: 1 / 1.05; }
    .hud { top: auto; bottom: 12px; }
    .hud div:last-child { display: none; }
    .hint { display: none; }
    .anatomy div { grid-template-columns: 1fr; gap: 4px; }
    .basis { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .tabs button::before { transition: none; } }
</style>

<!-- SVG 화살표 머리 (한 번만 정의) -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <marker id="dwg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#bdbdbd" stroke-width="1.4" /></marker>
    <marker id="dwg-arrow-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#a8c8ff" stroke-width="1.4" /></marker>
  </defs>
</svg>

<script>
  import { buildBrain, buildNetwork, makeRng, makeProjector, depthOf, REGION, type BrainPoint } from '../scripts/brain';

  const root = document.querySelector<HTMLElement>('.design');
  const canvas = document.getElementById('design-brain') as HTMLCanvasElement | null;

  if (root && canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ACC = '168,200,255';
    const MONO = '12px "Geist Mono Variable", ui-monospace, monospace';
    type Key = 'thesis' | 'pd' | 'ad';

    // 탭마다의 시점: yaw(좌우 회전), pitch(위아래 기울기), zoom, 피질 밝기
    const VIEWS: Record<Key, { yaw: number; pitch: number; zoom: number; cy: number; cortex: number; view: string; target: string; dwg: string }> = {
      thesis: { yaw: -0.3, pitch: -0.55, zoom: 0.92, cy: 0.6, cortex: 0.72, view: 'lateral, from above', target: 'M1, left precentral gyrus', dwg: 'DWG-01 · a-tbTUS + FES' },
      pd: { yaw: -1.32, pitch: -0.2, zoom: 1.12, cy: 0.52, cortex: 0.24, view: 'anterior oblique', target: 'STN, bilateral', dwg: 'DWG-02 · closed-loop DBS' },
      ad: { yaw: -0.28, pitch: 0.12, zoom: 1.06, cy: 0.52, cortex: 0.24, view: 'lateral, from below', target: 'Hippocampus, bilateral', dwg: 'DWG-03 · hippocampal memory loop' },
    };

    // ── 뇌 모델 ──
    let w = 0, h = 0, mobile = false;
    let pts: BrainPoint[] = [];
    let PX = new Float32Array(0), PY = new Float32Array(0), PZ = new Float32Array(0);
    let m1: number[] = [], stn: number[] = [], hip: number[] = [];
    let m1C = [0, 0, 0], stnL = [0, 0, 0], stnR = [0, 0, 0], hipL = [0, 0, 0], hipC = [0, 0, 0];
    let net = { nodes: [] as number[], edges: [] as [number, number][] };
    const mean = (ids: number[]) => [0, 1, 2].map((k) => ids.reduce((s, i) => s + [pts[i].x, pts[i].y, pts[i].z][k], 0) / Math.max(1, ids.length));

    function build() {
      pts = buildBrain(mobile ? 3800 : 6800, { deep: true, seed: 1729 });
      m1 = []; stn = []; hip = [];
      const cortex: number[] = [];
      pts.forEach((p, i) => {
        if (p.r === REGION.cortex) {
          cortex.push(i);
          // 중심고랑 바로 앞(앞쪽 = +x) 띠를 M1로 표시 (왼쪽 반구, z > 0)
          const y = p.y - 0.14;
          const xc = 0.2 - (0.3 * (y - 0.05)) / 0.65;
          if (p.z > 0.05 && y > 0.18 && y < 0.74 && p.x > xc + 0.02 && p.x < xc + 0.15) m1.push(i);
        } else if (p.r === REGION.stn) stn.push(i);
        else if (p.r === REGION.hippo) hip.push(i);
      });
      m1C = mean(m1);
      stnL = mean(stn.filter((i) => pts[i].z > 0)); stnR = mean(stn.filter((i) => pts[i].z < 0));
      hipL = mean(hip.filter((i) => pts[i].z > 0)); hipC = hipL;
      net = buildNetwork(pts, cortex, mobile ? 90 : 160, makeRng(7), 2, 0.42);
      PX = new Float32Array(pts.length); PY = new Float32Array(pts.length); PZ = new Float32Array(pts.length);
    }

    function layout() {
      const d = Math.min(window.devicePixelRatio || 1, 2), r = canvas!.getBoundingClientRect();
      const was = mobile;
      w = r.width; h = r.height; mobile = w < 560;
      canvas!.width = Math.round(w * d); canvas!.height = Math.round(h * d);
      ctx.setTransform(d, 0, 0, d, 0, 0);
      if (!pts.length || was !== mobile) build();
    }

    // ── 시점 애니메이션 ──
    let active: Key = 'thesis';
    const cur = { ...VIEWS.thesis };
    const from = { ...VIEWS.thesis };
    let animStart = -1, ANIM = 1.4;
    let userYaw = 0, userPitch = 0;
    const weight = { thesis: 1, pd: 0, ad: 0 };
    const easeIO = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

    function go(k: Key, now: number) {
      Object.assign(from, cur, { yaw: cur.yaw + userYaw, pitch: cur.pitch + userPitch });
      userYaw = 0; userPitch = 0;
      active = k; animStart = now;
    }

    function stepView(now: number) {
      const tgt = VIEWS[active];
      const u = reduce || animStart < 0 ? 1 : Math.min(1, (now - animStart) / 1000 / ANIM);
      const e = easeIO(u);
      cur.yaw = from.yaw + (tgt.yaw - from.yaw) * e;
      cur.pitch = from.pitch + (tgt.pitch - from.pitch) * e;
      cur.zoom = from.zoom + (tgt.zoom - from.zoom) * e;
      cur.cortex = from.cortex + (tgt.cortex - from.cortex) * e;
      cur.cy = from.cy + (tgt.cy - from.cy) * e;
      (Object.keys(weight) as Key[]).forEach((k) => {
        const want = k === active ? 1 : 0;
        weight[k] += (want - weight[k]) * (reduce ? 1 : 0.08);
      });
    }

    // ── 그리기 ──
    function label(x: number, y: number, dx: number, dy: number, text: string, a: number, color = '255,255,255') {
      if (a < 0.03) return;
      ctx.save(); ctx.globalAlpha = a; ctx.font = MONO;
      const tw = ctx.measureText(text).width;
      // 이름표가 들어갈 공간이 더 넓은 쪽으로, 그래도 모자라면 화면 안으로 밀어 넣음
      const need = Math.abs(dx) + tw + 16;
      const roomR = w - 8 - x, roomL = x - 8;
      if (dx > 0 && roomR < need) dx = roomL >= need || roomL > roomR ? -Math.abs(dx) : dx;
      else if (dx < 0 && roomL < need) dx = roomR >= need || roomR > roomL ? Math.abs(dx) : dx;
      if (dx > 0) dx = Math.min(dx, Math.max(12, roomR - tw - 16));
      else dx = -Math.min(-dx, Math.max(12, roomL - tw - 16));
      const ty = Math.max(16, Math.min(h - 16, y + dy));
      ctx.strokeStyle = `rgba(${color},0.8)`; ctx.fillStyle = `rgba(${color},1)`; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx * 0.6, ty); ctx.lineTo(x + dx, ty); ctx.stroke();
      ctx.textBaseline = 'middle'; ctx.textAlign = dx < 0 ? 'right' : 'left';
      ctx.fillText(text, x + dx + (dx < 0 ? -7 : 7), ty);
      ctx.restore();
    }

    let lastHud = 0;
    const hudYaw = root.querySelector<HTMLElement>('[data-hud="yaw"]');

    function draw(now: number) {
      stepView(now);
      const t = now / 1000;
      const drift = reduce ? 0 : Math.sin(t * 0.18) * 0.06;
      const yaw = cur.yaw + userYaw + drift, pitch = Math.max(-1.2, Math.min(0.8, cur.pitch + userPitch));
      const scale = (mobile ? Math.min(w * 0.4, h * 0.36) : Math.min(w * 0.33, h * 0.36)) * cur.zoom;
      const cx = w * 0.5, cy = h * (cur.cy + (mobile ? 0.04 : 0));
      const P = makeProjector({ yaw, pitch, cx, cy, scale });
      ctx.clearRect(0, 0, w, h);

      const wT = weight.thesis, wP = weight.pd, wA = weight.ad;
      const inM1 = new Uint8Array(pts.length); for (const i of m1) inM1[i] = 1;

      // 점 (밝기 단계로 묶어서 빠르게)
      const B = 10, white: number[][] = Array.from({ length: B }, () => []), acc: number[][] = Array.from({ length: B }, () => []);
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        const [x, y, z] = P(p.x, p.y, p.z);
        PX[i] = x; PY[i] = y; PZ[i] = z;
        const d = 0.3 + 0.7 * depthOf(z);
        let a: number, hot = 0;
        if (p.r === REGION.stn) { hot = wP; a = 0.1 + 0.85 * wP; }
        else if (p.r === REGION.hippo) { hot = wA; a = 0.08 + 0.8 * wA; }
        else if (inM1[i]) { hot = wT; a = p.b * d * cur.cortex * (1 - wT) + (0.55 + 0.45 * d) * wT; }
        else if (p.r === REGION.interior) a = 0.12 * d * cur.cortex;
        else a = p.b * d * cur.cortex;
        a = Math.min(0.999, a);
        if (a < 0.02) continue;
        (hot > 0.5 ? acc : white)[Math.floor(a * B)].push(i);
      }
      for (let b = 0; b < B; b++) {
        const al = ((b + 0.5) / B).toFixed(3);
        if (white[b].length) { ctx.fillStyle = `rgba(255,255,255,${al})`; for (const i of white[b]) ctx.fillRect(PX[i], PY[i], 1.2, 1.2); }
        if (acc[b].length) { ctx.fillStyle = `rgba(${ACC},${al})`; for (const i of acc[b]) ctx.fillRect(PX[i] - 0.3, PY[i] - 0.3, 1.8, 1.8); }
      }

      // 옅은 피질 네트워크 (Thesis에서만 약간)
      if (wT > 0.05) {
        ctx.strokeStyle = `rgba(255,255,255,${(0.05 * wT).toFixed(3)})`; ctx.lineWidth = 0.6; ctx.beginPath();
        for (const [a, b] of net.edges) { const i = net.nodes[a], j = net.nodes[b]; ctx.moveTo(PX[i], PY[i]); ctx.lineTo(PX[j], PY[j]); }
        ctx.stroke();
      }

      // ① Thesis: 집속 초음파 변환기와 빔
      if (wT > 0.03) {
        const n = [m1C[0] * 0.3, m1C[1] - 0.14, m1C[2]]; const L = Math.hypot(n[0], n[1], n[2]) || 1;
        const off = 0.4;
        const [fx, fy] = P(m1C[0], m1C[1], m1C[2]);
        const [tx, ty] = P(m1C[0] + (n[0] / L) * off, m1C[1] + (n[1] / L) * off, m1C[2] + (n[2] / L) * off);
        const ang = Math.atan2(fy - ty, fx - tx), px = -Math.sin(ang), py = Math.cos(ang);
        ctx.save(); ctx.globalAlpha = wT;
        ctx.strokeStyle = 'rgba(255,255,255,0.55)'; ctx.setLineDash([3, 3]); ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(tx + px * 20, ty + py * 20); ctx.lineTo(fx, fy); ctx.moveTo(tx - px * 20, ty - py * 20); ctx.lineTo(fx, fy); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#000'; ctx.strokeStyle = '#fff';
        ctx.beginPath(); ctx.moveTo(tx + px * 24, ty + py * 24); ctx.lineTo(tx - px * 24, ty - py * 24);
        ctx.lineTo(tx - px * 24 - Math.cos(ang) * 14, ty - py * 24 - Math.sin(ang) * 14); ctx.lineTo(tx + px * 24 - Math.cos(ang) * 14, ty + py * 24 - Math.sin(ang) * 14); ctx.closePath(); ctx.fill(); ctx.stroke();
        // 세타 버스트: 0.2초마다 3번 (10배 느리게 재생)
        if (!reduce) {
          const ph = (t % 2) / 2;
          for (let k = 0; k < 3; k++) {
            const q = ph - k * 0.06; if (q < 0 || q > 0.5) continue;
            ctx.strokeStyle = `rgba(${ACC},${(0.9 * (1 - q * 2)).toFixed(3)})`;
            ctx.beginPath(); ctx.ellipse(fx, fy, 4 + q * 40, 2 + q * 18, ang, 0, Math.PI * 2); ctx.stroke();
          }
        }
        ctx.fillStyle = `rgba(${ACC},0.9)`; ctx.beginPath(); ctx.ellipse(fx, fy, 7, 3, ang, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
        label(tx, ty, 70, -26, 'TRANSDUCER', wT);
        label(fx, fy, -90, 44, 'M1 · FOCAL ZONE', wT, ACC);
      }

      // ② Parkinson's: 양측 DBS 리드
      if (wP > 0.03) {
        ctx.save(); ctx.globalAlpha = wP;
        for (const c of [stnL, stnR]) {
          const side = Math.sign(c[2]) || 1;
          const [sx, sy] = P(c[0], c[1], c[2]);
          const [ex, ey] = P(c[0] + 0.32, 1.02, c[2] + side * 0.16);
          ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.4;
          ctx.beginPath(); ctx.moveTo(ex, ey); ctx.lineTo(sx, sy); ctx.stroke();
          const len = Math.hypot(sx - ex, sy - ey) || 1, ux = (sx - ex) / len, uy = (sy - ey) / len;
          ctx.fillStyle = `rgb(${ACC})`;
          for (let k = 0; k < 4; k++) ctx.fillRect(sx - ux * (3 + k * 7) - 2.5, sy - uy * (3 + k * 7) - 2.5, 5, 5);
          if (!reduce) {
            const ph = ((t + (side > 0 ? 0 : 0.6)) % 1.2) / 1.2;
            ctx.strokeStyle = `rgba(${ACC},${(0.6 * (1 - ph)).toFixed(3)})`;
            ctx.beginPath(); ctx.arc(sx, sy, 6 + ph * 26, 0, Math.PI * 2); ctx.stroke();
          }
        }
        ctx.restore();
        const [lx, ly] = P(stnL[0], stnL[1], stnL[2]);
        label(lx, ly, -110, 60, 'STN · DBS LEAD', wP, ACC);
      }

      // ③ Alzheimer's: 해마 + 기록 탐침
      if (wA > 0.03) {
        const [hx, hy] = P(hipC[0], hipC[1], hipC[2]);
        const [ex, ey] = P(hipC[0] - 0.02, 1.02, hipC[2]);
        ctx.save(); ctx.globalAlpha = wA;
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(ex, ey); ctx.lineTo(hx, hy); ctx.stroke();
        const len = Math.hypot(hx - ex, hy - ey) || 1, ux = (hx - ex) / len, uy = (hy - ey) / len;
        for (let k = 0; k < 16; k++) {
          const on = !reduce && Math.sin(t * 6 + k * 1.7) > 0.7;
          ctx.fillStyle = on ? '#fff' : `rgba(${ACC},0.9)`;
          ctx.fillRect(hx - ux * k * 5 - 1.5, hy - uy * k * 5 - 1.5, 3, 3);
        }
        ctx.restore();
        label(hx, hy, -120, 56, 'HIPPOCAMPUS · CA3 → CA1', wA, ACC);
      }

      if (hudYaw && now - lastHud > 120) { lastHud = now; hudYaw.textContent = `${Math.round((yaw * 180) / Math.PI)}°`; }
    }

    // ── 탭 ──
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const sheets = [...root.querySelectorAll<HTMLElement>('[data-dwg]')];
    const hudView = root.querySelector<HTMLElement>('[data-hud="view"]');
    const hudTarget = root.querySelector<HTMLElement>('[data-hud="target"]');
    const dwgId = root.querySelector<HTMLElement>('[data-dwg-id]');

    function select(k: Key, focus = false) {
      tabs.forEach((b) => {
        const on = b.dataset.target === k;
        b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      panels.forEach((p) => { p.hidden = p.id !== `panel-${k}`; });
      sheets.forEach((s) => { s.hidden = s.dataset.dwg !== k; });
      if (hudView) hudView.textContent = VIEWS[k].view;
      if (hudTarget) hudTarget.textContent = VIEWS[k].target;
      if (dwgId) dwgId.textContent = VIEWS[k].dwg;
      go(k, performance.now());
      if (reduce) draw(performance.now());
    }
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => select(b.dataset.target as Key));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length].dataset.target as Key, true);
      });
    });

    // ── 끌어서 돌리기 ──
    let dragging = false, lx = 0, ly = 0;
    canvas.addEventListener('pointerdown', (e) => { dragging = true; lx = e.clientX; ly = e.clientY; canvas.setPointerCapture(e.pointerId); });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      userYaw -= (e.clientX - lx) * 0.008; userPitch -= (e.clientY - ly) * 0.004;
      lx = e.clientX; ly = e.clientY;
      if (reduce) draw(performance.now());
    });
    const stop = () => { dragging = false; };
    canvas.addEventListener('pointerup', stop); canvas.addEventListener('pointercancel', stop);

    // ── 시작 ──
    layout();
    let rt = 0;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { layout(); if (reduce) draw(performance.now()); }, 150); });
    if (reduce) draw(performance.now());
    else {
      let running = false;
      const loop = (now: number) => { if (!running) return; draw(now); requestAnimationFrame(loop); };
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) { running = true; requestAnimationFrame(loop); }
        else if (!e.isIntersecting) running = false;
      }).observe(canvas);
    }
  }
</script>
