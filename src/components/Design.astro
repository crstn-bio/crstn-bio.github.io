          <text class="t" x="24" y="342">Measure</text>
          <path class="ln dim" d="M120 350 L576 350" />
          <path class="ln" d="M520 350 V318 L540 318 V350" />
          <text class="t" x="352" y="312">neurophysiological outcome</text>
          <path class="ln dim" d="M120 390 L576 390" />
          <text class="s" x="120" y="410">time →</text>
        </svg></div>
      </div>

      <!-- DWG-02 Parkinson's -->
      <div class="sheets" data-dwg="pd" hidden>
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Coronal schematic: a DBS lead with four ring contacts passes the thalamus and zona incerta and ends in the subthalamic nucleus, above the substantia nigra.">
          <text class="h" x="24" y="34">A · Lead in target</text><text class="s" x="24" y="54">coronal, schematic</text>
          <path class="ln" d="M84 172 C92 124 240 112 286 140 C318 162 300 202 230 210 C160 218 80 214 84 172 Z" />
          <text class="t" x="110" y="176">Thalamus</text>
          <path class="ln dim" d="M120 232 C180 222 260 222 330 236" /><text class="s" x="96" y="250">zona incerta</text>
          <ellipse class="acc-fill soft" cx="262" cy="276" rx="74" ry="22" transform="rotate(-18 262 276)" />
          <ellipse class="acc" cx="262" cy="276" rx="74" ry="22" transform="rotate(-18 262 276)" />
          <path class="ln" d="M150 340 C220 318 300 300 380 300 C400 312 380 330 330 338 C260 348 200 360 150 356 Z" />
          <text class="t" x="96" y="382">Substantia nigra</text>
          <path class="ln dim" d="M432 150 L398 330 M462 150 L430 330" /><text class="s" x="470" y="176">internal</text><text class="s" x="470" y="192">capsule</text>
