---
// 02 · 구체적 설계
// 탭(Thesis / Parkinson's / Alzheimer's)을 누르면 뇌가 해당 표적 쪽으로 돌아가고,
// 오른쪽에 해부학적 위치, 아래에 엔지니어링 도안이 바뀌어요.
// 뇌 모델은 실제 집단 평균 해부 데이터예요 (HCP S1200, MNI152 공간, src/scripts/hcpBrain.ts).
// 특정 환자의 데이터는 아니고, STN은 문헌상 대략적 위치예요. 아래 도안은 코드로 그린 도식이에요.
// 기억 도안용 5×5 패턴: 저장된 패턴, 부분만 해독된 패턴, 그 차이
const stored = [0,1,1,0,0, 1,0,1,1,0, 0,1,0,1,1, 1,1,0,0,1, 0,0,1,1,0];
const decoded = stored.map((v, i) => (v && [2, 5, 13, 16, 22].includes(i) ? 0 : v));
const diff = stored.map((v, i) => (v && !decoded[i] ? 1 : 0));
const cells = (bits: number[], x0: number, kind: string) =>
  bits.map((v, i) => ({ x: x0 + (i % 5) * 22, y: 106 + Math.floor(i / 5) * 22, v, kind }));
const grids = [...cells(decoded, 170, 'w'), ...cells(stored, 330, 'w'), ...cells(diff, 470, 'a')];

// 두피·두개골·피질을 타원으로, 피질에는 이랑(볼록)과 고랑(오목)을 넣어요.
const arc = (rx: number, ry: number) => `M${300 - rx} 410 A${rx} ${ry} 0 0 1 ${300 + rx} 410`;
const cortexPath = (() => {
  const pts: string[] = [];
  for (let i = 0; i <= 180; i++) {
    const th = Math.PI - (i / 180) * Math.PI;
    const r = 1 - 0.035 * Math.pow(0.5 + 0.5 * Math.cos(16 * th + Math.PI), 16);
    pts.push(`${(300 + 222 * r * Math.cos(th)).toFixed(1)} ${(410 - 234 * r * Math.sin(th)).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
})();

const targets = [
  {
    key: 'thesis',
    when: 'Now',
    name: 'Thesis',
    target: 'M1 · a-tbTUS + FES',
    kicker: 'Now · honours thesis, Krembil Brain Institute',
    title: 'Focused ultrasound on motor cortex, paired with movement',
    anatomy: [
      ['Structure', 'Primary motor cortex (M1), Brodmann area 4'],
      ['Location', 'Precentral gyrus, directly in front of the central sulcus, on the lateral and upper surface of the frontal lobe'],
      ['Depth', 'Cortical surface, roughly 1–2 cm beneath the scalp'],
      ['Why here', 'Motor cortex output can be measured at the muscle, so changes in its excitability are observable'],
    ],
    loop: ['a-tbTUS → M1', 'FES → muscle', 'Combined session', 'Measure response'],
    question: 'Does pairing focused ultrasound with functional electrical stimulation change motor cortex more than either on its own?',
    note: '',
  },
  {
    key: 'pd',
    when: 'Next',
    name: 'Parkinson’s',
    target: 'STN · closed-loop DBS',
    kicker: 'Next · the first step of the vision',
    title: 'Closed-loop deep brain stimulation of the subthalamic nucleus',
    anatomy: [
      ['Structure', 'Subthalamic nucleus (STN), both hemispheres'],
      ['Location', 'Small lens-shaped nucleus in the ventral diencephalon, below the thalamus and zona incerta, above the substantia nigra, medial to the internal capsule'],
      ['Coordinates', 'Typical indirect target ≈ 11–13 mm lateral, 2–4 mm posterior, 4–6 mm inferior to the mid-commissural point, refined per patient with imaging and microelectrode recording'],
      ['Why here', 'The DBS lead already sits in the circuit and can record local field potentials; beta-band (13–30 Hz) activity tracks bradykinesia and rigidity in many patients'],
    ],
    loop: ['LFP · beta', 'State z(t)', 'Patient model', 'DBS amplitude'],
    question: 'How little patient-specific data is enough to learn a new brain?',
    note: '',
  },
  {
    key: 'ad',
    when: 'Later',
    name: 'Alzheimer’s',
    target: 'Hippocampus · memory',
    kicker: 'Later · extending the loop to memory',
    title: 'Decoding and restoring memory-related activity in the hippocampus',
    anatomy: [
      ['Structure', 'Hippocampal formation: dentate gyrus, CA3, CA1 and subiculum'],
      ['Location', 'Medial temporal lobe, forming the floor of the temporal horn of the lateral ventricle, running from the head (front) to the tail, which curves up behind the thalamus'],
      ['Circuit', 'Entorhinal cortex → dentate gyrus → CA3 → CA1 → subiculum; the recurrent CA3 network supports recall from partial cues'],
      ['Why here', 'Among the earliest regions affected in Alzheimer’s disease, and central to forming and retrieving episodic memory'],
    ],
    loop: ['Spikes + LFP', 'Representation', 'Memory model', 'Patterned stimulation'],
    question: 'What remains when memory becomes inaccessible, and can it be written back?',
    note: 'Speculative extension, not an existing method.',
  },
];
---
<section class="design" id="design" aria-labelledby="design-h">
  <div class="wrap">
    <div class="d-head">
      <div>
        <p class="kicker mono">02 / The design</p>
        <h2 id="design-h">Three targets, one loop.</h2>
      </div>
      <p>Choose a stage. The model turns to the target, shows where it sits in the brain, and how I would reach it.</p>
    </div>

    <div class="tabs" role="tablist" aria-label="Stage">
      {targets.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-target={t.key}>
          <span class="t-when mono">{String(i + 1).padStart(2, '0')} · {t.when}</span>
          <span class="t-name">{t.name}</span>
          <span class="t-target mono">{t.target}</span>
        </button>
      ))}
    </div>

    <div class="stage">
      <div class="viewport">
        <canvas id="design-brain" aria-hidden="true"></canvas>
        <canvas id="design-overlay" aria-hidden="true"></canvas>
        <dl class="hud mono" aria-hidden="true">
