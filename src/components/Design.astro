          <div><dt>Target</dt><dd data-hud="target">M1 · area 4, left</dd></div>
          <div><dt>MNI mm</dt><dd data-hud="mni">−39, −22, 58</dd></div>
          <div><dt>Device</dt><dd data-hud="device">transducer · schematic</dd></div>
          <div><dt>Az · El</dt><dd data-hud="az">34° · 5°</dd></div>
        </dl>
        <p class="status mono" data-status role="status">Loading HCP S1200 surface · 1.5 MB</p>
        <p class="src mono" aria-hidden="true">HCP S1200 · MNI152 · orthographic</p>
        <p class="hint mono" aria-hidden="true">Drag to rotate</p>
      </div>

      <div class="panels">
        {targets.map((t, i) => (
          <div class="panel" role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={i !== 0}>
            <p class="p-kicker mono">{t.kicker}</p>
            <h3>{t.title}</h3>
            <dl class="anatomy">
              {t.anatomy.map(([k, v]) => (<div><dt class="mono">{k}</dt><dd>{v}</dd></div>))}
            </dl>
            <ol class="chips mono" aria-label="Loop">
              {t.loop.map((c, i) => (<><li>{c}</li>{i < t.loop.length - 1 && <li class="sep" aria-hidden="true">→</li>}</>))}
            </ol>
            <p class="q">{t.question}</p>
            {t.note && <p class="note mono">{t.note}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- 엔지니어링 도안: 탭마다 하나씩, 두 장씩 -->
