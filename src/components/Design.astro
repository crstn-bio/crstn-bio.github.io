        <span data-dwg-id>DWG-01 · a-tbTUS + FES</span>
        <span>Schematic · not to scale</span>
      </div>
      <p class="swipe mono" aria-hidden="true">Swipe sideways to see the full drawing →</p>

      <!-- DWG-01 Thesis -->
      <div class="sheets" data-dwg="thesis">
        <div class="sheet"><svg viewBox="0 0 600 420" role="img" aria-label="Coronal schematic: a focused ultrasound transducer on the scalp, its beam passing the skull and converging to a focal zone in the primary motor cortex.">
          <text class="h" x="24" y="34">A · Focus geometry</text><text class="s" x="24" y="54">coronal section through M1</text>
          <path class="ln" d={arc(260, 280)} />
          <path class="ln dim" d={arc(244, 262)} /><path class="ln dim" d={arc(232, 248)} />
          <path class="ln" d={cortexPath} />
          <rect class="box" x="236" y="80" width="128" height="34" />
          <path class="ln" d="M242 114 Q300 136 358 114" />
          <path class="beam" d="M248 120 L297 196 M352 120 L303 196" />
          <ellipse class="acc-fill" cx="300" cy="198" rx="8" ry="20" />
          <path class="acc" d="M300 150 L300 236" stroke-dasharray="2 4" />
          <path class="dim" d="M366 130 L412 130 M312 198 L412 198 M404 130 L404 198" />
          <rect class="tag" x="410" y="154" width="74" height="22" /><text class="t" x="416" y="170">≈ 1–2 cm</text>
