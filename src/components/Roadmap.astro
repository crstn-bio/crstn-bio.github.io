---
const stages=[['01','PRINCIPLE','The brain is dynamic. Therapy should be too.','State changes over time. Response changes with state. Patients differ.'],['02','SYSTEM','A therapeutic model of the individual brain.','Sense → estimate → predict → control → learn.'],['03','MEASURE','How does the human nervous system respond to intervention?','ACTIVE · a-tbTUS + FES · honours thesis'],['04','DECODE','From signal to state.','Raw electrophysiology → features → latent neural state z(t).'],['05','PERSONALIZE','How little patient-specific data is enough to learn a new brain?','Population knowledge + minimal patient data → individual model.'],['06','PREDICT','What happens if we act now?','Estimate the response before choosing an intervention.'],['07','CONTROL','Close the loop.','State → response model → candidate action → simulated intervention → response.'],['08','MINIMIZE','How much neural information is enough?','Record densely. Discover sparsely.'],['09','INTERFACE','How much hardware does that information require?','The model is constant. The interface can change.']];
---
<section class="roadmap" id="roadmap"><div class="roadmap-viz" aria-hidden="true"><div class="orb"><div class="target"></div><div class="scan"></div></div><svg viewBox="0 0 600 420"><path d="M100 210 C150 70 450 70 500 210 C450 350 150 350 100 210Z"/><path d="M300 210 L500 110 M300 210 L500 310"/><circle cx="100" cy="210" r="5"/><circle cx="300" cy="210" r="7"/><circle cx="500" cy="210" r="5"/></svg><div class="signal mono">LFP ~∿∿∿ → z(t) → P(Δz | z,u,pᵢ)</div><div class="vector mono">u(t) = [ A · f · PW · C ]</div><div class="viz-label mono">SCHEMATIC / PROPOSED ARCHITECTURE</div></div><div class="roadmap-copy">{stages.map(([n,k,q,d],i)=><article class="stage" data-stage={i} id={i===0?'principle':undefined}><div class="stage-inner"><p class="stage-meta mono">{n} / {k}</p><h2>{q}</h2><p>{d}</p>{k==='SYSTEM'&&<div class="equations mono"><span>zₜ = fθ(X₀:ₜ)</span><span>ẑₜ₊₁ = gφ(zₜ,uₜ,pᵢ)</span></div>}{k==='CONTROL'&&<p class="status mono">SIMULATED CONTROL LOOP · PROPOSED SYSTEM</p>}{k==='MINIMIZE'&&<div class="channels">{Array.from({length:28}).map((_,j)=><i class={j%5===0||j===13?'keep':''}></i>)}</div>}</div></article>)}</div></section>
<script>const root=document.querySelector('.roadmap');const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){root?.setAttribute('data-active',(e.target as HTMLElement).dataset.stage||'0');e.target.classList.add('seen')}}),{threshold:.5});document.querySelectorAll('.stage').forEach(x=>obs.observe(x));</script>
<style>.roadmap{position:relative;background:#050505;color:#f2f2ef;display:grid;grid-template-columns:46% 54%}.roadmap-copy{grid-column:1}.stage{min-height:105vh;display:flex;align-items:center;padding:8vh var(--gutter)}.stage-inner{max-width:640px;margin-left:auto;opacity:.35;transform:translateY(25px);transition:.6s}.stage.seen .stage-inner{opacity:1;transform:none}.stage-meta{color:var(--signal);letter-spacing:.12em}.stage h2{font-size:clamp(38px,4.7vw,74px);letter-spacing:-.045em;line-height:.98;max-width:12ch}.stage p{color:#8f8f8a;max-width:48ch;margin-top:24px}.equations{display:grid;gap:10px;margin-top:28px;color:#c8c8c2}.status{border-top:1px solid #252525;padding-top:16px}.roadmap-viz{position:sticky;top:0;height:100vh;grid-column:2;grid-row:1;display:grid;place-items:center;overflow:hidden}.orb{width:min(43vw,620px);aspect-ratio:1;border:1px solid #262626;border-radius:50%;position:absolute;background:radial-gradient(circle at 52% 45%,rgba(142,197,255,.07),transparent 52%)}.orb:before,.orb:after{content:'';position:absolute;border:1px solid #202020;border-radius:50%;inset:13%}.orb:after{inset:29%;border-style:dashed}.target{position:absolute;width:12px;height:12px;border-radius:50%;background:var(--signal);left:54%;top:54%;box-shadow:0 0 30px rgba(142,197,255,.8)}.scan{position:absolute;left:10%;right:10%;height:1px;background:linear-gradient(90deg,transparent,var(--signal),transparent);top:45%;animation:scan 4s linear infinite;opacity:.5}.roadmap-viz svg{width:min(48vw,720px);position:absolute}.roadmap-viz path,.roadmap-viz circle{fill:none;stroke:#353535;stroke-width:1}.roadmap-viz circle{fill:#8ec5ff;stroke:none}.signal{position:absolute;top:23%;color:#73736f}.vector{position:absolute;bottom:24%;color:#8ec5ff}.viz-label{position:absolute;bottom:7%;right:7%;color:#4f4f4c}.channels{display:flex;gap:4px;margin-top:32px}.channels i{width:5px;height:40px;background:#292929}.channels i.keep{background:var(--signal);height:54px}@keyframes scan{0%{transform:translateY(-120px)}100%{transform:translateY(120px)}}@media(max-width:850px){.roadmap{display:block}.roadmap-viz{height:46vh;z-index:0}.roadmap-copy{position:relative;z-index:1}.stage{min-height:72vh;align-items:flex-end;background:linear-gradient(0deg,#050505 42%,rgba(5,5,5,.2))}.stage-inner{margin:0}.orb{width:70vw}.roadmap-viz svg{width:85vw}.signal{top:15%}.vector{bottom:16%}.viz-label{display:none}}@media(prefers-reduced-motion:reduce){.scan{animation:none}.stage-inner{transition:none}}</style>
