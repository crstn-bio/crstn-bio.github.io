---
// MEMORY: 기억은 하나의 변수가 아니라 일곱 과정의 사슬이에요. 실패는 여러 단계에서 일어날 수 있어요 (?).
const pattern = [[0, 0], [12, 10], [26, -6], [36, 12], [50, 2], [62, -10], [72, 8]];
const steps = [
  { k: 'exp', t: 'Experience', fail: false },
  { k: 'enc', t: 'Encoding', fail: true },
  { k: 'rep', t: 'Representation', fail: false },
  { k: 'con', t: 'Consolidation', fail: true },
  { k: 'sto', t: 'Storage', fail: true },
  { k: 'ret', t: 'Retrieval', fail: true },
  { k: 'beh', t: 'Behaviour', fail: false },
];
---
<figure class="mc" aria-label="Memory as a chain of processes: experience, encoding, neural representation, consolidation, storage, retrieval and behaviour. Failure could arise at several stages, marked with question marks.">
  <ol>
    {steps.map((s, i) => (
      <li style={`--i:${i}`}>
        <svg viewBox="0 0 120 80" aria-hidden="true">
          {s.k === 'exp' && <><circle class="w" cx="60" cy="40" r="10" />{[0, 45, 90, 135, 180, 225, 270, 315].map((a) => { const r = (a * Math.PI) / 180; return <path class="ln" d={`M${(60 + 16 * Math.cos(r)).toFixed(1)} ${(40 + 16 * Math.sin(r)).toFixed(1)} L${(60 + 24 * Math.cos(r)).toFixed(1)} ${(40 + 24 * Math.sin(r)).toFixed(1)}`} />; })}</>}
          {s.k === 'enc' && Array.from({ length: 14 }, (_, j) => <path class="tk" d={`M${26 + j * 5} ${22 + (j % 3) * 4} V${58 - (j % 2) * 5}`} />)}
          {s.k === 'rep' && pattern.map(([x, y]) => <circle class="a" cx={24 + x} cy={40 + y} r="4" />)}
          {s.k === 'con' && [24, 52, 80].map((x0) => Array.from({ length: 5 }, (_, j) => <path class="tk2" d={`M${x0 + j * 3.5} 26 V54`} />))}
          {s.k === 'sto' && [0, 1].map((k) => pattern.map(([x, y]) => <circle class="a" style={`opacity:${k ? 0.35 : 0.9}`} cx={20 + x + k * 8} cy={40 + y + k * 6} r="3.4" />))}
          {s.k === 'ret' && <><path class="cue" d="M100 40 H70" /><path class="af" d="M70 34 L60 40 L70 46 Z" /><path class="brk" d="M54 40 H22" />{pattern.slice(0, 4).map(([x, y]) => <circle class="a dim" cx={14 + x / 2} cy={40 + y / 2} r="3" />)}</>}
          {s.k === 'beh' && <path class="w2" d="M16 58 H48 V24 H80 V58 H104" />}
        </svg>
        <span class="t mono">{s.t}</span>
        {s.fail && <span class="f mono" title="possible point of failure">?</span>}
      </li>
    ))}
  </ol>
  <figcaption class="mono">? = a stage where a memory could plausibly fail</figcaption>
</figure>

<style>
  .mc { --acc: #a8c8ff; margin: 0; border: 1px solid #1f1f1f; background-color: #030303; background-image: linear-gradient(#0d0d0d 1px, transparent 1px), linear-gradient(90deg, #0d0d0d 1px, transparent 1px); background-size: 20px 20px; padding: clamp(12px, 2vw, 22px); }
  .mc ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .mc li { position: relative; display: grid; justify-items: center; gap: 8px; padding: 8px 4px 12px; animation: mc-on 8.4s infinite; animation-delay: calc(var(--i) * 1.2s); }
  .mc li + li::before { content: ''; position: absolute; left: -6px; top: 34%; width: 8px; height: 8px; border-top: 1px solid #5a5a5a; border-right: 1px solid #5a5a5a; transform: rotate(45deg); }
  .mc svg { width: 100%; max-width: 120px; height: auto; display: block; }
  .t { color: #cfcfcf; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; }
  .f { position: absolute; top: 2px; right: 8px; color: var(--acc); font-size: 14px; }
  .mc figcaption { margin: 6px 0 0; color: #6a6a6a; }
  .ln { stroke: #8a8a8a; } .w { fill: none; stroke: #e6e6e6; stroke-width: 1.4; }
  .tk { stroke: var(--acc); stroke-width: 1.6; } .tk2 { stroke: #bdbdbd; stroke-width: 1.4; }
  .a { fill: var(--acc); } .a.dim { opacity: .35; }
  .cue { stroke: var(--acc); stroke-width: 1.6; } .af { fill: var(--acc); }
  .brk { stroke: #8a8a8a; stroke-width: 1.4; stroke-dasharray: 4 5; }
  .w2 { fill: none; stroke: #e6e6e6; stroke-width: 1.5; }
  @keyframes mc-on { 0%, 10% { background: rgba(168, 200, 255, .06); } 15%, 100% { background: transparent; } }
  @media (max-width: 760px) {
    .mc ol { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 8px; }
    .mc li:nth-child(5)::before { display: none; }
  }
  @media (max-width: 420px) {
    .mc ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mc li:nth-child(5)::before { display: block; }
    .mc li:nth-child(4)::before, .mc li:nth-child(7)::before { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .mc li { animation: none; } }
</style>
