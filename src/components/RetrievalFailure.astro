---
// 하이라이트 장면: 인출이 실패했을 때, 정확히 무엇이 실패했나?
// 인출 실패 → 신경 관측 → 개인 모델 → (A 없음? · B 손상? · C 접근 불가?) → E 후보 개입 → 예측된 상태 변화 → 개입 → 인출?
// 연구 틀(framework)이지 지금 존재하는 시스템이 아니에요.
const P = [[0, 0], [14, 10], [30, -6], [42, 12], [58, 2], [72, -10], [84, 8]];
const pat = (x0: number, y0: number, s = 1) => P.map(([x, y]) => [x0 + x * s, y0 + y * s]);
const raster = (x0: number, y0: number, w: number, rows: number, gap: number) => {
  let seed = 5;
  const rnd = () => ((seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0) / 4294967296);
  const out: string[] = [];
  for (let r = 0; r < rows; r++) for (let x = x0 + rnd() * 10; x < x0 + w; x += 8 + rnd() * 26) out.push(`M${x.toFixed(1)} ${y0 + r * gap} v${gap - 3}`);
  return out.join(' ');
};
---
<figure class="rf" aria-label="Research framework: when retrieval fails, neural observations update an individual model, which asks whether the representation is absent, degraded or inaccessible. If it may be inaccessible, the model ranks candidate perturbations by their predicted state changes, an intervention is delivered, and retrieval is tested again. This is a framework, not an existing system.">
