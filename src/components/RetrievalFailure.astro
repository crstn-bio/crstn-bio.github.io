    <rect class="box model" x="680" y="24" width="300" height="112" />
    <text class="lbl" x="694" y="48">INDIVIDUAL MODEL</text>
    <text class="z" x="964" y="52" text-anchor="end">z(t)</text>
    <path class="trj" d="M708 112 C760 70 820 120 870 84 S940 72 960 100" />

    <!-- 가설 -->
    <path class="ln" d="M830 136 V160 M160 160 H840 M160 160 V184 M500 160 V184 M840 160 V184" />
    <text class="dq" x="500" y="152" text-anchor="middle">D · can measurements tell these apart?</text>

    <rect class="box hyp hA" x="30" y="190" width="260" height="110" />
