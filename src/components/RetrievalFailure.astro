  </svg>
  <figcaption class="mono">A research framework, not an existing system. Letters A–E are open questions.</figcaption>
</figure>

<style>
  .rf { --acc: #a8c8ff; margin: 0; border: 1px solid #1f1f1f; background-color: #030303; background-image: linear-gradient(#0d0d0d 1px, transparent 1px), linear-gradient(90deg, #0d0d0d 1px, transparent 1px); background-size: 20px 20px; padding: clamp(12px, 2vw, 24px); }
  .rf svg { display: block; width: 100%; height: auto; }
  .rf .v { display: none; }
  .rf figcaption { margin: 10px 0 0; color: #6a6a6a; }
  .box { fill: #050505; stroke: #5a5a5a; stroke-width: 1.1; }
  .box.model { stroke: var(--acc); fill: #060a10; }
  .lbl { fill: #fff; font: 500 14px var(--mono); letter-spacing: 0.08em; }
  .lbl.a { fill: var(--acc); }
  .sub { fill: #8a8a8a; font: 13px var(--mono); }
  .dq { fill: var(--acc); font: 14px var(--mono); }
  .z { fill: var(--acc); font: 22px var(--mono); }
  .ln { fill: none; stroke: #8a8a8a; stroke-width: 1.2; }
  .rep { fill: var(--acc); } .rep.dim { opacity: .35; }
  .ghost { fill: none; stroke: #6a6a6a; stroke-dasharray: 2 2; }
  .brk { stroke: #8a8a8a; stroke-width: 1.4; stroke-dasharray: 4 5; }
  .cue { stroke: var(--acc); stroke-width: 1.6; } .cuef { fill: var(--acc); }
  .qm { fill: var(--acc); font: 22px var(--mono); } .qm.big { font-size: 28px; }
  .tk { stroke: #bdbdbd; stroke-width: 1.2; }
  .trj { fill: none; stroke: rgba(168, 200, 255, .55); stroke-width: 1.3; }
  .wall { stroke: #e6e6e6; stroke-width: 2; stroke-dasharray: 4 3; }
  .pul { stroke: var(--acc); stroke-width: 1.4; }
  .tgt { fill: rgba(168, 200, 255, .07); stroke: #6a6a6a; stroke-dasharray: 3 3; }
  .pr { fill: none; stroke: #6a6a6a; stroke-width: 1.3; stroke-dasharray: 4 4; }
  .pr.best { stroke: var(--acc); stroke-dasharray: none; stroke-width: 2; }
  .now { fill: #fff; }
  .mv { fill: var(--acc); }

  /* 가설 상자가 차례로 밝아지고(A→B→C), 가장 좋은 예측이 그려지고, 마지막 물음표가 깜빡임 */
  .run .hyp { animation: rf-hyp 9s infinite; }
  .run .hA { animation-delay: 2.4s; } .run .hB { animation-delay: 3s; } .run .hC { animation-delay: 3.6s; }
  .run .best { stroke-dasharray: 1; animation: rf-draw 9s infinite; }
  .run .qm.big { animation: rf-q 1.6s ease-in-out infinite; }
  @keyframes rf-hyp { 0%, 4% { stroke: #a8c8ff; } 10%, 100% { stroke: #5a5a5a; } }
  @keyframes rf-draw { 0%, 62% { stroke-dashoffset: 1; } 78%, 100% { stroke-dashoffset: 0; } }
  @keyframes rf-q { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

  @media (max-width: 760px) {
    .rf .h { display: none; }
    .rf .v { display: block; }
    .rf .v .sub { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .run .hyp, .run .best, .run .qm.big { animation: none; }
    .rf .mv { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.rf').forEach((el) => {
    const svgs = [...el.querySelectorAll<SVGSVGElement>('svg')];
    new IntersectionObserver(([e]) => {
      el.classList.toggle('run', e.isIntersecting);
      svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations()));
    }, { threshold: 0.15 }).observe(el);
  });
</script>
