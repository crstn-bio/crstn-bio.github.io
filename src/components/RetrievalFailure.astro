    {pat(110, 252).map(([x, y]) => <circle class="ghost" cx={x} cy={y} r="4" />)}

    <rect class="box hyp hB" x="370" y="190" width="260" height="110" />
    <text class="lbl" x="384" y="214">B · DEGRADED?</text><text class="sub" x="384" y="290">encoded, then lost</text>
    {pat(450, 252).map(([x, y], i) => <circle class={i % 3 === 1 ? 'ghost' : 'rep dim'} cx={x} cy={y} r="4" />)}

    <rect class="box hyp hC" x="710" y="190" width="260" height="110" />
    <text class="lbl a" x="724" y="214">C · INACCESSIBLE?</text><text class="sub" x="724" y="290">present, not retrievable</text>
    {pat(790, 252).map(([x, y]) => <circle class="rep" cx={x} cy={y} r="4" />)}
    <path class="wall" d="M770 228 V276" />

    <!-- 3행 -->
    <path class="ln" d="M840 300 V325 H160 V344" marker-end="url(#rf-a)" />
    <rect class="box" x="30" y="350" width="260" height="110" />
    <text class="lbl" x="44" y="374">E · CANDIDATE PERTURBATIONS</text>
    {[0, 1, 2].map((r) => <><text class="sub" x="44" y={402 + r * 20}>{`u${'₁₂₃'[r]}`}</text><path class="pul" d={Array.from({ length: 9 }, (_, j) => `M${84 + j * (12 + r * 4)} ${404 + r * 20} v-10`).join(' ')} /></>)}
    <path class="ln" d="M290 405 H364" marker-end="url(#rf-a)" />

    <rect class="box" x="370" y="350" width="260" height="110" />
    <text class="lbl" x="384" y="374">PREDICTED STATE CHANGES</text>
    <circle class="tgt" cx="590" cy="400" r="16" />
    <path class="pr" d="M400 436 C440 430 470 444 520 446" /><path class="pr" d="M400 436 C440 420 480 420 540 420" />
    <path class="pr best" pathLength="1" d="M400 436 C450 410 520 396 584 400" />
    <circle class="now" cx="400" cy="436" r="4.5" />
    <path class="ln" d="M630 405 H704" marker-end="url(#rf-a)" />

    <rect class="box model" x="710" y="350" width="260" height="110" />
    <text class="lbl" x="724" y="374">INTERVENE → RETRIEVAL?</text>
    {pat(740, 420).map(([x, y]) => <circle class="rep" cx={x} cy={y} r="4" />)}
    <path class="cue" d="M950 420 H850" /><path class="cuef" d="M852 414 L842 420 L852 426 Z" />
    <text class="qm big" x="900" y="408" text-anchor="middle">?</text>

    <circle class="mv" r="4.5"><animateMotion dur="9s" repeatCount="indefinite"><mpath href="#rf-p" /></animateMotion></circle>
  </svg>

  <!-- 세로 (좁은 화면) -->
  <svg class="v" viewBox="0 0 400 1200" aria-hidden="true">
    <defs>
      <marker id="rf-av" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#8a8a8a" stroke-width="1.4" /></marker>
    </defs>
    <rect class="box" x="20" y="10" width="360" height="100" />
    <text class="lbl" x="34" y="36">RETRIEVAL FAILS</text>
    {pat(40, 78).map(([x, y]) => <circle class="rep dim" cx={x} cy={y} r="4" />)}
    <path class="brk" d="M240 78 H140" /><text class="qm" x="190" y="70" text-anchor="middle">?</text>
    <path class="cue" d="M360 78 H254" /><path class="cuef" d="M256 72 L246 78 L256 84 Z" />
    <path class="ln" d="M200 110 V134" marker-end="url(#rf-av)" />

    <rect class="box" x="20" y="140" width="360" height="100" />
    <text class="lbl" x="34" y="166">NEURAL OBSERVATIONS</text>
    <path class="tk" d={raster(34, 178, 330, 6, 8.5)} />
    <path class="ln" d="M200 240 V264" marker-end="url(#rf-av)" />

    <rect class="box model" x="20" y="270" width="360" height="100" />
    <text class="lbl" x="34" y="296">INDIVIDUAL MODEL</text><text class="z" x="364" y="300" text-anchor="end">z(t)</text>
    <path class="trj" d="M40 352 C100 312 170 360 230 326 S330 316 360 344" />
    <path class="ln" d="M200 370 V396" />
    <text class="dq" x="200" y="414" text-anchor="middle">D · can measurements</text>
    <text class="dq" x="200" y="434" text-anchor="middle">tell these apart?</text>
    <path class="ln" d="M200 442 V456" marker-end="url(#rf-av)" />

    <rect class="box hyp hA" x="20" y="462" width="360" height="84" />
    <text class="lbl" x="34" y="488">A · ABSENT?</text><text class="sub" x="34" y="532">never adequately encoded</text>
    {pat(262, 506).map(([x, y]) => <circle class="ghost" cx={x} cy={y} r="4" />)}
    <rect class="box hyp hB" x="20" y="556" width="360" height="84" />
    <text class="lbl" x="34" y="582">B · DEGRADED?</text><text class="sub" x="34" y="626">encoded, then lost</text>
    {pat(262, 600).map(([x, y], i) => <circle class={i % 3 === 1 ? 'ghost' : 'rep dim'} cx={x} cy={y} r="4" />)}
    <rect class="box hyp hC" x="20" y="650" width="360" height="84" />
    <text class="lbl a" x="34" y="676">C · INACCESSIBLE?</text><text class="sub" x="34" y="720">present, not retrievable</text>
    {pat(262, 694).map(([x, y]) => <circle class="rep" cx={x} cy={y} r="4" />)}
    <path class="wall" d="M250 670 V704" />
    <path class="ln" d="M200 734 V764" marker-end="url(#rf-av)" />

    <rect class="box" x="20" y="770" width="360" height="110" />
    <text class="lbl" x="34" y="796">E · CANDIDATE PERTURBATIONS</text>
    {[0, 1, 2].map((r) => <><text class="sub" x="34" y={826 + r * 20}>{`u${'₁₂₃'[r]}`}</text><path class="pul" d={Array.from({ length: 12 }, (_, j) => `M${76 + j * (14 + r * 5)} ${828 + r * 20} v-10`).join(' ')} /></>)}
    <path class="ln" d="M200 880 V904" marker-end="url(#rf-av)" />

    <rect class="box" x="20" y="910" width="360" height="110" />
    <text class="lbl" x="34" y="936">PREDICTED STATE CHANGES</text>
    <circle class="tgt" cx="330" cy="972" r="18" />
    <path class="pr" d="M50 1004 C110 998 160 1010 230 1012" /><path class="pr" d="M50 1004 C110 986 170 986 250 984" />
    <path class="pr best" pathLength="1" d="M50 1004 C120 978 240 966 324 972" />
    <circle class="now" cx="50" cy="1004" r="4.5" />
    <path class="ln" d="M200 1020 V1044" marker-end="url(#rf-av)" />

    <rect class="box model" x="20" y="1050" width="360" height="110" />
