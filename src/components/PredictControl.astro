---
// PREDICT → CONTROL: 상태 공간에서 현재 상태 z(t)로부터 후보 개입 u₁·u₂·u₃의 미래를 예측하고,
// 목표에 닿는 하나를 고르고(u*), 개입한 뒤 실제 반응이 돌아와 모델을 갱신해요.
// 한 바퀴 8초. 오른쪽 단계 목록이 같은 시간에 맞춰 밝아져요.
const bez = (a: number[], b: number[], c: number[], d: number[]) => `M${a.join(' ')} C${b.join(' ')} ${c.join(' ')} ${d.join(' ')}`;
const Z = [170, 262];                                       // 현재 상태
const branches = [
  { k: 'u₁', d: bez(Z, [240, 300], [320, 330], [400, 330]), end: [400, 330] },
  { k: 'u₂', d: bez(Z, [250, 240], [350, 230], [440, 214]), end: [440, 214] },
  { k: 'u₃', d: bez(Z, [230, 190], [380, 120], [540, 112]), end: [540, 112] },
];
const observed = bez(Z, [236, 196], [384, 132], [528, 128]);
const history = bez([52, 330], [90, 320], [120, 286], Z);
const steps = ['Sense', 'Estimate state', 'Predict', 'Select', 'Act', 'Observe', 'Update model'];
---
<figure class="pc" aria-label="Prediction and control in state space: from the current state z of t, the model predicts the future under three candidate interventions, selects the one that reaches the target state, delivers it, observes the actual response and updates the model.">
  <svg viewBox="0 0 660 380" aria-hidden="true">
    <defs>
      <marker id="pc-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 L9 5 L0 9" fill="none" stroke="#a8c8ff" stroke-width="1.4" /></marker>
    </defs>
    <path class="axis" d="M40 356 H640 M40 356 V16" />
    <text class="t" x="640" y="350" text-anchor="end">z₁</text><text class="t" x="50" y="30">z₂</text>

    <!-- 목표 상태 -->
    <ellipse class="target" cx="540" cy="112" rx="74" ry="44" />
    <text class="t" x="540" y="56" text-anchor="middle">target state</text>

    <!-- 지나온 궤적과 현재 상태 -->
    <path class="hist" d={history} />
    <circle class="now" cx={Z[0]} cy={Z[1]} r="7" />
    <circle class="ring" cx={Z[0]} cy={Z[1]} r="7" />
    <text class="t w" x={Z[0] - 14} y={Z[1] + 28} text-anchor="end">z(t)</text>

    <!-- 예측된 갈래 -->
    {branches.map((b, i) => (
      <g class={`br br${i + 1}`}>
        <path class="pred" pathLength="1" d={b.d} />
        <circle class="end" cx={b.end[0]} cy={b.end[1]} r="4" />
        <text class="t u" x={b.end[0] + 10} y={b.end[1] + 5}>{b.k}</text>
      </g>
    ))}

    <!-- 개입과 실제 반응 -->
    <circle class="act" cx={Z[0]} cy={Z[1]} r="7" />
    <path class="obs" pathLength="1" d={observed} />
    <text class="t w obs-t" x="470" y="160">observed</text>
    <path class="upd" d="M528 132 C560 200 600 250 610 300" marker-end="url(#pc-a)" />
    <text class="t a upd-t" x="560" y="328">update model</text>
    <text class="t a sel-t" x="430" y="96">u*</text>
  </svg>
  <ol class="loop mono" aria-label="Closed-loop steps">
    {steps.map((s, i) => <li style={`--i:${i}`}><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
  </ol>
</figure>

<style>
  .pc { --acc: #a8c8ff; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 0; border: 1px solid #1f1f1f; background-color: #030303; background-image: linear-gradient(#0d0d0d 1px, transparent 1px), linear-gradient(90deg, #0d0d0d 1px, transparent 1px); background-size: 20px 20px; }
  .pc svg { display: block; width: 100%; height: auto; padding: 12px; }
  .axis { fill: none; stroke: #3a3a3a; }
  .t { fill: #8a8a8a; font: 14px var(--mono); }
  .t.w { fill: #fff; } .t.a { fill: var(--acc); } .t.u { fill: #bdbdbd; }
  .target { fill: rgba(168, 200, 255, .06); stroke: #6a6a6a; stroke-dasharray: 4 4; }
  .hist { fill: none; stroke: #8a8a8a; stroke-width: 1.4; }
  .now { fill: #fff; }
  .ring { fill: none; stroke: #fff; transform-box: fill-box; transform-origin: center; }
  .pred { fill: none; stroke: #6a6a6a; stroke-width: 1.4; stroke-dasharray: 5 5; }
  .end { fill: #6a6a6a; }
  .act { fill: none; stroke: var(--acc); stroke-width: 1.5; transform-box: fill-box; transform-origin: center; opacity: 0; }
  .obs { fill: none; stroke: #fff; stroke-width: 1.8; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .upd { fill: none; stroke: var(--acc); stroke-width: 1.3; stroke-dasharray: 4 4; opacity: 0; }
  .obs-t, .upd-t, .sel-t { opacity: 0; }

  .loop { list-style: none; margin: 0; padding: 18px 18px; border-left: 1px solid #1f1f1f; display: grid; align-content: center; gap: 4px; }
  .loop li { display: flex; gap: 10px; padding: 7px 0; color: #6a6a6a; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid #141414; }
  .loop li span { color: #4a4a4a; }

  /* ── 8초 한 바퀴 ── */
  .run .ring { animation: pc-ring 8s infinite; }
  .run .br .pred { animation: pc-pred 8s infinite; }
  .run .br3 .pred { animation-name: pc-pred3; }
  .run .br3 .end { animation: pc-end3 8s infinite; }
  .run .act { animation: pc-act 8s infinite; }
  .run .obs { animation: pc-obs 8s infinite; }
  .run .obs-t { animation: pc-obst 8s infinite; }
  .run .upd, .run .upd-t { animation: pc-upd 8s infinite; }
  .run .sel-t { animation: pc-sel 8s infinite; }
  .run .loop li { animation: pc-step 8s infinite; }
  .run .loop li:nth-child(1) { animation-delay: 0s; } .run .loop li:nth-child(2) { animation-delay: .6s; }
  .run .loop li:nth-child(3) { animation-delay: 1.2s; } .run .loop li:nth-child(4) { animation-delay: 3s; }
  .run .loop li:nth-child(5) { animation-delay: 3.8s; } .run .loop li:nth-child(6) { animation-delay: 4.6s; }
  .run .loop li:nth-child(7) { animation-delay: 6.4s; }

  @keyframes pc-ring { 0% { transform: scale(1); opacity: 1; } 12% { transform: scale(3); opacity: 0; } 100% { opacity: 0; } }
  @keyframes pc-pred { 0%, 14% { stroke-dashoffset: 0; opacity: 0; } 18% { opacity: 1; } 36%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes pc-pred3 { 0%, 14% { opacity: 0; stroke: #6a6a6a; } 18%, 36% { opacity: 1; stroke: #6a6a6a; stroke-dasharray: 5 5; } 40%, 90% { opacity: 1; stroke: #a8c8ff; stroke-dasharray: none; stroke-width: 2.2; } 100% { opacity: 0; } }
  @keyframes pc-end3 { 0%, 36% { fill: #6a6a6a; } 40%, 90% { fill: #a8c8ff; } 100% { fill: #6a6a6a; } }
  @keyframes pc-sel { 0%, 37% { opacity: 0; } 42%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes pc-act { 0%, 46% { opacity: 0; transform: scale(1); } 48% { opacity: 1; } 58% { opacity: 0; transform: scale(4); } 100% { opacity: 0; } }
  @keyframes pc-obs { 0%, 56% { stroke-dashoffset: 1; opacity: 1; } 78%, 92% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes pc-obst { 0%, 74% { opacity: 0; } 78%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes pc-upd { 0%, 80% { opacity: 0; } 84%, 96% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes pc-step { 0% { color: #a8c8ff; } 8% { color: #a8c8ff; } 12%, 100% { color: #6a6a6a; } }

  @media (max-width: 760px) {
    .pc { grid-template-columns: 1fr; }
    .pc svg { padding: 6px; }
    .t { font-size: 22px; }
    .loop { border-left: 0; border-top: 1px solid #1f1f1f; grid-template-columns: 1fr 1fr; column-gap: 16px; }
  }
  /* 움직임 없이: 최종 상태를 그대로 보여줌 */
  @media (prefers-reduced-motion: reduce) {
    .run * { animation: none !important; }
    .pc .br3 .pred { stroke: #a8c8ff; stroke-dasharray: none; stroke-width: 2.2; }
    .pc .obs { stroke-dashoffset: 0; }
    .pc .obs-t, .pc .upd, .pc .upd-t, .pc .sel-t { opacity: 1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.pc').forEach((el) => {
    new IntersectionObserver(([e]) => el.classList.toggle('run', e.isIntersecting), { threshold: 0.2 }).observe(el);
  });
</script>
