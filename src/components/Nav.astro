---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { label: 'Question', href: `${base}/#question` },
  { label: 'Why', href: `${base}/#why` },
  { label: 'Approach', href: `${base}/#approach` },
  { label: 'Questions', href: `${base}/#questions` },
  { label: 'Contact', href: `${base}/#contact` },
];
---
<header class="nav wrap">
  <a class="nav-name" href={`${base}/`}>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding-block: 22px; position: relative; z-index: 2;
  }
  .nav a { color: var(--on-dark); text-decoration: none; }
  .nav a:hover { color: #fff; }
  .nav-name { font-size: 14px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  ul { display: flex; gap: clamp(14px, 3vw, 40px); list-style: none; margin: 0; padding: 0; font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .nav a { opacity: 0.86; } .nav a:hover { opacity: 1; }
  @media (max-width: 560px) {
    .nav { flex-direction: column; align-items: flex-start; gap: 10px; }
    ul { gap: 8px 16px; font-size: 11px; letter-spacing: 0.1em; flex-wrap: wrap; }
  }
</style>
