---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { label: 'Research', href: `${base}/#research` },
  { label: 'Experience', href: `${base}/#experience` },
  { label: 'About', href: `${base}/#about` },
  { label: 'Contact', href: `${base}/#contact` },
];
---
<header class="nav wrap">
  <a class="nav-name" href={`${base}/`}>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; padding-block: 22px; position: relative; z-index: 2;
  }
  .nav a { color: var(--on-dark); text-decoration: none; }
  .nav a:hover { color: var(--pulse); }
  .nav-name { font-size: 15px; font-weight: 520; letter-spacing: -0.005em; }
  ul { display: flex; gap: clamp(14px, 3vw, 40px); list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .nav a { opacity: 0.86; } .nav a:hover { opacity: 1; }
  @media (max-width: 560px) {
    .nav { flex-direction: column; align-items: flex-start; gap: 8px; }
    ul { gap: 16px; font-size: 14px; }
  }
</style>
